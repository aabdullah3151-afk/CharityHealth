}

@@media (max-width: 900px) {
    .appointment-board {
        padding: 0 14px;
    }

    .appointment-summary {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .request-row {
        grid-template-columns: 1fr;
    }

    .request-actions {
        justify-content: flex-start;
    }
}

@@media (max-width: 600px) {
    .appointment-board-head {
        align-items: flex-start;
        flex-direction: column;
    }
}
</style>

@code {
    private bool loading = true;
    private bool messageOk;
    private string? message;
    private string reviewerId = string.Empty;
    private List<RequestWorkItem> pendingRequests = [];
    private readonly HashSet<Guid> busyIds = [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        reviewerId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        await Load();
    }

    private async Task Load()
    {
        loading = true;

        try
        {
            // This component gets its own short-lived DbContext.
            // It must not share the scoped HealthcareUiService DbContext
            // while the parent dashboard is loading its statistics.
            await using var isolatedDb =
                await DbFactory.CreateDbContextAsync();

            var isolatedUi = new HealthcareUiService(isolatedDb);

            await isolatedUi.NormalizeActiveQrExpiryAsync();

            pendingRequests = (await isolatedUi.GetRequestsAsync())
                .Where(item =>
                    item.Status is RequestStatus.Submitted or RequestStatus.UnderReview)
                .OrderBy(item => item.AppointmentDate ?? DateOnly.MaxValue)
                .ThenBy(item => item.SubmittedAt)
                .ToList();
        }
        catch
        {
            messageOk = false;
            message = "تعذر تحميل طلبات المواعيد حاليًا.";
        }
        finally
        {
            loading = false;
        }
    }

    private DateOnly Today => CairoToday();
    private DateOnly Tomorrow => Today.AddDays(1);
    private DateOnly WeekEnd => EndOfEgyptWeek(Today);

    private List<RequestWorkItem> TodayItems =>
        pendingRequests.Where(item => item.AppointmentDate == Today).ToList();

    private List<RequestWorkItem> TomorrowItems =>
        pendingRequests.Where(item => item.AppointmentDate == Tomorrow).ToList();

    private List<RequestWorkItem> WeekItems =>
        pendingRequests
            .Where(item =>
                item.AppointmentDate is not null
                && item.AppointmentDate > Tomorrow
                && item.AppointmentDate <= WeekEnd)
            .ToList();

    private List<RequestWorkItem> RemainingItems =>
        pendingRequests
            .Where(item =>
                item.AppointmentDate is null
                || item.AppointmentDate < Today
                || item.AppointmentDate > WeekEnd)
            .ToList();

    private IReadOnlyList<ScheduleGroup> Groups =>
    [
        new(
            "طلبات اليوم",
            $"الموعد: {Today:dd/MM/yyyy}",
            "🔴",
            "today",
            TodayItems),
        new(
            "طلبات غدًا",
            $"الموعد: {Tomorrow:dd/MM/yyyy}",
            "🟠",
            "tomorrow",
            TomorrowItems),
        new(
            "باقي الأسبوع",
            $"حتى {WeekEnd:dd/MM/yyyy}",
            "🔵",
            "week",
            WeekItems),
        new(
            "باقي الطلبات",
            "المواعيد اللاحقة أو المتأخرة أو غير المحددة",
            "🟣",
            "remaining",
            RemainingItems)
    ];

    private async Task Approve(RequestWorkItem item)
    {
        if (string.IsNullOrWhiteSpace(reviewerId))
        {
            messageOk = false;
            message = "تعذر قراءة حساب الأدمن الحالي.";
            return;
        }

        busyIds.Add(item.Id);
        message = null;

        try
        {
            var result = await Ui.ApproveRequestAsync(item.Id, reviewerId, null);
            messageOk = result.Succeeded;
            message = result.Message;

            if (result.Succeeded)
            {
                await Load();
            }
        }
        finally
        {
            busyIds.Remove(item.Id);
        }
    }

    private async Task Reject(RequestWorkItem item)
    {
        if (string.IsNullOrWhiteSpace(reviewerId))
        {
            messageOk = false;
            message = "تعذر قراءة حساب الأدمن الحالي.";
            return;
        }

        busyIds.Add(item.Id);
        message = null;

        try
        {
            var result = await Ui.RejectRequestAsync(
                item.Id,
                reviewerId,
                "تم رفض الطلب من قائمة المواعيد بعد مراجعة الإدارة.");

            messageOk = result.Succeeded;
            message = result.Message;

            if (result.Succeeded)
            {
                await Load();
            }
        }
        finally
        {
            busyIds.Remove(item.Id);
        }
    }

    private bool IsBusy(Guid id) => busyIds.Contains(id);

    private static DateOnly CairoToday()
    {
        try
        {
            var cairo = TimeZoneInfo.FindSystemTimeZoneById("Africa/Cairo");
            var now = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, cairo);
            return DateOnly.FromDateTime(now);
        }
        catch
        {
            return DateOnly.FromDateTime(DateTime.Now);
        }
    }

    private static DateOnly EndOfEgyptWeek(DateOnly date)
    {
        var daysUntilFriday =
            ((int)DayOfWeek.Friday - (int)date.DayOfWeek + 7) % 7;

        return date.AddDays(daysUntilFriday);
    }

    private static string AppointmentText(RequestWorkItem item)
    {
        if (item.AppointmentDate is null)
        {
            return "موعد غير محدد";
        }

        return item.AppointmentDate.Value.ToString("dd/MM/yyyy");
    }

    private static string ProviderText(RequestWorkItem item)
    {
        var value = item.ServiceType == ServiceRequestType.MedicalConsultation
            ? item.DoctorName
            : item.ProviderName;

        return string.IsNullOrWhiteSpace(value) ? "غير معين" : value;
    }

    private static string RequestCode(Guid id) =>
        $"REQ-{id.ToString("N")[..7].ToUpperInvariant()}";

    private static string ShortText(string value)
    {
        var text = value.Trim();
        return text.Length <= 160 ? text : text[..160] + "...";
    }

    private sealed record ScheduleGroup(
        string Title,
        string Subtitle,
        string Icon,
        string CssClass,
        List<RequestWorkItem> Items);
}
