@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services
@using CharityHealth.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore

@inject HealthcareUiService Ui
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<section class="appointment-board" dir="rtl">
    <header class="appointment-board-head">
        <div>
            <span>Daily Request Queue</span>
            <h2>طلبات المواعيد المطلوب مراجعتها</h2>
            <p>
                الطلبات مقسمة حسب موعد الخدمة. يمكنك القبول أو الرفض مباشرة،
                أو فتح صفحة الطلبات للتعيين والتعديل.
            </p>
        </div>

        <button type="button" @onclick='() => Nav.NavigateTo("/admin/requests")'>
            فتح إدارة الطلبات
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="appointment-message @(messageOk ? "ok" : "bad")">@message</div>
    }

    @if (loading)
    {
        <div class="appointment-loading">جارٍ تحميل طلبات المواعيد...</div>
    }
    else
    {
        <section class="appointment-summary">
            <article class="today">
                <strong>@TodayItems.Count</strong>
                <span>طلبات اليوم</span>
            </article>
            <article class="tomorrow">
                <strong>@TomorrowItems.Count</strong>
                <span>طلبات غدًا</span>
            </article>
            <article class="week">
                <strong>@WeekItems.Count</strong>
                <span>باقي الأسبوع</span>
            </article>
            <article class="later">
                <strong>@RemainingItems.Count</strong>
                <span>باقي الطلبات</span>
            </article>
        </section>

        <section class="appointment-groups">
            @foreach (var group in Groups)
            {
                <article class="appointment-group @group.CssClass">
                    <div class="group-title">
                        <div>
                            <span>@group.Icon</span>
                            <div>
                                <h3>@group.Title</h3>
                                <p>@group.Subtitle</p>
                            </div>
                        </div>
                        <strong>@group.Items.Count</strong>
                    </div>

                    @if (group.Items.Count == 0)
                    {
                        <div class="group-empty">لا توجد طلبات في هذا القسم.</div>
                    }
                    else
                    {
                        <div class="group-list">
                            @foreach (var item in group.Items)
                            {
                                <div class="request-row">
                                    <div class="request-main">
                                        <div class="request-title">
                                            <strong>@item.BeneficiaryName</strong>
                                            <span>@RequestCode(item.Id)</span>
                                        </div>

                                        <div class="request-meta">
                                            <span>📅 @AppointmentText(item)</span>
                                            <span>🏥 @item.ServiceTypeAr</span>
                                            <span>👤 @ProviderText(item)</span>
                                            <span>📞 @item.BeneficiaryPhone</span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.DescriptionAr))
                                        {
                                            <p>@ShortText(item.DescriptionAr)</p>
                                        }
                                    </div>

                                    <div class="request-actions">
                                        <button class="manage"
                                                disabled="@IsBusy(item.Id)"
                                                @onclick='() => Nav.NavigateTo("/admin/requests")'>
                                            تعيين / تعديل
                                        </button>

                                        <button class="approve"
                                                disabled="@IsBusy(item.Id)"
                                                @onclick="() => Approve(item)">
                                            قبول
                                        </button>

                                        <button class="reject"
                                                disabled="@IsBusy(item.Id)"
                                                @onclick="() => Reject(item)">
                                            رفض
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </article>
            }
        </section>
    }
</section>

<style>
.appointment-board {
    margin: 0 0 28px;
    padding: 0 32px;
    color: #101828;
}

.appointment-board-head {
    border: 1px solid #dbeafe;
    border-radius: 28px;
    padding: 24px 26px;
    background: linear-gradient(135deg, #eff6ff, #f0fdf4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
}

.appointment-board-head span {
    color: #2563eb;
    font-size: 12px;
    font-weight: 950;
}

.appointment-board-head h2 {
    margin: 6px 0 0;
    font-size: 25px;
    font-weight: 950;
}

.appointment-board-head p {
    margin: 8px 0 0;
    color: #667085;
    font-size: 13px;
    line-height: 1.8;
    font-weight: 800;
}

.appointment-board-head > button {
