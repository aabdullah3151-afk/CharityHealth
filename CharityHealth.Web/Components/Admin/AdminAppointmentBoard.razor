}

.group-empty,
.appointment-loading {
    border-radius: 18px;
    background: #f8fafc;
    padding: 22px;
    text-align: center;
    color: #98a2b3;
    font-size: 13px;
    font-weight: 900;
}

.appointment-message {
    margin: 15px 0;
    border-radius: 17px;
    padding: 14px 16px;
    font-size: 13px;
    font-weight: 900;
}

.appointment-message.ok {
    background: #ecfdf3;
    color: #047857;
}

.appointment-message.bad {
