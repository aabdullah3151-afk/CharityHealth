    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: #2563eb;
    color: #fff;
    font-weight: 950;
    cursor: pointer;
    white-space: nowrap;
}

.appointment-summary {
    margin: 16px 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
}

.appointment-summary article {
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    background: #fff;
    padding: 17px;
    box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
}

.appointment-summary strong {
    display: block;
    font-size: 28px;
    font-weight: 950;
}

.appointment-summary span {
    display: block;
    margin-top: 6px;
    color: #667085;
    font-size: 12px;
    font-weight: 900;
}

.appointment-summary .today strong { color: #dc2626; }
.appointment-summary .tomorrow strong { color: #ea580c; }
.appointment-summary .week strong { color: #2563eb; }
.appointment-summary .later strong { color: #7e22ce; }

.appointment-groups {
    display: grid;
    gap: 16px;
}

.appointment-group {
    border: 1px solid #e5e7eb;
    border-radius: 25px;
    background: #fff;
    padding: 20px;
    box-shadow: 0 12px 30px rgba(15, 23, 42, .05);
}

.appointment-group.today { border-color: #fecaca; }
.appointment-group.tomorrow { border-color: #fed7aa; }
.appointment-group.week { border-color: #bfdbfe; }
.appointment-group.remaining { border-color: #e9d5ff; }

.group-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 15px;
}

.group-title > div {
    display: flex;
    align-items: center;
    gap: 11px;
}

.group-title > div > span {
    width: 47px;
    height: 47px;
    border-radius: 15px;
    background: #f8fafc;
    display: grid;
    place-items: center;
    font-size: 23px;
}

.group-title h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 950;
}

.group-title p {
    margin: 5px 0 0;
    color: #98a2b3;
    font-size: 11px;
    font-weight: 800;
}

.group-title > strong {
    min-width: 39px;
    height: 39px;
    padding: 0 10px;
    border-radius: 999px;
    background: #f1f5f9;
    display: grid;
    place-items: center;
    font-size: 16px;
    font-weight: 950;
}

.group-list {
    display: grid;
    gap: 10px;
}

.request-row {
    border: 1px solid #eef2f6;
    border-radius: 18px;
    background: #f8fafc;
    padding: 15px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 15px;
    align-items: center;
}

.request-title {
    display: flex;
    align-items: center;
    gap: 9px;
