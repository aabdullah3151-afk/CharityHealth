.request-actions {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.request-actions button {
    min-height: 38px;
    padding: 0 13px;
    border: 0;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 950;
