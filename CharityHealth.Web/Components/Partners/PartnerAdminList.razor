.provider-details-grid .wide{grid-column:1/-1}.provider-details-grid span{display:block;color:#98a2b3;font-size:10px;font-weight:850}.provider-details-grid strong{display:block;margin-top:5px;color:#344054;font-size:12px;font-weight:900;line-height:1.65;word-break:break-word}.provider-actions{display:flex!important;gap:9px!important;flex-wrap:wrap!important}.provider-actions .edit-primary{color:#fff!important;border:0!important}.provider-edit-days{display:grid;gap:9px;color:#344054;font-size:13px;font-weight:900}.provider-edit-days>div{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}.provider-edit-days label{border:1px solid #e5e7eb;border-radius:14px;background:#f8fafc;padding:10px 7px;display:flex!important;align-items:center;justify-content:center;gap:6px}.provider-edit-days input{width:16px!important;height:16px!important;padding:0!important}.provider-edit-days b{font-size:11px}@@media(max-width:1000px){.provider-edit-days>div{grid-template-columns:repeat(4,minmax(0,1fr))}.provider-stats-four{grid-template-columns:repeat(2,minmax(0,1fr))!important}.provider-card-grid{grid-template-columns:1fr!important}}@@media(max-width:650px){.provider-edit-grid,.provider-details-grid{grid-template-columns:1fr}.provider-edit-grid .wide,.provider-details-grid .wide{grid-column:auto}.provider-edit-actions,.provider-delete-card{align-items:stretch;display:grid}.provider-edit-actions>div,.provider-delete-card>div:last-child{display:grid}.provider-capacity-box{grid-template-columns:1fr}.provider-capacity-box>div{border-left:0;border-bottom:1px solid rgba(148,163,184,.22);padding-bottom:8px}.provider-capacity-box>div:last-child{border-bottom:0}.provider-stats-four{grid-template-columns:1fr!important}}
</style>

@code {
    [Parameter, EditorRequired] public string PrimaryRoleName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string PrimaryRoleLabel { get; set; } = string.Empty;
    [Parameter] public string? SecondaryRoleName { get; set; }
    [Parameter] public string? SecondaryRoleLabel { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string Kicker { get; set; } = "Partners";
    [Parameter, EditorRequired] public string SingularLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string PluralLabel { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "🏥";
    [Parameter, EditorRequired] public string CreateUrl { get; set; } = string.Empty;
    [Parameter] public string AccentColor { get; set; } = "#05a843";
    [Parameter] public string AccentSoft { get; set; } = "#ecfdf3";
    [Parameter] public string AccentBorder { get; set; } = "#a7f3d0";
    [Parameter] public string AccentShadow { get; set; } = "rgba(5,168,67,.12)";
    [Parameter] public bool ShowDiscountPercentage { get; set; }
    [Parameter] public bool ShowWorkingDays { get; set; }
    [Parameter] public ServiceRequestType ServiceType { get; set; } = ServiceRequestType.PharmacyMedication;

    private const string DefaultPassword = "12345678";
    private bool loading = true;
    private bool busy;
    private bool messageOk;
    private string search = string.Empty;
    private string? message;
    private PartnerAdminRow? editTarget;
    private PartnerAdminRow? deleteTarget;
    private string editNameAr = string.Empty;
    private string? editNameEn;
    private string editEmail = string.Empty;
    private string? editPhone;
    private string editRole = string.Empty;
    private string? editPassword;
    private bool editIsActive = true;
    private string? editContactPerson;
    private string? editLicenseNumber;
    private string editGovernorate = string.Empty;
    private string editCity = string.Empty;
    private string editAddress = string.Empty;
    private string? editWorkingHours;
    private string? editWorkStartTime;
    private string? editWorkEndTime;
    private string? editDescription;
    private int editDailyCapacity = 20;
    private decimal editDiscountPercentage;
    private HashSet<string> editWorkingDays = [];
    private readonly List<DayOption> Days =
    [
        new("Sat", "السبت"), new("Sun", "الأحد"), new("Mon", "الاثنين"),
        new("Tue", "الثلاثاء"), new("Wed", "الأربعاء"), new("Thu", "الخميس"), new("Fri", "الجمعة")
    ];
    private List<PartnerAdminRow> rows = [];

    protected override async Task OnParametersSetAsync() => await LoadRows();
    private string[] RoleNames => string.IsNullOrWhiteSpace(SecondaryRoleName) ? [PrimaryRoleName] : [PrimaryRoleName, SecondaryRoleName!];
    private void GoCreate() => Nav.NavigateTo(CreateUrl);

    private async Task LoadRows()
    {
        loading = true;
        try
        {
            foreach (var role in RoleNames)
                if (!await RoleManager.RoleExistsAsync(role)) await RoleManager.CreateAsync(new IdentityRole(role));

            var allUsers = await UserManager.Users.AsNoTracking().OrderBy(u => u.FullNameAr).ToListAsync();
            var partnerUsers = new List<(ApplicationUser User, string Role)>();
            foreach (var user in allUsers)
            {
                var roles = await UserManager.GetRolesAsync(user);
                var role = RoleNames.FirstOrDefault(r => roles.Contains(r, StringComparer.OrdinalIgnoreCase));
                if (role is not null) partnerUsers.Add((user, role));
            }

            var ids = partnerUsers.Select(x => x.User.Id).ToList();
            Dictionary<string, int> counts;
            if (ids.Count == 0)
            {
                counts = [];
            }
            else
            {
                var todayOnly = DateOnly.FromDateTime(DateTime.UtcNow);
                counts = await Db.MedicalRequests.AsNoTracking()
                    .Where(r => r.AssignedProviderUserId != null && ids.Contains(r.AssignedProviderUserId)
                        && r.ServiceType == ServiceType && r.AppointmentDate == todayOnly
                        && r.Status != RequestStatus.Draft && r.Status != RequestStatus.Rejected)
                    .GroupBy(r => r.AssignedProviderUserId!)
                    .Select(g => new { UserId = g.Key, Count = g.Count() })
                    .ToDictionaryAsync(x => x.UserId, x => x.Count);
            }

            rows = partnerUsers.Select(x =>
            {
                var cap = x.User.DailyRequestCapacity <= 0 ? 20 : x.User.DailyRequestCapacity;
                var used = counts.GetValueOrDefault(x.User.Id);
                return new PartnerAdminRow(
                    x.User.Id, Safe(x.User.FullNameAr, $"{SingularLabel} بدون اسم"), Safe(x.User.FullNameEn, ""),
                    Safe(x.User.Email, "بدون بريد"), x.User.PhoneNumber, x.User.IsActive && !IsLocked(x.User), x.Role,
                    x.User.ContactPersonName, x.User.LicenseNumber, x.User.Governorate, x.User.City, x.User.AddressAr,
                    x.User.WorkingHours, x.User.WorkingDays, x.User.DescriptionAr, NormalizeDiscount(x.User.DiscountPercentage), cap, used, Math.Max(0, cap - used));
            }).ToList();
        }
        catch (Exception ex)
        {
            messageOk = false;
            message = $"حدث خطأ أثناء تحميل {PluralLabel}: {ex.Message}";
        }
        finally { loading = false; }
    }

    private IEnumerable<PartnerAdminRow> FilteredRows => string.IsNullOrWhiteSpace(search) ? rows : rows.Where(x =>
        Contains(x.NameAr, search) || Contains(x.NameEn, search) || Contains(x.Email, search) || Contains(x.PhoneNumber, search)
        || Contains(x.Governorate, search) || Contains(x.City, search) || Contains(x.AddressAr, search));

    private async Task BeginEdit(PartnerAdminRow item)
    {
        message = null; deleteTarget = null; editTarget = item;
        editNameAr = item.NameAr; editNameEn = item.NameEn; editEmail = item.Email == "بدون بريد" ? "" : item.Email;
        editPhone = item.PhoneNumber; editRole = item.RoleName; editPassword = null; editIsActive = item.IsActive;
        editContactPerson = item.ContactPersonName; editLicenseNumber = item.LicenseNumber; editGovernorate = item.Governorate ?? "";
        editCity = item.City ?? ""; editAddress = item.AddressAr ?? ""; editWorkingHours = item.WorkingHours;
        (editWorkStartTime, editWorkEndTime) = ParseWorkingHours(item.WorkingHours);
        editDescription = item.DescriptionAr; editDailyCapacity = item.DailyCapacity; editDiscountPercentage = item.DiscountPercentage;
        editWorkingDays = ParseDays(item.WorkingDays);
        await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private void CancelEdit()
    {
        editTarget = null; editNameAr = ""; editNameEn = null; editEmail = ""; editPhone = null; editRole = PrimaryRoleName;
        editPassword = null; editIsActive = true; editContactPerson = null; editLicenseNumber = null; editGovernorate = "";
        editCity = ""; editAddress = ""; editWorkingHours = null; editWorkStartTime = null; editWorkEndTime = null; editDescription = null; editDailyCapacity = 20; editDiscountPercentage = 0m;
        editWorkingDays = [];
    }

    private async Task SaveEdit()
    {
        if (busy || editTarget is null) return;
        var validation = ValidateEdit();
        if (validation is not null) { messageOk = false; message = validation; return; }
        busy = true; message = null;
        try
        {
            var user = await UserManager.FindByIdAsync(editTarget.UserId);
            if (user is null) { message = "لم يتم العثور على الحساب."; return; }
            var email = editEmail.Trim();
            if (!string.Equals(user.Email, email, StringComparison.OrdinalIgnoreCase))
            {
                var existing = await UserManager.FindByEmailAsync(email);
                if (existing is not null && existing.Id != user.Id) { message = "يوجد حساب آخر بنفس البريد الإلكتروني."; return; }
                var er = await UserManager.SetEmailAsync(user, email); if (!er.Succeeded) { message = JoinErrors(er); return; }
                var ur = await UserManager.SetUserNameAsync(user, email); if (!ur.Succeeded) { message = JoinErrors(ur); return; }
                user.EmailConfirmed = true;
            }

            user.FullNameAr = editNameAr.Trim(); user.FullNameEn = Clean(editNameEn) ?? editNameAr.Trim();
            user.PhoneNumber = Clean(editPhone); user.PhoneNumberConfirmed = true; user.IsActive = editIsActive;
            user.LockoutEnabled = !editIsActive; user.LockoutEnd = editIsActive ? null : DateTimeOffset.UtcNow.AddYears(100);
            user.ContactPersonName = Clean(editContactPerson); user.LicenseNumber = Clean(editLicenseNumber);
            user.Governorate = editGovernorate.Trim(); user.City = editCity.Trim(); user.AddressAr = editAddress.Trim();
            user.WorkingHours = ShowWorkingDays ? BuildWorkingHours(editWorkStartTime, editWorkEndTime) : Clean(editWorkingHours);
            user.WorkingDays = ShowWorkingDays ? string.Join(",", editWorkingDays) : null; user.DescriptionAr = Clean(editDescription);
            user.DailyRequestCapacity = editDailyCapacity;
            user.DiscountPercentage = ShowDiscountPercentage ? NormalizeDiscount(editDiscountPercentage) : 0m;
            user.UserType = ResolveUserType(editRole); user.UpdatedAt = DateTime.UtcNow;
            var update = await UserManager.UpdateAsync(user); if (!update.Succeeded) { message = JoinErrors(update); return; }

            var currentRoles = await UserManager.GetRolesAsync(user);
            var oldRoles = currentRoles.Where(r => RoleNames.Contains(r, StringComparer.OrdinalIgnoreCase)).ToList();
            if (oldRoles.Count > 0) { var rr = await UserManager.RemoveFromRolesAsync(user, oldRoles); if (!rr.Succeeded) { message = JoinErrors(rr); return; } }
            var ar = await UserManager.AddToRoleAsync(user, editRole); if (!ar.Succeeded) { message = JoinErrors(ar); return; }
            await ResetUserClaims(user, editRole);

            if (!string.IsNullOrWhiteSpace(editPassword))
            {
                if (editPassword.Trim().Length < 8) { message = "كلمة المرور الجديدة يجب ألا تقل عن 8 أحرف أو أرقام."; return; }
                var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                var pr = await UserManager.ResetPasswordAsync(user, token, editPassword.Trim()); if (!pr.Succeeded) { message = JoinErrors(pr); return; }
            }

            messageOk = true; message = $"تم تعديل حساب {SingularLabel} بنجاح."; CancelEdit(); await LoadRows();
        }
        catch (Exception ex) { messageOk = false; message = $"تعذر حفظ التعديل: {ex.Message}"; }
        finally { busy = false; }
    }

    private string? ValidateEdit()
    {
        if (string.IsNullOrWhiteSpace(editNameAr)) return "الاسم العربي مطلوب.";
        if (string.IsNullOrWhiteSpace(editEmail) || !editEmail.Contains('@') || !editEmail.Contains('.')) return "البريد الإلكتروني غير صحيح.";
        if (string.IsNullOrWhiteSpace(editPhone)) return "رقم الهاتف مطلوب.";
        if (string.IsNullOrWhiteSpace(editGovernorate)) return "المحافظة مطلوبة.";
        if (string.IsNullOrWhiteSpace(editCity)) return "المدينة أو المركز مطلوب.";
        if (string.IsNullOrWhiteSpace(editAddress)) return "العنوان بالتفصيل مطلوب.";
        if (editDailyCapacity is < 1 or > 1000) return "عدد الطلبات اليومية يجب أن يكون بين 1 و1000.";
        if (ShowDiscountPercentage && editDiscountPercentage is < 0 or > 100) return "نسبة الخصم يجب أن تكون بين 0 و100%.";
        if (ShowWorkingDays && editWorkingDays.Count == 0) return "اختر يوم عمل واحدًا على الأقل.";
        if (ShowWorkingDays && !ValidTimeRange(editWorkStartTime, editWorkEndTime)) return "وقت نهاية العمل يجب أن يكون بعد وقت البداية.";
        return null;
    }

    private void ToggleEditDay(string code, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected) editWorkingDays.Add(code);
        else editWorkingDays.Remove(code);
    }

    private void OnEditWorkStartTimeChanged(ChangeEventArgs args)
        => editWorkStartTime = args.Value?.ToString();

