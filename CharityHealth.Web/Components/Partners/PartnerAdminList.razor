@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using CharityHealth.Domain.Entities
@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="admin-pharmacy-page" dir="rtl" style="--provider-accent:@AccentColor;--provider-soft:@AccentSoft;--provider-border:@AccentBorder;">
    <header class="admin-pharmacy-head">
        <div>
	
            <div class="admin-pharmacy-kicker">@Kicker @Icon</div>
            <h1>@Title</h1>
            <p>@Subtitle</p>
        </div>
        <button type="button" class="admin-pharmacy-add-btn" style="background:@AccentColor;" @onclick="GoCreate">
            <span>+</span> إضافة @SingularLabel
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="admin-pharmacy-message @(messageOk ? "ok" : "bad")">@message</div>
    }

    @if (editTarget is not null)
    {
        <section class="provider-edit-card" style="border-color:@AccentBorder;box-shadow:0 14px 34px @AccentShadow;">
            <div class="provider-edit-head">
                <div>
                    <h2>تعديل بيانات @SingularLabel</h2>
                    <p>يمكن تعديل بيانات الحساب والعنوان ومواعيد العمل والسعة اليومية.</p>
                </div>
                <span style="background:var(--provider-soft);color:var(--provider-accent);">Edit</span>
            </div>

            <div class="provider-edit-body">
                <div class="provider-edit-grid">
                    <label>الاسم العربي *<input @bind="editNameAr" @bind:event="oninput" /></label>
                    <label>الاسم الإنجليزي<input @bind="editNameEn" @bind:event="oninput" dir="ltr" /></label>
                    <label>البريد الإلكتروني *<input @bind="editEmail" @bind:event="oninput" type="email" dir="ltr" /></label>
                    <label>رقم الهاتف *<input @bind="editPhone" @bind:event="oninput" dir="ltr" /></label>
                    @if (!string.IsNullOrWhiteSpace(SecondaryRoleName))
                    {
                        <label>نوع الحساب
                            <select @bind="editRole">
                                <option value="@PrimaryRoleName">@PrimaryRoleLabel</option>
                                <option value="@SecondaryRoleName">@SecondaryRoleLabel</option>
                            </select>
                        </label>
                    }
                    <label>مسؤول التواصل<input @bind="editContactPerson" @bind:event="oninput" /></label>
                    <label>رقم الترخيص<input @bind="editLicenseNumber" @bind:event="oninput" /></label>
                    <label>الحد الأقصى اليومي *<input @bind="editDailyCapacity" type="number" min="1" max="1000" /></label>
                    @if (ShowWorkingDays)
                    {
                        <label>الحالة
                            <select @bind="editIsActive">
                                <option value="true">متاح</option>
                                <option value="false">غير متاح</option>
                            </select>
                        </label>
                    }
                    @if (ShowDiscountPercentage)
                    {
                        <label class="provider-edit-discount">نسبة الخصم للمستفيد (%)
                            <input @bind="editDiscountPercentage" type="number" min="0" max="100" step="0.5" />
                            <small>تظهر للمستفيد عند اختيار @SingularLabel.</small>
                        </label>
                    }
                    <label>المحافظة *<input @bind="editGovernorate" @bind:event="oninput" /></label>
                    <label>المدينة / المركز *<input @bind="editCity" @bind:event="oninput" /></label>
                    @if (ShowWorkingDays)
                    {
                        <label>بداية وقت العمل<input type="time" value="@editWorkStartTime" @onchange="OnEditWorkStartTimeChanged" /></label>
                        <label>نهاية وقت العمل<input type="time" value="@editWorkEndTime" @onchange="OnEditWorkEndTimeChanged" /></label>
                        <div class="wide provider-edit-days">
                            <span>أيام العمل *</span>
                            <div>
                                @foreach (var day in Days)
                                {
                                    <label>
                                        <input type="checkbox" checked="@editWorkingDays.Contains(day.Code)" @onchange="e => ToggleEditDay(day.Code, e)" />
                                        <b>@day.Name</b>
                                    </label>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <label class="wide">مواعيد العمل<input @bind="editWorkingHours" @bind:event="oninput" /></label>
                    }
                    <label class="wide">@(ShowWorkingDays ? $"عنوان {SingularLabel} بالتفصيل *" : "العنوان بالتفصيل *")<textarea @bind="editAddress" @bind:event="oninput" rows="3"></textarea></label>
                    <label class="wide">وصف الخدمات<textarea @bind="editDescription" @bind:event="oninput" rows="4" maxlength="1500"></textarea></label>
                    <label>كلمة مرور جديدة اختيارية<input @bind="editPassword" @bind:event="oninput" type="password" dir="ltr" placeholder="اتركها فارغة بدون تغيير" /></label>
                </div>

                <div class="provider-edit-actions">
                    @if (!ShowWorkingDays)
                    {
                        <label class="active-check">
                            <input type="checkbox" @bind="editIsActive" style="accent-color:@AccentColor;" />
                            الحساب نشط ويسمح بتسجيل الدخول
                        </label>
                    }
                    else
                    {
                        <span class="provider-status-note">الحالة الحالية: <b>@(editIsActive ? "متاح" : "غير متاح")</b></span>
                    }
                    <div>
                        <button type="button" class="secondary" @onclick="CancelEdit" disabled="@busy">إلغاء</button>
                        <button type="button" class="primary" style="background:@AccentColor;" @onclick="SaveEdit" disabled="@busy">
                            @(busy ? "جارٍ الحفظ..." : "حفظ التعديل")
                        </button>
                    </div>
                </div>
            </div>
        </section>
    }

    @if (deleteTarget is not null)
    {
        <section class="provider-delete-card">
            <div>
                <strong>تأكيد حذف الحساب</strong>
                <span>هل تريد حذف: @deleteTarget.NameAr ؟</span>
                <small>إذا كان الحساب مرتبطًا بطلبات سيتم تعطيله بدل الحذف النهائي.</small>
            </div>
            <div>
                <button type="button" class="secondary" @onclick="CancelDelete" disabled="@busy">إلغاء</button>
                <button type="button" class="delete" @onclick="DeleteAccount" disabled="@busy">@(busy ? "جارٍ الحذف..." : "حذف")</button>
            </div>
        </section>
    }

    @if (loading)
    {
        <section class="admin-pharmacy-state">جارٍ تحميل @PluralLabel...</section>
    }
    else
    {
        <section class="admin-pharmacy-stats provider-stats-four">
            <article><span>إجمالي @PluralLabel</span><strong>@rows.Count</strong></article>
            <article><span>الحسابات النشطة</span><strong>@rows.Count(x => x.IsActive)</strong></article>
            <article><span>طلبات اليوم</span><strong>@rows.Sum(x => x.TodayRequests)</strong></article>
            <article><span>إجمالي السعة اليومية</span><strong>@rows.Where(x => x.IsActive).Sum(x => x.DailyCapacity)</strong></article>
        </section>

        <section class="admin-pharmacy-toolbar">
            <label>
                <span>بحث</span>
                <input @bind="search" @bind:event="oninput" placeholder="الاسم، البريد، الهاتف، العنوان..." />
            </label>
        </section>

        @if (!FilteredRows.Any())
        {
            <section class="admin-pharmacy-empty">
                <div>@Icon</div>
                <h2>لا توجد @PluralLabel</h2>
                <p>ابدأ بإضافة @SingularLabel جديد وإدخال بياناته وسعته اليومية.</p>
                <button type="button" style="background:@AccentColor;" @onclick="GoCreate">إضافة @SingularLabel</button>
            </section>
        }
        else
        {
            <section class="admin-pharmacy-grid provider-card-grid">
                @foreach (var item in FilteredRows)
                {
                    <article class="admin-pharmacy-card provider-full-card">
                        <div class="pharmacy-card-top">
                            <div class="pharmacy-icon" style="background:var(--provider-soft);color:var(--provider-accent);">@Icon</div>
                            <div class="pharmacy-title">
                                <h2>@item.NameAr</h2>
                                <p>@item.Email</p>
                            </div>
                            <span class="pharmacy-status @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "نشط" : "غير نشط")</span>
                        </div>

                        @if (ShowDiscountPercentage && item.DiscountPercentage > 0)
                        {
                            <div class="provider-discount-badge" style="background:@AccentSoft;border-color:@AccentBorder;color:@AccentColor;">
                                خصم للمستفيد <strong>@DiscountText(item.DiscountPercentage)</strong>
                            </div>
                        }

                        <div class="provider-capacity-box" style="background:@AccentSoft;border-color:@AccentBorder;">
                            <div><span>طلبات اليوم</span><strong style="color:@AccentColor;">@item.TodayRequests</strong></div>
                            <div><span>السعة اليومية</span><strong>@item.DailyCapacity</strong></div>
                            <div><span>المتاح اليوم</span><strong class="@(item.RemainingToday > 0 ? "available" : "full")">@item.RemainingToday</strong></div>
                        </div>

                        <div class="provider-details-grid">
                            <div><span>الهاتف</span><strong>@Safe(item.PhoneNumber)</strong></div>
                            <div><span>نوع الحساب</span><strong>@RoleLabel(item.RoleName)</strong></div>
                            <div><span>المحافظة</span><strong>@Safe(item.Governorate)</strong></div>
                            <div><span>المدينة</span><strong>@Safe(item.City)</strong></div>
                            <div class="wide"><span>العنوان</span><strong>@Safe(item.AddressAr)</strong></div>
                            <div class="wide"><span>مواعيد العمل</span><strong>@Safe(item.WorkingHours)</strong></div>
                            @if (ShowWorkingDays)
                            {
                                <div class="wide"><span>أيام العمل</span><strong>@FormatWorkingDays(item.WorkingDays)</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.ContactPersonName))
                            {
                                <div><span>مسؤول التواصل</span><strong>@item.ContactPersonName</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.LicenseNumber))
                            {
                                <div><span>رقم الترخيص</span><strong>@item.LicenseNumber</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.DescriptionAr))
                            {
                                <div class="wide"><span>الخدمات والتفاصيل</span><strong>@item.DescriptionAr</strong></div>
                            }
                        </div>

                        <div class="pharmacy-login-note">كلمة المرور الافتراضية للحسابات الجديدة: <strong>@DefaultPassword</strong></div>

                        <div class="pharmacy-actions provider-actions">
    <a class="soft"
   href="/admin/user-profile/@item.UserId">
    👤 الملف الشخصي
</a>
                            <button type="button" class="edit-primary" style="background:@AccentColor;" disabled="@busy" @onclick="() => BeginEdit(item)">✏️ تعديل البيانات</button>
                            <button type="button" class="danger" disabled="@busy" @onclick="() => AskDelete(item)">حذف</button>
                        </div>
                    </article>
                }
            </section>
        }
    }
</div>

