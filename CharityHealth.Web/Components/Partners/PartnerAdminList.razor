        => editWorkEndTime = args.Value?.ToString();

    private static (string? Start, string? End) ParseWorkingHours(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return (null, null);
        var matches = System.Text.RegularExpressions.Regex.Matches(value, @"(?<!\d)([01]?\d|2[0-3]):[0-5]\d(?!\d)");
        return matches.Count switch
        {
            0 => (null, null),
            1 => (matches[0].Value, null),
            _ => (matches[0].Value, matches[1].Value)
        };
    }

    private static string? BuildWorkingHours(string? start, string? end)
    {
        start = Clean(start);
        end = Clean(end);
        if (start is null && end is null) return null;
        if (start is not null && end is not null) return $"{start} - {end}";
        return start is not null ? $"من {start}" : $"حتى {end}";
    }

    private static bool ValidTimeRange(string? start, string? end)
    {
        if (string.IsNullOrWhiteSpace(start) || string.IsNullOrWhiteSpace(end)) return true;
        return TimeOnly.TryParse(start, out var from) && TimeOnly.TryParse(end, out var to) && to > from;
    }

    private static HashSet<string> ParseDays(string? value) =>
        string.IsNullOrWhiteSpace(value) ? [] : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet(StringComparer.OrdinalIgnoreCase);

    private static string FormatWorkingDays(string? value)
    {
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        { ["Sat"]="السبت", ["Sun"]="الأحد", ["Mon"]="الاثنين", ["Tue"]="الثلاثاء", ["Wed"]="الأربعاء", ["Thu"]="الخميس", ["Fri"]="الجمعة" };
        var days = ParseDays(value).Select(x => map.GetValueOrDefault(x, x)).ToList();
        return days.Count == 0 ? "جميع الأيام" : string.Join("، ", days);
    }

    private void AskDelete(PartnerAdminRow item) { message = null; editTarget = null; deleteTarget = item; }
    private void CancelDelete() => deleteTarget = null;

    private async Task DeleteAccount()
    {
        if (busy || deleteTarget is null) return; busy = true; message = null;
        try
        {
            var user = await UserManager.FindByIdAsync(deleteTarget.UserId);
            if (user is null) { message = "لم يتم العثور على الحساب."; return; }
            var result = await UserManager.DeleteAsync(user);
            if (!result.Succeeded)
            {
                user.IsActive = false; user.LockoutEnabled = true; user.LockoutEnd = DateTimeOffset.UtcNow.AddYears(100); user.UpdatedAt = DateTime.UtcNow;
                var update = await UserManager.UpdateAsync(user); if (!update.Succeeded) { message = JoinErrors(update); return; }
                message = "تعذر الحذف النهائي لوجود طلبات مرتبطة، لذلك تم تعطيل الحساب.";
            }
            else message = "تم حذف الحساب بنجاح.";
            messageOk = true; deleteTarget = null; await LoadRows();
        }
        catch (Exception ex) { messageOk = false; message = $"تعذر حذف الحساب: {ex.Message}"; }
        finally { busy = false; }
    }

    private async Task ToggleActive(string userId)
    {
        if (busy) return; busy = true; message = null;
        try
        {
            var user = await UserManager.FindByIdAsync(userId); if (user is null) { message = "لم يتم العثور على الحساب."; return; }
            user.IsActive = !user.IsActive; user.LockoutEnabled = !user.IsActive; user.LockoutEnd = user.IsActive ? null : DateTimeOffset.UtcNow.AddYears(100); user.UpdatedAt = DateTime.UtcNow;
            var result = await UserManager.UpdateAsync(user); if (!result.Succeeded) { message = JoinErrors(result); return; }
            messageOk = true; message = user.IsActive ? "تم تفعيل الحساب بنجاح." : "تم تعطيل الحساب بنجاح."; await LoadRows();
        }
        catch (Exception ex) { messageOk = false; message = $"تعذر تحديث الحساب: {ex.Message}"; }
        finally { busy = false; }
    }

    private async Task ResetPassword(string userId)
    {
        if (busy) return; busy = true; message = null;
        try
        {
            var user = await UserManager.FindByIdAsync(userId); if (user is null) { message = "لم يتم العثور على الحساب."; return; }
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var result = await UserManager.ResetPasswordAsync(user, token, DefaultPassword); if (!result.Succeeded) { message = JoinErrors(result); return; }
            messageOk = true; message = "تمت إعادة كلمة المرور إلى 12345678.";
        }
        catch (Exception ex) { messageOk = false; message = $"تعذر إعادة كلمة المرور: {ex.Message}"; }
        finally { busy = false; }
    }

    private async Task ResetUserClaims(ApplicationUser user, string role)
    {
        var claims = await UserManager.GetClaimsAsync(user);
        foreach (var claim in claims.Where(c => c.Type is "FullNameAr" or "UserType").ToList()) await UserManager.RemoveClaimAsync(user, claim);
        await UserManager.AddClaimAsync(user, new Claim("FullNameAr", user.FullNameAr));
        await UserManager.AddClaimAsync(user, new Claim("UserType", role));
    }

    private UserType ResolveUserType(string role) => Enum.TryParse<UserType>(role, true, out var parsed) ? parsed : UserType.Staff;
    private string RoleLabel(string role) => string.Equals(role, PrimaryRoleName, StringComparison.OrdinalIgnoreCase) ? PrimaryRoleLabel : SecondaryRoleLabel ?? role;
    private static bool IsLocked(ApplicationUser user) => user.LockoutEnd is not null && user.LockoutEnd > DateTimeOffset.UtcNow;
    private static bool Contains(string? source, string? term) => !string.IsNullOrWhiteSpace(source) && !string.IsNullOrWhiteSpace(term) && source.Contains(term.Trim(), StringComparison.OrdinalIgnoreCase);
    private static string Safe(string? value, string fallback = "غير مسجل") => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static decimal NormalizeDiscount(decimal value) => Math.Clamp(value, 0m, 100m);
    private static string DiscountText(decimal value) => $"{NormalizeDiscount(value):0.##}%";
    private static string JoinErrors(IdentityResult result) => string.Join(" | ", result.Errors.Select(e => e.Description));

