@implements IAsyncDisposable

@using System.Security.Claims
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services

@inject HealthcareUiService Ui
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="partner-qr-page" dir="rtl" style="--qr-accent:@AccentColor;--qr-dark:@AccentDark;">
    <header class="partner-qr-head">
        <button type="button" class="back-btn" @onclick="() => Nav.NavigateTo(DashboardUrl)">›</button>
        <div>
            <div class="kicker">@Icon QR Verification</div>
            <h1>مسح QR — @ArabicTitle</h1>
            <p>امسح رمز المستفيد، راجع الطلب والمستندات، ثم أكمل بيانات تنفيذ الخدمة.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="qr-message @(success ? "success" : "danger")">@message</div>
    }

    @if (completed)
    {
        <section class="completion-card">
            <div>✓</div>
            <h2>تم تنفيذ الخدمة بنجاح</h2>
            <p>تم استخدام QR مرة واحدة، تحديث حالة الطلب إلى مكتمل، وإرسال إشعار للمستفيد.</p>
            <div class="completion-actions">
                <button type="button" @onclick="ResetScan">مسح QR جديد</button>
                <button type="button" class="secondary" @onclick="() => Nav.NavigateTo(RequestsUrl)">فتح سجل الطلبات</button>
            </div>
        </section>
    }
    else if (scanData is null)
    {
        <section class="scanner-shell">
            <article class="camera-card">
                <div class="camera-frame">
                    <span class="corner tr"></span><span class="corner tl"></span>
                    <span class="corner br"></span><span class="corner bl"></span>
                    <video id="@VideoElementId" class="scanner-video" playsinline muted></video>
                </div>
                <h2>@(scannerRunning ? "الكاميرا تعمل الآن" : "امسح QR المستفيد")</h2>
                <p>@(scannerRunning ? "ضع الرمز داخل الإطار حتى تتم قراءته تلقائيًا." : "اضغط تشغيل الكاميرا أو أدخل الرابط/الكود يدويًا.")</p>
                <div class="camera-actions">
                    <button type="button" disabled="@(loading || scannerRunning)" @onclick="StartCameraScanner">
                        @(scannerStarting ? "جارٍ تشغيل الكاميرا..." : "تشغيل الكاميرا")
                    </button>
                    <button type="button" class="secondary" disabled="@(!scannerRunning)" @onclick="StopCameraScanner">إيقاف الكاميرا</button>
                </div>
            </article>

            <article class="manual-card">
                <div class="manual-title"><span>⌨</span><div><h2>إدخال يدوي</h2><p>يمكن لصق رابط QR كاملًا أو كتابة رمز الـGUID.</p></div></div>
                <input @bind="manualQrValue" @bind:event="oninput" placeholder="https://.../scan?token=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                <button type="button" disabled="@loading" @onclick="HandleManualQr">@(loading ? "جارٍ التحقق..." : "التحقق من QR")</button>
            </article>

            <article class="rules-card">
                <h2>قواعد التنفيذ</h2>
                <ul>
                    <li>يجب أن يكون الطلب موافقًا عليه من الإدارة.</li>
                    <li>يجب أن يكون الطلب مخصصًا لهذا الحساب تحديدًا.</li>
                    <li>QR صالح لمرة واحدة فقط وقبل تاريخ انتهاء الصلاحية.</li>
                    <li>لن يتحول الطلب إلى مكتمل إلا بعد حفظ بيانات التنفيذ.</li>
                </ul>
            </article>
        </section>
    }
    else
    {
        <section class="verified-banner">
            <span>✓</span>
            <div><h2>تم التحقق من QR</h2><p>الطلب صحيح ومخصص لحساب @ArabicTitle الحالي.</p></div>
            <button type="button" @onclick="ResetScan">إلغاء واختيار رمز آخر</button>
        </section>

        <section class="result-layout">
            <div class="result-main">
                <article class="info-card">
                    <div class="card-head"><span>@Icon</span><div><h2>بيانات الطلب</h2><p>@RequestCode(scanData.RequestId)</p></div></div>
                    <div class="info-grid">
                        <div><span>المستفيد</span><strong>@scanData.BeneficiaryName</strong></div>
                        <div><span>رقم الهاتف</span><strong>@scanData.BeneficiaryPhone</strong></div>
                        <div><span>المدينة</span><strong>@scanData.City</strong></div>
                        <div><span>نوع الخدمة</span><strong>@scanData.ServiceTypeAr</strong></div>
                        <div><span>الجهة</span><strong>@scanData.ProviderName</strong></div>
                        @if (scanData.AppointmentDate is not null)
                        {
                            <div><span>اليوم المحجوز</span><strong>@scanData.AppointmentDate.Value.ToString("yyyy/MM/dd")</strong></div>
                        }
                        <div><span>صلاحية QR</span><strong>@FormatDate(scanData.ExpiresAt)</strong></div>
                    </div>
                    <div class="description-box"><span>تفاصيل طلب المستفيد</span><p>@Safe(scanData.DescriptionAr, "لا توجد تفاصيل مكتوبة.")</p></div>
                </article>

                <article class="info-card">
                    <div class="card-head"><span>📎</span><div><h2>المستندات المرفوعة</h2><p>@scanData.DocumentsCount مستند</p></div></div>
                    @if (scanData.Documents.Count == 0)
                    {
                        <div class="empty-docs">لا توجد مستندات مرفوعة مع هذا الطلب.</div>
                    }
                    else
                    {
                        <div class="documents-grid">
                            @foreach (var document in scanData.Documents)
                            {
                                <a href="@DocumentUrl(document.FilePath)" target="_blank" rel="noopener">
                                    <span>📄</span><div><strong>@document.FileName</strong><small>@FileSizeText(document.FileSizeBytes)</small></div><b>فتح</b>
                                </a>
                            }
                        </div>
                    }
                </article>
            </div>

            <aside class="completion-form">
                <div class="form-head"><span>✍</span><div><h2>استكمال بيانات التنفيذ</h2><p>هذه البيانات ستظهر للمستفيد في تفاصيل الطلب.</p></div></div>

                <label>@PrimaryLabel <em>*</em></label>
                <textarea @bind="primaryResult" rows="6" placeholder="@PrimaryPlaceholder"></textarea>

                <label>@ReferenceLabel</label>
                <input @bind="referenceNumber" placeholder="اختياري" maxlength="120" />

                <label>@DeliveryLabel</label>
                <input type="datetime-local" value="@expectedDeliveryLocal" @onchange="OnExpectedDeliveryChanged" />

                <label>ملاحظات إضافية</label>
                <textarea @bind="additionalNotes" rows="4" placeholder="تعليمات، تنبيهات، أو تفاصيل أخرى للمستفيد..."></textarea>

                <div class="confirm-box">
                    <input id="partnerQrConfirm" type="checkbox" @bind="confirmed" />
                    <label for="partnerQrConfirm">أؤكد مطابقة بيانات المستفيد وتنفيذ الخدمة الموضحة أعلاه.</label>
                </div>

                <button type="button" class="complete-btn" disabled="@(saving || !confirmed)" @onclick="CompleteRequest">
                    @(saving ? "جارٍ الحفظ..." : CompleteButtonText)
                </button>
                <p class="once-warning">بعد الحفظ سيُستخدم QR نهائيًا ولا يمكن استخدامه مرة أخرى.</p>
            </aside>
        </section>
    }
</div>

