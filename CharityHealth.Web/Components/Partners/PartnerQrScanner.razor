t{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(330px,.7fr);gap:18px;margin-top:18px;align-items:start}.result-main{display:grid;gap:18px}.info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px;margin-top:18px}.info-grid>div{border:1px solid #eef2f6;border-radius:16px;background:#f8fafc;padding:13px}.info-grid span,.description-box>span{display:block;color:#98a2b3;font-size:11px;font-weight:850}.info-grid strong{display:block;margin-top:6px;color:#344054;font-size:13px;font-weight:950}.description-box{margin-top:12px;border-radius:17px;background:#f8fafc;padding:15px}.description-box p{margin:7px 0 0;color:#475467;font-size:13px;line-height:1.9;font-weight:800;white-space:pre-wrap}.documents-grid{display:grid;gap:9px;margin-top:17px}.documents-grid a{border:1px solid #e5e7eb;border-radius:16px;background:#f8fafc;padding:12px;display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center;text-decoration:none;color:#344054}.documents-grid a>span{font-size:24px}.documents-grid strong{display:block;font-size:12px;font-weight:950}.documents-grid small{display:block;margin-top:4px;color:#98a2b3;font-size:10px;font-weight:800}.documents-grid b{color:var(--qr-accent);font-size:12px}.empty-docs{margin-top:17px;border-radius:16px;background:#f8fafc;padding:20px;text-align:center;color:#98a2b3;font-weight:850}.completion-form{position:sticky;top:94px}.completion-form>label{display:block;margin:17px 0 7px;color:#344054;font-size:12px;font-weight:950}.completion-form label em{color:#dc2626;font-style:normal}.completion-form textarea{resize:vertical}.confirm-box{margin-top:16px;border-radius:16px;background:#fff7ed;padding:13px;display:flex;align-items:flex-start;gap:9px}.confirm-box input{width:18px;height:18px;margin-top:2px}.confirm-box label{color:#9a3412;font-size:12px;line-height:1.7;font-weight:850;cursor:pointer}.complete-btn{width:100%;min-height:48px;margin-top:14px;border:0;border-radius:999px;background:var(--qr-accent);color:#fff;font-size:14px;font-weight:950;cursor:pointer}.complete-btn:disabled{opacity:.55}.once-warning{text-align:center;color:#98a2b3;font-size:10px;font-weight:800}.completion-card{margin:28px auto;max-width:660px;text-align:center;padding:46px}.completion-card>div:first-child{width:80px;height:80px;border-radius:50%;background:#ecfdf3;color:#05a843;display:grid;place-items:center;margin:auto;font-size:42px;font-weight:950}.completion-card h2{font-size:27px;font-weight:950}.completion-card p{color:#667085;font-size:14px;line-height:1.8;font-weight:800}@@media(max-width:950px){.scanner-shell,.result-layout{grid-template-columns:1fr}.camera-card{grid-row:auto}.completion-form{position:static}}@@media(max-width:650px){.partner-qr-page{padding:18px 12px}.partner-qr-head{padding:22px 18px}.partner-qr-head h1{font-size:26px}.camera-frame{width:260px;height:260px}.info-grid{grid-template-columns:1fr}.verified-banner{grid-template-columns:44px 1fr}.verified-banner button{grid-column:1/-1}.camera-actions,.completion-actions{grid-template-columns:1fr}}
</style>

@code {
    [Parameter, EditorRequired] public ServiceRequestType ServiceType { get; set; }
    [Parameter, EditorRequired] public string ArabicTitle { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "🏥";
    [Parameter, EditorRequired] public string DashboardUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string RequestsUrl { get; set; } = string.Empty;
    [Parameter] public string AccentColor { get; set; } = "#05a843";
    [Parameter] public string AccentDark { get; set; } = "#047857";

    private bool loading;
    private bool saving;
    private bool success;
    private bool completed;
    private bool scannerStarting;
    private bool scannerRunning;
    private bool confirmed;
    private string providerUserId = string.Empty;
    private string manualQrValue = string.Empty;
    private string primaryResult = string.Empty;
    private string? referenceNumber;
    private string? expectedDeliveryLocal;
    private string? additionalNotes;
    private string? message;
    private PartnerQrScanDto? scanData;
    private DotNetObjectReference<PartnerQrScanner>? dotNetRef;

    private string VideoElementId => $"partnerQrVideo-{(int)ServiceType}";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        providerUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        if (string.IsNullOrWhiteSpace(providerUserId))
        {
            message = "تعذر قراءة حساب الجهة الحالية. سجّل الدخول مرة أخرى.";
            return;
        }

        var token = ExtractTokenFromRaw(Nav.Uri);
        if (token is not null)
        {
            await LoadFromQrToken(token.Value);
        }
    }

    private async Task StartCameraScanner()
    {
        message = null; success = false; scannerStarting = true;
        try
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("charityQrScanner.start", VideoElementId, dotNetRef);
            scannerRunning = true;
        }
        catch
        {
            message = "تعذر تشغيل قارئ QR في هذا المتصفح. استخدم الإدخال اليدوي أو افتح الصفحة من هاتف يدعم الكاميرا.";
        }
        finally { scannerStarting = false; }
    }

    private async Task StopCameraScanner()
    {
        try { await JS.InvokeVoidAsync("charityQrScanner.stop"); } catch { }
        scannerRunning = false;
    }

    [JSInvokable]
    public async Task OnQrScanned(string rawValue)
    {
        await InvokeAsync(async () =>
        {
            await StopCameraScanner();
            await HandleRawQr(rawValue);
            StateHasChanged();
        });
    }

    private Task HandleManualQr() => HandleRawQr(manualQrValue);

    private void OnExpectedDeliveryChanged(ChangeEventArgs args)
    {
        expectedDeliveryLocal = args.Value?.ToString();
    }

    private async Task HandleRawQr(string? rawValue)
    {
        var token = ExtractTokenFromRaw(rawValue);
        if (token is null)
        {
            message = "QR غير صالح. امسح الرمز الصحيح أو الصق الرابط كاملًا.";
            success = false;
            return;
        }
        await LoadFromQrToken(token.Value);
    }

    private async Task LoadFromQrToken(Guid token)
    {
        loading = true; message = null; success = false; scanData = null;
        try
        {
            var result = await Ui.GetPartnerRequestByQrAsync(token, providerUserId, ServiceType);
            message = result.Message;
            success = result.Succeeded;
            scanData = result.Data;
            if (result.Succeeded) manualQrValue = token.ToString();
        }
        catch { message = "حدث خطأ أثناء التحقق من QR."; }
        finally { loading = false; }
    }

    private async Task CompleteRequest()
    {
        if (scanData is null) return;
        if (!confirmed)
        {
            message = "يجب تأكيد مطابقة البيانات قبل الحفظ.";
            success = false;
            return;
        }

        DateTime? expectedDelivery = null;
        if (!string.IsNullOrWhiteSpace(expectedDeliveryLocal)
            && DateTime.TryParse(expectedDeliveryLocal, out var parsed))
        {
            expectedDelivery = parsed;
        }

        saving = true; message = null; success = false;
        try
        {
            var input = new PartnerQrCompletionInput(primaryResult, referenceNumber, expectedDelivery, additionalNotes);
            var result = await Ui.CompletePartnerRequestByQrAsync(scanData.QrTokenId, providerUserId, ServiceType, input);
            message = result.Message;
            success = result.Succeeded;
            completed = result.Succeeded;
        }
        catch { message = "حدث خطأ أثناء حفظ تنفيذ الخدمة."; }
        finally { saving = false; }
    }

    private async Task ResetScan()
    {
        await StopCameraScanner();
        scanData = null; completed = false; success = false; message = null;
        manualQrValue = string.Empty; primaryResult = string.Empty; referenceNumber = null;
        expectedDeliveryLocal = null; additionalNotes = null; confirmed = false;
    }

    private static Guid? ExtractTokenFromRaw(string? rawValue)
    {
        if (string.IsNullOrWhiteSpace(rawValue)) return null;
        var text = Uri.UnescapeDataString(rawValue.Trim());
        if (Guid.TryParse(text, out var direct)) return direct;
        var tokenMatch = Regex.Match(text, @"(?:token=)([0-9a-fA-F-]{36})");
        if (tokenMatch.Success && Guid.TryParse(tokenMatch.Groups[1].Value, out var query)) return query;
        var anyGuid = Regex.Match(text, @"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}");
        return anyGuid.Success && Guid.TryParse(anyGuid.Value, out var embedded) ? embedded : null;
    }

    private string PrimaryLabel => ServiceType switch
    {
        ServiceRequestType.PharmacyMedication => "الأدوية التي تم صرفها",
        ServiceRequestType.LaboratoryTest => "التحاليل التي تم تنفيذها",
        ServiceRequestType.RadiologyScan => "الأشعة التي تم تنفيذها",
        _ => "نتيجة التنفيذ"
    };

    private string PrimaryPlaceholder => ServiceType switch
    {
        ServiceRequestType.PharmacyMedication => "اكتب اسم كل دواء والكمية والجرعة أو تعليمات الاستخدام...",
        ServiceRequestType.LaboratoryTest => "اكتب أسماء التحاليل التي تم سحب العينة وتنفيذها...",
        ServiceRequestType.RadiologyScan => "اكتب نوع الأشعة والمنطقة التي تم تصويرها...",
        _ => "اكتب تفاصيل تنفيذ الخدمة..."
    };

    private string ReferenceLabel => ServiceType switch
    {
        ServiceRequestType.PharmacyMedication => "رقم الصرف / الوصفة",
        ServiceRequestType.LaboratoryTest => "رقم العينة / المرجع",
        ServiceRequestType.RadiologyScan => "رقم الفحص / المرجع",
        _ => "الرقم المرجعي"
    };

    private string DeliveryLabel => ServiceType switch
    {
        ServiceRequestType.PharmacyMedication => "موعد استلام العلاج — إن لم يتم التسليم فورًا",
        ServiceRequestType.LaboratoryTest => "موعد تسليم نتيجة التحاليل",
        ServiceRequestType.RadiologyScan => "موعد تسليم تقرير الأشعة",
        _ => "موعد التسليم"
    };

    private string CompleteButtonText => ServiceType switch
    {
        ServiceRequestType.PharmacyMedication => "تأكيد صرف العلاج واستخدام QR",
        ServiceRequestType.LaboratoryTest => "تأكيد تنفيذ التحاليل واستخدام QR",
        ServiceRequestType.RadiologyScan => "تأكيد تنفيذ الأشعة واستخدام QR",
        _ => "تأكيد التنفيذ واستخدام QR"
    };

    private static string RequestCode(Guid id) => $"REQ-{id.ToString("N")[..6].ToUpperInvariant()}";
    private static string FormatDate(DateTime date) => date.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string FileSizeText(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024d:0.#} KB" : $"{bytes / 1024d / 1024d:0.##} MB";
    private static string DocumentUrl(string path)
    {
        var value = (path ?? string.Empty).Trim().Replace("\\", "/");
        if (value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase)) return value;
        if (value.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase)) return "/" + value;
        return "/uploads/" + value.TrimStart('/');
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("charityQrScanner.stop"); } catch { }
        dotNetRef?.Dispose();
    }
}
