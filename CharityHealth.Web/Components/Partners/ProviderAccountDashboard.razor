@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services

@inject AuthenticationStateProvider AuthState
@inject HealthcareUiService Ui
@inject NavigationManager Nav

<div class="partner-dashboard-page" dir="rtl">
    @if (loading)
    {
        <section class="partner-dashboard-state">جارٍ تحميل بيانات الحساب...</section>
    }
    else if (data is null)
    {
        <section class="partner-dashboard-state bad">تعذر تحميل بيانات الحساب.</section>
    }
    else
    {
        <section class="partner-dashboard-hero" style="background:linear-gradient(135deg,@AccentColor,@AccentDark);box-shadow:0 22px 50px @AccentShadow;">
            <div>
                <div class="hero-kicker">@EnglishTitle Workspace</div>
                <h1>@data.NameAr</h1>
                <p>نوع الحساب: @ArabicTitle — الحساب مفعّل بواسطة إدارة المؤسسة.</p>
            </div>
            <div class="hero-icon">@Icon</div>
        </section>

        <section class="partner-dashboard-stats">
            <article><span>طلبات اليوم</span><strong style="color:@AccentColor;">@data.TodayRequests</strong></article>
            <article><span>السعة اليومية</span><strong>@data.DailyCapacity</strong></article>
            <article><span>المتاح اليوم</span><strong class="@(data.RemainingToday > 0 ? "ok" : "full")">@data.RemainingToday</strong></article>
            <article><span>بانتظار التنفيذ</span><strong>@data.PendingApprovedRequests</strong></article>
            <article><span>إجمالي المكتمل</span><strong>@data.CompletedRequests</strong></article>
        </section>

        <section class="partner-dashboard-grid">
            <article class="partner-dashboard-card details">
                <div class="card-title">
                    <span style="background:@AccentSoft;">🏥</span>
                    <div><h2>بيانات @ArabicTitle</h2><p>البيانات المسجلة بواسطة الأدمن</p></div>
                </div>
                <div class="details-grid">
                    <div><span>البريد الإلكتروني</span><strong>@data.Email</strong></div>
                    <div><span>رقم الهاتف</span><strong>@data.PhoneNumber</strong></div>
                    <div><span>مسؤول التواصل</span><strong>@Safe(data.ContactPersonName)</strong></div>
                    <div><span>رقم الترخيص</span><strong>@Safe(data.LicenseNumber)</strong></div>
                    <div><span>المحافظة</span><strong>@Safe(data.Governorate)</strong></div>
                    <div><span>المدينة / المركز</span><strong>@Safe(data.City)</strong></div>
                    <div class="wide"><span>العنوان بالتفصيل</span><strong>@Safe(data.AddressAr)</strong></div>
                    <div class="wide"><span>مواعيد العمل</span><strong>@Safe(data.WorkingHours)</strong></div>
                    @if (!string.IsNullOrWhiteSpace(data.WorkingDays))
                    {
                        <div class="wide"><span>أيام العمل</span><strong>@FormatWorkingDays(data.WorkingDays)</strong></div>
                    }
                    @if (data.DiscountPercentage > 0)
                    {
                        <div><span>نسبة الخصم للمستفيد</span><strong>@DiscountText(data.DiscountPercentage)</strong></div>
                    }
                    <div class="wide"><span>الخدمات والتفاصيل</span><strong>@Safe(data.DescriptionAr)</strong></div>
                </div>
            </article>

            <aside class="partner-dashboard-actions">
                <article class="partner-dashboard-card">
                    <div class="card-title"><span style="background:@AccentSoft;">▣</span><div><h2>مسح QR المستفيد</h2><p>التحقق من الطلب واستكمال بيانات التنفيذ</p></div></div>
                    <button type="button" style="background:@AccentColor;" @onclick="() => Nav.NavigateTo(ScanUrl)">فتح ماسح QR</button>
                </article>
                <article class="partner-dashboard-card">
                    <div class="card-title"><span style="background:@AccentSoft;">📋</span><div><h2>الطلبات المحولة</h2><p>الطلبات التي وافقت عليها الإدارة</p></div></div>
                    <button type="button" style="background:@AccentColor;" @onclick="() => Nav.NavigateTo(RequestsUrl)">فتح الطلبات</button>
                </article>
                <article class="partner-dashboard-card">
                    <div class="card-title"><span style="background:@AccentSoft;">🔔</span><div><h2>الإشعارات</h2><p>متابعة التحديثات والتنبيهات</p></div></div>
                    <button type="button" style="background:@AccentColor;" @onclick="() => Nav.NavigateTo(NotificationsUrl)">عرض الإشعارات</button>
                </article>
                @if (!string.IsNullOrWhiteSpace(SettingsUrl))
                {
                    <article class="partner-dashboard-card">
                        <div class="card-title"><span style="background:@AccentSoft;">⚙</span><div><h2>الإعدادات</h2><p>تحديث البيانات وتغيير كلمة المرور</p></div></div>
                        <button type="button" style="background:@AccentColor;" @onclick="() => Nav.NavigateTo(SettingsUrl)">فتح الإعدادات</button>
                    </article>
                }
            </aside>
        </section>
    }
</div>

<style>
    .partner-dashboard-page{padding:32px;min-height:calc(100vh - 80px);background:#f8fafc;color:#111827}.partner-dashboard-state{border:1px solid #e5e7eb;border-radius:24px;background:#fff;padding:28px;color:#667085;font-weight:900}.partner-dashboard-state.bad{border-color:#fecaca;background:#fef2f2;color:#991b1b}.partner-dashboard-hero{position:relative;overflow:hidden;border-radius:32px;padding:34px;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:22px}.hero-kicker{font-size:13px;font-weight:900;color:rgba(255,255,255,.8)}.partner-dashboard-hero h1{margin:7px 0 0;font-size:34px;font-weight:950}.partner-dashboard-hero p{margin:10px 0 0;color:rgba(255,255,255,.88);font-size:14px;font-weight:800}.hero-icon{width:90px;height:90px;border-radius:27px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.22);display:grid;place-items:center;font-size:45px}.partner-dashboard-stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px;margin-top:22px}.partner-dashboard-stats article,.partner-dashboard-card{border:1px solid #e5e7eb;border-radius:24px;background:#fff;padding:22px;box-shadow:0 14px 32px rgba(15,23,42,.05)}.partner-dashboard-stats span{display:block;color:#98a2b3;font-size:12px;font-weight:850}.partner-dashboard-stats strong{display:block;margin-top:8px;font-size:29px;font-weight:950}.partner-dashboard-stats .ok{color:#15803d}.partner-dashboard-stats .full{color:#dc2626}.partner-dashboard-grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(280px,.7fr);gap:18px;margin-top:22px}.partner-dashboard-actions{display:grid;gap:18px}.card-title{display:flex;align-items:center;gap:13px}.card-title>span{width:49px;height:49px;border-radius:16px;display:grid;place-items:center;font-size:23px}.card-title h2{margin:0;font-size:19px;font-weight:950}.card-title p{margin:5px 0 0;color:#98a2b3;font-size:12px;font-weight:800}.details-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:20px}.details-grid>div{border:1px solid #eef2f6;border-radius:17px;background:#f8fafc;padding:13px}.details-grid .wide{grid-column:1/-1}.details-grid span{display:block;color:#98a2b3;font-size:11px;font-weight:850}.details-grid strong{display:block;margin-top:6px;color:#344054;font-size:13px;font-weight:900;line-height:1.7;word-break:break-word}.partner-dashboard-card button{margin-top:18px;min-height:42px;border:0;border-radius:999px;padding:0 18px;color:#fff;font-size:13px;font-weight:950;cursor:pointer}@@media(max-width:1100px){.partner-dashboard-stats{grid-template-columns:repeat(3,minmax(0,1fr))}.partner-dashboard-grid{grid-template-columns:1fr}}@@media(max-width:700px){.partner-dashboard-page{padding:20px 12px}.partner-dashboard-hero{align-items:flex-start}.hero-icon{width:68px;height:68px;font-size:34px}.partner-dashboard-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.details-grid{grid-template-columns:1fr}.details-grid .wide{grid-column:auto}}

    .theme-dark .partner-dashboard-page{background:#0f172a;color:#f8fafc}
    .theme-dark .partner-dashboard-state,
    .theme-dark .partner-dashboard-stats article,
    .theme-dark .partner-dashboard-card{background:#1e293b;border-color:#334155;box-shadow:0 14px 32px rgba(0,0,0,.25)}
    .theme-dark .partner-dashboard-stats span,
    .theme-dark .card-title p,
    .theme-dark .details-grid span{color:#94a3b8}
    .theme-dark .partner-dashboard-stats strong,
    .theme-dark .card-title h2{color:#f8fafc}
    .theme-dark .details-grid>div{background:#0f172a;border-color:#334155}
    .theme-dark .details-grid strong{color:#e2e8f0}
    .theme-dark .partner-dashboard-state.bad{background:#3f1d24;border-color:#7f1d1d;color:#fecaca}
</style>

@code {
    [Parameter, EditorRequired] public string ArabicTitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string EnglishTitle { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "🏥";
    [Parameter, EditorRequired] public string RequestsUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ScanUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NotificationsUrl { get; set; } = string.Empty;
    [Parameter] public string SettingsUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public ServiceRequestType ServiceType { get; set; }
    [Parameter] public string AccentColor { get; set; } = "#05a843";
    [Parameter] public string AccentDark { get; set; } = "#047857";
    [Parameter] public string AccentSoft { get; set; } = "#ecfdf3";
    [Parameter] public string AccentShadow { get; set; } = "rgba(5,168,67,.22)";

    private bool loading = true;
    private PartnerDashboardDto? data;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var auth = await AuthState.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
        data = string.IsNullOrWhiteSpace(userId) ? null : await Ui.GetPartnerDashboardAsync(userId, ServiceType);
        loading = false;
    }

    private static string DiscountText(decimal value) => $"{Math.Clamp(value, 0m, 100m):0.##}%";
    private static string Safe(string? value) => string.IsNullOrWhiteSpace(value) ? "غير مسجل" : value;
    private static string FormatWorkingDays(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "جميع الأيام";
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        { ["Sat"]="السبت", ["Sun"]="الأحد", ["Mon"]="الاثنين", ["Tue"]="الثلاثاء", ["Wed"]="الأربعاء", ["Thu"]="الخميس", ["Fri"]="الجمعة" };
        return string.Join("، ", value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(x => map.GetValueOrDefault(x, x)));
    }
}
