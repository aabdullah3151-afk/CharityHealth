@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services

@inject HealthcareUiService Ui
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<div class="partner-dashboard-page" dir="rtl" style="--accent:@AccentColor;--accent-dark:@AccentDark;">
    <header class="hero">
        <div>
            <span>@EnglishTitle Workspace</span>
            <h1>لوحة @ArabicTitle</h1>
            <p>طلبات اليوم وكل الطلبات المعتمدة والمكتملة. يمكن تنفيذ الطلب مباشرة أو استخدام QR كطريقة اختيارية.</p>
        </div>
        <button type="button" @onclick='() => Nav.NavigateTo(ScanUrl)'>مسح QR اختياري</button>
    </header>

    @if (loading)
    {
        <section class="state">جارٍ تحميل الطلبات...</section>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <section class="error">@error</section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="message @(messageOk ? "ok" : "bad")">@message</div>
        }

        <section class="stats">
            <article><span>طلبات اليوم</span><strong>@TodayCount</strong><small>تشمل المكتملة اليوم</small></article>
            <article><span>جاهزة للتنفيذ</span><strong>@ReadyCount</strong><small>تم اعتمادها من الإدارة</small></article>
            <article><span>مكتملة</span><strong>@CompletedCount</strong><small>يمكن معاينتها وتعديلها</small></article>
            <article><span>كل الطلبات</span><strong>@rows.Count</strong><small>السجل الكامل للحساب</small></article>
        </section>

        @if (dashboard is not null)
        {
            <section class="account">
                <div><span>اسم الجهة</span><strong>@dashboard.NameAr</strong></div>
                <div><span>الهاتف</span><strong>@dashboard.PhoneNumber</strong></div>
                <div><span>المدينة</span><strong>@Safe(dashboard.City)</strong></div>
                <div><span>الخصم</span><strong>@dashboard.DiscountPercentage.ToString("0.##")%</strong></div>
            </section>
        }

        <section class="toolbar">
            <div class="tabs">
                <button class="@(filter == CaseFilter.Today ? "active" : "")" @onclick="() => filter = CaseFilter.Today">اليوم <b>@TodayCount</b></button>
                <button class="@(filter == CaseFilter.Ready ? "active" : "")" @onclick="() => filter = CaseFilter.Ready">جاهزة <b>@ReadyCount</b></button>
                <button class="@(filter == CaseFilter.Upcoming ? "active" : "")" @onclick="() => filter = CaseFilter.Upcoming">قادمة <b>@UpcomingCount</b></button>
                <button class="@(filter == CaseFilter.Completed ? "active" : "")" @onclick="() => filter = CaseFilter.Completed">مكتملة <b>@CompletedCount</b></button>
                <button class="@(filter == CaseFilter.All ? "active" : "")" @onclick="() => filter = CaseFilter.All">الكل <b>@rows.Count</b></button>
            </div>

            <label class="search">
                <span>🔎</span>
                <input @bind="search" @bind:event="oninput" placeholder="ابحث باسم المستفيد أو الهاتف أو رقم الطلب..." />
            </label>
        </section>

        @if (!FilteredRows.Any())
        {
            <section class="empty"><div>@Icon</div><h2>لا توجد طلبات مطابقة</h2><p>الطلبات التي تعتمدها الإدارة وتخصصها لهذا الحساب ستظهر هنا.</p></section>
        }
        else
        {
            <section class="grid">
                @foreach (var item in FilteredRows)
                {
                    <article class="case">
                        <div class="case-head">
                            <div class="avatar">@Icon</div>
                            <div><h2>@item.BeneficiaryName</h2><p>@RequestCode(item.Id) · @item.BeneficiaryPhone</p></div>
                            <span class="status @(item.Status == RequestStatus.Completed ? "completed" : "approved")">@item.StatusAr</span>
                        </div>

                        <div class="info">
                            <div><span>نوع الخدمة</span><strong>@item.ServiceTypeAr</strong></div>
                            <div><span>موعد الخدمة</span><strong>@AppointmentText(item)</strong></div>
                            <div><span>المدينة</span><strong>@Safe(item.City)</strong></div>
                            <div><span>المستندات</span><strong>@item.DocumentsCount</strong></div>
                        </div>

                        <div class="description">
                            <span>تفاصيل الطلب</span>
                            <p>@Safe(item.DescriptionAr, "لا توجد تفاصيل مرفقة.")</p>
                        </div>

                        @if (documents.TryGetValue(item.Id, out var itemDocuments) && itemDocuments.Count > 0)
                        {
                            <div class="docs">
                                @foreach (var document in itemDocuments)
                                {
                                    <a href="@DocumentUrl(document.FilePath)" target="_blank" rel="noopener">
                                        <span>📎</span><b>@document.FileName</b><small>@FileSizeText(document.FileSizeBytes)</small>
                                    </a>
                                }
                            </div>
                        }

                        <div class="result">
                            <label>@ResultLabel(item.Status)</label>
                            <textarea @bind="notes[item.Id]" rows="5" placeholder="@ResultPlaceholder"></textarea>

                            <div class="actions">
                                <button type="button" class="primary" disabled="@busyIds.Contains(item.Id)" @onclick="() => Save(item)">
                                    @(busyIds.Contains(item.Id)
                                        ? "جارٍ الحفظ..."
                                        : item.Status == RequestStatus.Completed
                                            ? "حفظ تعديل النتيجة"
                                            : DirectButtonText)
                                </button>

                                @if (item.Status == RequestStatus.Approved)
                                {
                                    <button type="button" class="secondary" @onclick='() => Nav.NavigateTo(ScanUrl)'>QR اختياري</button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </section>
        }
    }
</div>

<style>
