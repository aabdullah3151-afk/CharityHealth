</style>

@code {
    [Parameter, EditorRequired] public string ArabicTitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string EnglishTitle { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "🏥";
    [Parameter, EditorRequired] public ServiceRequestType ServiceType { get; set; }
    [Parameter, EditorRequired] public string ScanUrl { get; set; } = string.Empty;
    [Parameter] public string AccentColor { get; set; } = "#05a843";
    [Parameter] public string AccentDark { get; set; } = "#047857";

    private bool loading = true;
    private bool messageOk;
    private string? error;
    private string? message;
    private string userId = string.Empty;
    private string search = string.Empty;
    private CaseFilter filter = CaseFilter.Today;
    private PartnerDashboardDto? dashboard;
    private List<RequestWorkItem> rows = [];
    private Dictionary<Guid, string?> notes = [];
    private Dictionary<Guid, List<PartnerRequestDocument>> documents = [];
    private HashSet<Guid> busyIds = [];

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private int TodayCount => rows.Count(IsToday);
    private int ReadyCount => rows.Count(x => x.Status == RequestStatus.Approved);
    private int CompletedCount => rows.Count(x => x.Status == RequestStatus.Completed);
    private int UpcomingCount => rows.Count(x => x.AppointmentDate > Today && x.Status != RequestStatus.Completed);

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        error = null;

        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

            if (string.IsNullOrWhiteSpace(userId))
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            dashboard = await Ui.GetPartnerDashboardAsync(userId, ServiceType);
            rows = await Ui.GetPartnerRequestsAsync(userId, ServiceType);

            notes.Clear();
            documents.Clear();

            foreach (var item in rows)
            {
                notes[item.Id] = item.ProviderNoteAr;
                documents[item.Id] = await Ui.GetPartnerRequestDocumentsAsync(item.Id, userId, ServiceType);
            }
        }
        catch
        {
            error = "حدث خطأ أثناء تحميل طلبات الجهة.";
        }
        finally
        {
            loading = false;
        }
    }

    private IEnumerable<RequestWorkItem> FilteredRows
    {
        get
        {
            IEnumerable<RequestWorkItem> result = filter switch
            {
                CaseFilter.Today => rows.Where(IsToday),
                CaseFilter.Ready => rows.Where(x => x.Status == RequestStatus.Approved),
                CaseFilter.Upcoming => rows.Where(x => x.AppointmentDate > Today && x.Status != RequestStatus.Completed),
                CaseFilter.Completed => rows.Where(x => x.Status == RequestStatus.Completed),
                _ => rows
            };

            if (!string.IsNullOrWhiteSpace(search))
            {
                var term = search.Trim();
                result = result.Where(x =>
                    Contains(x.BeneficiaryName, term) ||
                    Contains(x.BeneficiaryPhone, term) ||
                    Contains(x.City, term) ||
                    Contains(x.ServiceTypeAr, term) ||
                    RequestCode(x.Id).Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return result
                .OrderBy(x => x.AppointmentDate ?? DateOnly.MaxValue)
                .ThenByDescending(x => x.SubmittedAt);
        }
    }

    private async Task Save(RequestWorkItem item)
    {
        busyIds.Add(item.Id);
        message = null;

        try
        {
            var result = await Ui.CompletePartnerRequestAsync(
                item.Id,
                userId,
                ServiceType,
                notes.GetValueOrDefault(item.Id));

            messageOk = result.Succeeded;
            message = result.Message;

            if (result.Succeeded)
            {
                await Load();
                messageOk = true;
                message = result.Message;
            }
        }
        catch
        {
            messageOk = false;
            message = "تعذر حفظ بيانات تنفيذ الطلب.";
        }
        finally
        {
            busyIds.Remove(item.Id);
        }
    }

    private bool IsToday(RequestWorkItem item) => item.AppointmentDate == Today;
    private static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string Safe(string? value, string fallback = "غير محدد") => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string RequestCode(Guid id) => $"REQ-{id.ToString("N")[..6].ToUpperInvariant()}";
    private static string FileSizeText(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024d:0.#} KB" : $"{bytes / 1024d / 1024d:0.##} MB";
    private string AppointmentText(RequestWorkItem item) => item.AppointmentDate is null ? "غير محدد" : item.AppointmentDate.Value == Today ? "اليوم" : item.AppointmentDate.Value.ToString("dd/MM/yyyy");
    private string ResultLabel(RequestStatus status) => status == RequestStatus.Completed ? "النتيجة المحفوظة — يمكن تعديلها" : ResultInputLabel;
    private string ResultInputLabel => ServiceType switch { ServiceRequestType.PharmacyMedication => "الأدوية التي تم صرفها", ServiceRequestType.LaboratoryTest => "نتيجة التحاليل أو بيانات التنفيذ", _ => "نتيجة تنفيذ الخدمة" };
    private string ResultPlaceholder => ServiceType switch { ServiceRequestType.PharmacyMedication => "اكتب أسماء الأدوية والكميات وتعليمات الصرف...", ServiceRequestType.LaboratoryTest => "اكتب التحاليل المنفذة والنتائج أو رقم العينة...", _ => "اكتب نتيجة تنفيذ الخدمة..." };
    private string DirectButtonText => ServiceType switch { ServiceRequestType.PharmacyMedication => "تأكيد صرف العلاج مباشرة", ServiceRequestType.LaboratoryTest => "تأكيد تنفيذ التحاليل مباشرة", _ => "تأكيد التنفيذ مباشرة" };

    private static string DocumentUrl(string path)
    {
        var value = (path ?? string.Empty).Trim().Replace("\\", "/");
        if (value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase)) return value;
        if (value.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase)) return "/" + value;
        return "/uploads/" + value.TrimStart('/');
    }

    private enum CaseFilter { Today, Ready, Upcoming, Completed, All }
}
