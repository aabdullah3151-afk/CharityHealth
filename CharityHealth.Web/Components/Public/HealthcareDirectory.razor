rd-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:16px}.card-actions button{min-height:40px;border-radius:12px;font-weight:900;cursor:pointer}.card-actions .details{border:1px solid #d0d5dd;background:#fff;color:#344054}.card-actions .primary{border:0;background:#059669;color:#fff}.public-directory-state{padding:34px;border:1px solid #e4e7ec;border-radius:22px;background:#fff;text-align:center;font-weight:900;color:#667085}.public-directory-state.error{color:#b42318;background:#fff5f5;border-color:#fecaca}@@media(max-width:1100px){.public-directory-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@@media(max-width:650px){.public-directory{padding:28px 14px 48px}.public-directory-head h2{font-size:28px}.public-directory-grid{grid-template-columns:1fr}.public-directory-block-head h3{font-size:19px}}
</style>
