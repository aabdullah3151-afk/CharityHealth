@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence
@using CharityHealth.Web.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject AppDbContext Db
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<section id="health-directory" class="public-directory @(Compact ? "compact" : "")" dir="rtl">
    <div class="public-directory-head">
        <div>
            <span class="public-directory-kicker">الدليل الطبي</span>
            <h2>الأكثر خدمة للمستفيدين</h2>
            <p>يتم ترتيب الأطباء والجهات حسب عدد الخدمات المكتملة فعليًا داخل النظام.</p>
        </div>
    </div>

    @if (loading)
    {
        <div class="public-directory-state">جارٍ تحميل الدليل الطبي...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="public-directory-state error">@error</div>
    }
    else
    {
        <section class="public-directory-block">
            <div class="public-directory-block-head">
                <div>
                    <span class="directory-icon">🩺</span>
                    <h3>الأطباء الأكثر كشفًا</h3>
                </div>
                <button type="button" @onclick='() => Nav.NavigateTo("/directory/doctors")'>كل الأطباء</button>
            </div>

            <div class="public-directory-grid">
                @foreach (var doctor in doctors)
                {
                    <article class="public-directory-card" @onclick='() => Nav.NavigateTo($"/directory/doctor/{doctor.Id}")'>
                        <div class="card-top">
                            <span class="card-avatar">د</span>
                            <span class="service-count">@doctor.CompletedServices كشف مكتمل</span>
                        </div>
                        <h4>@doctor.NameAr</h4>
                        <strong>@doctor.SpecialtyName</strong>
                        <p>📍 @Safe(doctor.ClinicAddress, "العنوان غير مسجل")</p>
                        <div class="card-actions">
                            <button type="button" class="details" @onclick:stopPropagation="true" @onclick='() => Nav.NavigateTo($"/directory/doctor/{doctor.Id}")'>التفاصيل</button>
                            <button type="button" class="primary" @onclick:stopPropagation="true" @onclick='() => OpenProtected($"/portal/request/medical?doctorId={doctor.Id}")'>طلب حجز موعد</button>
                        </div>
                    </article>
                }
            </div>
        </section>

        @foreach (var group in ProviderGroups)
        {
            <section class="public-directory-block">
                <div class="public-directory-block-head">
                    <div>
                        <span class="directory-icon">@group.Icon</span>
                        <h3>@group.Title الأكثر خدمة</h3>
                    </div>
                    <button type="button" @onclick='() => Nav.NavigateTo($"/directory/{group.Slug}")'>عرض الكل</button>
                </div>

                <div class="public-directory-grid">
                    @foreach (var provider in group.Items)
                    {
                        <article class="public-directory-card" @onclick='() => OpenProvider(provider)'>
                            <div class="card-top">
                                <span class="card-avatar provider">@group.Icon</span>
                                <span class="service-count">@provider.CompletedServices خدمة مكتملة</span>
                            </div>
                            <h4>@provider.NameAr</h4>
                            <strong>@group.Title</strong>
                            <p>📍 @ProviderAddress(provider)</p>
                            <div class="card-actions">
                                <button type="button" class="details" @onclick:stopPropagation="true" @onclick='() => OpenProvider(provider)'>التفاصيل</button>
                                <button type="button" class="primary" @onclick:stopPropagation="true" @onclick='() => OpenProtected(ProviderRequestUrl(provider))'>تقديم طلب</button>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    }
</section>

@code {
    [Parameter] public bool Compact { get; set; }

    private bool loading = true;
    private string? error;
    private List<PublicDoctorCard> doctors = [];
    private List<PublicProviderCard> pharmacies = [];
    private List<PublicProviderCard> laboratories = [];
    private List<PublicProviderCard> radiologyCenters = [];

    private IEnumerable<(string Slug, string Title, string Icon, List<PublicProviderCard> Items)> ProviderGroups =>
    [
        ("pharmacies", "الصيدليات", "💊", pharmacies),
        ("laboratories", "معامل التحاليل", "🧪", laboratories),
        ("radiology-centers", "مراكز الأشعة", "🩻", radiologyCenters)
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            doctors = await PublicDirectoryData.GetDoctorsAsync(Db, 4);
            pharmacies = await PublicDirectoryData.GetProvidersAsync(Db, ServiceRequestType.PharmacyMedication, 4);
            laboratories = await PublicDirectoryData.GetProvidersAsync(Db, ServiceRequestType.LaboratoryTest, 4);
            radiologyCenters = await PublicDirectoryData.GetProvidersAsync(Db, ServiceRequestType.RadiologyScan, 4);
        }
        catch
        {
            error = "تعذر تحميل الدليل الطبي حاليًا.";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenProvider(PublicProviderCard provider)
    {
        var slug = PublicDirectoryData.SlugFor(provider.ServiceType);
        Nav.NavigateTo($"/directory/provider/{slug}/{Uri.EscapeDataString(provider.UserId)}");
    }

    private string ProviderRequestUrl(PublicProviderCard provider) =>
        $"/portal/request/service/{provider.ServiceType}?provider={Uri.EscapeDataString(provider.UserId)}";

    private async Task OpenProtected(string target)
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true && auth.User.IsInRole("Beneficiary"))
        {
            Nav.NavigateTo(target);
            return;
        }

        var message = Uri.EscapeDataString("سجل الدخول أولًا حتى تتمكن من الحجز أو تقديم الطلب.");
        var returnUrl = Uri.EscapeDataString(target);
        Nav.NavigateTo($"/login?error={message}&returnUrl={returnUrl}");
    }

    private static string Safe(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string ProviderAddress(PublicProviderCard provider)
    {
        var parts = new[] { provider.Governorate, provider.City, provider.AddressAr }
            .Where(x => !string.IsNullOrWhiteSpace(x));
        var text = string.Join(" - ", parts);
        return string.IsNullOrWhiteSpace(text) ? "العنوان غير مسجل" : text;
    }
}

