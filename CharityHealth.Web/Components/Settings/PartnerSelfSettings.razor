@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using CharityHealth.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState

<div class="self-settings-page" dir="rtl" style="--settings-accent:@AccentColor;--settings-soft:@AccentSoft;">
    <header class="self-settings-head">
        <div class="settings-icon">@Icon</div>
        <div>
            <div class="settings-kicker">Account Settings</div>
            <h1>إعدادات @AccountLabel</h1>
            <p>يمكنك تحديث بيانات التواصل والعنوان ومواعيد العمل وتغيير كلمة المرور.</p>
        </div>
    </header>

    @if (loading)
    {
        <section class="settings-state">جارٍ تحميل الإعدادات...</section>
    }
    else if (user is null)
    {
        <section class="settings-message bad">تعذر العثور على الحساب الحالي.</section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(profileMessage))
        {
            <div class="settings-message @(profileOk ? "ok" : "bad")">@profileMessage</div>
        }

        <section class="settings-card">
            <div class="settings-card-title"><span>🏥</span><div><h2>بيانات @AccountLabel</h2><p>البريد ونوع الحساب لا يمكن تغييرهما من هذه الصفحة.</p></div></div>

            <div class="settings-grid">
                <label><span>الاسم بالعربي *</span><input @bind="nameAr" @bind:event="oninput" /></label>
                <label><span>الاسم بالإنجليزي</span><input @bind="nameEn" @bind:event="oninput" dir="ltr" /></label>
                <label><span>البريد الإلكتروني</span><input value="@user.Email" readonly dir="ltr" /></label>
                <label><span>رقم الهاتف *</span><input @bind="phone" @bind:event="oninput" dir="ltr" /></label>
                <label><span>مسؤول التواصل</span><input @bind="contactPerson" @bind:event="oninput" /></label>
                <label><span>رقم الترخيص</span><input @bind="licenseNumber" @bind:event="oninput" /></label>
                <label><span>المحافظة *</span><input @bind="governorate" @bind:event="oninput" /></label>
                <label><span>المدينة / المركز *</span><input @bind="city" @bind:event="oninput" /></label>
                @if (ShowWorkingDays)
                {
                    <label><span>بداية وقت العمل</span><input type="time" value="@workStartTime" @onchange="OnWorkStartTimeChanged" /></label>
                    <label><span>نهاية وقت العمل</span><input type="time" value="@workEndTime" @onchange="OnWorkEndTimeChanged" /></label>
                    <div class="wide settings-days">
                        <span>أيام العمل *</span>
                        <div>
                            @foreach (var day in Days)
                            {
                                <label>
                                    <input type="checkbox" checked="@workingDays.Contains(day.Code)" @onchange="e => ToggleDay(day.Code, e)" />
                                    <b>@day.Name</b>
                                </label>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <label class="wide"><span>ساعات العمل</span><input @bind="workingHours" @bind:event="oninput" placeholder="مثال: من 9 صباحًا إلى 10 مساءً" /></label>
                }

                <label class="wide"><span>@(ShowWorkingDays ? "عنوان المعمل بالتفصيل *" : "العنوان بالتفصيل *")</span><textarea @bind="address" @bind:event="oninput" rows="3"></textarea></label>
                <label class="wide"><span>وصف الخدمات والتفاصيل</span><textarea @bind="description" @bind:event="oninput" rows="5" maxlength="1500"></textarea></label>
            </div>

            <div class="settings-readonly-grid">
                <div><span>السعة اليومية</span><strong>@user.DailyRequestCapacity طلب</strong><small>يحددها الأدمن</small></div>
                @if (ShowDiscount)
                {
                    <div class="settings-discount-box"><span>نسبة الخصم للمستفيد</span><strong>@user.DiscountPercentage.ToString("0.##")%</strong><small>تظهر للمستفيد عند اختيار المعمل</small></div>
                }
                <div><span>حالة الحساب</span><strong>@(user.IsActive ? "نشط" : "غير نشط")</strong><small>تتحكم بها الإدارة</small></div>
            </div>

            <div class="settings-actions">
                <button type="button" disabled="@savingProfile" @onclick="SaveProfile">@(savingProfile ? "جارٍ الحفظ..." : "حفظ البيانات")</button>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(passwordMessage))
        {
            <div class="settings-message @(passwordOk ? "ok" : "bad")">@passwordMessage</div>
        }

        <section class="settings-card">
            <div class="settings-card-title"><span>🔐</span><div><h2>تغيير كلمة المرور</h2><p>اكتب كلمة المرور الحالية ثم كلمة المرور الجديدة.</p></div></div>
            <div class="settings-grid password-grid">
                <label><span>كلمة المرور الحالية *</span><input @bind="currentPassword" type="password" autocomplete="current-password" dir="ltr" /></label>
                <label><span>كلمة المرور الجديدة *</span><input @bind="newPassword" type="password" autocomplete="new-password" dir="ltr" /></label>
                <label><span>تأكيد كلمة المرور الجديدة *</span><input @bind="confirmPassword" type="password" autocomplete="new-password" dir="ltr" /></label>
            </div>
            <div class="settings-actions">
                <button type="button" disabled="@savingPassword" @onclick="ChangePassword">@(savingPassword ? "جارٍ التغيير..." : "تغيير كلمة المرور")</button>
            </div>
        </section>
    }
</div>

<style>
.self-settings-page{min-height:calc(100vh - 76px);padding:34px;background:#f8fafc;color:#101828}.self-settings-head{border-radius:30px;background:linear-gradient(135deg,var(--settings-accent),color-mix(in srgb,var(--settings-accent) 72%,#0f172a));color:#fff;padding:28px 30px;display:flex;align-items:center;gap:18px;box-shadow:0 20px 44px color-mix(in srgb,var(--settings-accent) 22%,transparent)}.settings-icon{width:70px;height:70px;border-radius:23px;background:rgba(255,255,255,.18);display:grid;place-items:center;font-size:34px}.settings-kicker{font-size:12px;font-weight:950;color:rgba(255,255,255,.75)}.self-settings-head h1{margin:5px 0 0;font-size:34px;font-weight:950}.self-settings-head p{margin:8px 0 0;color:rgba(255,255,255,.84);font-size:13px;font-weight:800}.settings-card{margin-top:22px;border:1px solid #e5e7eb;border-radius:28px;background:#fff;padding:26px;box-shadow:0 14px 34px rgba(15,23,42,.06)}.settings-card-title{display:flex;align-items:center;gap:12px;margin-bottom:22px}.settings-card-title>span{width:50px;height:50px;border-radius:17px;background:var(--settings-soft);display:grid;place-items:center;font-size:24px}.settings-card-title h2{margin:0;font-size:22px;font-weight:950}.settings-card-title p{margin:5px 0 0;color:#98a2b3;font-size:12px;font-weight:800}.settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.settings-grid label{display:grid;gap:8px;color:#344054;font-size:13px;font-weight:900}.settings-grid input,.settings-grid textarea{width:100%;box-sizing:border-box;border:1px solid #e5e7eb;border-radius:16px;background:#f8fafc;padding:13px 15px;color:#111827;font:inherit;font-size:13px;font-weight:800;outline:none}.settings-grid input{height:52px}.settings-grid input[readonly]{background:#f1f5f9;color:#98a2b3}.settings-grid textarea{resize:vertical}.settings-grid .wide{grid-column:1/-1}.settings-days{display:grid;gap:9px;color:#344054;font-size:13px;font-weight:900}.settings-days>div{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}.settings-days label{border:1px solid #e5e7eb;border-radius:14px;background:#f8fafc;padding:11px 7px;display:flex;align-items:center;justify-content:center;gap:7px;cursor:pointer}.settings-days input{width:17px!important;height:17px!important;padding:0!important;accent-color:var(--settings-accent)}.settings-days b{font-size:11px}.settings-readonly-grid{margin-top:18px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px}.settings-readonly-grid>div{border:1px solid color-mix(in srgb,var(--settings-accent) 25%,#e5e7eb);border-radius:18px;background:var(--settings-soft);padding:15px}.settings-readonly-grid span,.settings-readonly-grid small{display:block;color:#667085;font-size:11px;font-weight:850}.settings-readonly-grid strong{display:block;margin:6px 0;color:#111827;font-size:20px;font-weight:950}.settings-discount-box{border:2px solid var(--settings-accent)!important;box-shadow:0 10px 24px color-mix(in srgb,var(--settings-accent) 16%,transparent)}.settings-discount-box strong{color:var(--settings-accent);font-size:26px}.settings-actions{margin-top:20px;display:flex;justify-content:flex-end}.settings-actions button{min-height:48px;border:0;border-radius:999px;background:var(--settings-accent);color:#fff;padding:0 25px;font-size:14px;font-weight:950;cursor:pointer}.settings-actions button:disabled{opacity:.6}.settings-message,.settings-state{margin-top:18px;border-radius:18px;padding:15px 18px;font-size:13px;font-weight:900}.settings-message.ok{background:#ecfdf3;color:#047857}.settings-message.bad{background:#fef2f2;color:#991b1b}.settings-state{background:#fff;border:1px solid #e5e7eb;color:#667085}.password-grid{grid-template-columns:repeat(3,minmax(0,1fr))}@@media(max-width:900px){.settings-days>div{grid-template-columns:repeat(4,minmax(0,1fr))}.settings-readonly-grid,.password-grid{grid-template-columns:1fr}}@@media(max-width:650px){.self-settings-page{padding:18px 12px}.self-settings-head{padding:22px 18px}.self-settings-head h1{font-size:27px}.settings-grid{grid-template-columns:1fr}.settings-grid .wide{grid-column:auto}.settings-days>div{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>

@code {
    [Parameter, EditorRequired] public string AccountLabel { get; set; } = "الجهة";
    [Parameter] public string Icon { get; set; } = "🏥";
    [Parameter] public string AccentColor { get; set; } = "#05a843";
    [Parameter] public string AccentSoft { get; set; } = "#ecfdf3";
    [Parameter] public bool ShowWorkingDays { get; set; }
    [Parameter] public bool ShowDiscount { get; set; }

    private bool loading = true;
    private bool savingProfile;
    private bool savingPassword;
    private bool profileOk;
    private bool passwordOk;
    private string? profileMessage;
    private string? passwordMessage;
    private ApplicationUser? user;
    private string nameAr = string.Empty;
    private string? nameEn;
    private string? phone;
    private string? contactPerson;
    private string? licenseNumber;
    private string governorate = string.Empty;
    private string city = string.Empty;
    private string address = string.Empty;
    private string? workingHours;
    private string? workStartTime;
    private string? workEndTime;
    private string? description;
    private HashSet<string> workingDays = [];
    private string? currentPassword;
    private string? newPassword;
    private string? confirmPassword;

    private readonly List<DayOption> Days =
    [
        new("Sat", "السبت"), new("Sun", "الأحد"), new("Mon", "الاثنين"),
        new("Tue", "الثلاثاء"), new("Wed", "الأربعاء"), new("Thu", "الخميس"), new("Fri", "الجمعة")
    ];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        user = string.IsNullOrWhiteSpace(userId) ? null : await UserManager.FindByIdAsync(userId);
        if (user is not null)
        {
            nameAr = user.FullNameAr;
            nameEn = user.FullNameEn;
            phone = user.PhoneNumber;
            contactPerson = user.ContactPersonName;
            licenseNumber = user.LicenseNumber;
            governorate = user.Governorate ?? string.Empty;
            city = user.City ?? string.Empty;
            address = user.AddressAr ?? string.Empty;
            workingHours = user.WorkingHours;
            (workStartTime, workEndTime) = ParseWorkingHours(user.WorkingHours);
            description = user.DescriptionAr;
            workingDays = ParseDays(user.WorkingDays);
        }
        loading = false;
    }

    private void ToggleDay(string code, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected) workingDays.Add(code);
        else workingDays.Remove(code);
    }

    private void OnWorkStartTimeChanged(ChangeEventArgs args)
        => workStartTime = args.Value?.ToString();

    private void OnWorkEndTimeChanged(ChangeEventArgs args)
        => workEndTime = args.Value?.ToString();

    private async Task SaveProfile()
    {
        profileMessage = null;
        profileOk = false;
        if (user is null) return;
        if (string.IsNullOrWhiteSpace(nameAr)) { profileMessage = "الاسم بالعربي مطلوب."; return; }
        if (string.IsNullOrWhiteSpace(phone)) { profileMessage = "رقم الهاتف مطلوب."; return; }
        if (string.IsNullOrWhiteSpace(governorate) || string.IsNullOrWhiteSpace(city) || string.IsNullOrWhiteSpace(address)) { profileMessage = "المحافظة والمدينة والعنوان مطلوبة."; return; }
        if (ShowWorkingDays && workingDays.Count == 0) { profileMessage = "اختر يوم عمل واحدًا على الأقل."; return; }
        if (ShowWorkingDays && !ValidTimeRange(workStartTime, workEndTime)) { profileMessage = "وقت نهاية العمل يجب أن يكون بعد وقت البداية."; return; }

        savingProfile = true;
        try
        {
            user.FullNameAr = nameAr.Trim();
            user.FullNameEn = Clean(nameEn) ?? nameAr.Trim();
            user.PhoneNumber = Clean(phone);
            user.PhoneNumberConfirmed = true;
            user.ContactPersonName = Clean(contactPerson);
            user.LicenseNumber = Clean(licenseNumber);
            user.Governorate = governorate.Trim();
            user.City = city.Trim();
            user.AddressAr = address.Trim();
            user.WorkingHours = ShowWorkingDays ? BuildWorkingHours(workStartTime, workEndTime) : Clean(workingHours);
            user.WorkingDays = ShowWorkingDays ? string.Join(",", workingDays) : user.WorkingDays;
            user.DescriptionAr = Clean(description);
            user.UpdatedAt = DateTime.UtcNow;

            var result = await UserManager.UpdateAsync(user);
            if (!result.Succeeded) { profileMessage = Errors(result); return; }

            var claims = await UserManager.GetClaimsAsync(user);
            foreach (var claim in claims.Where(c => c.Type == "FullNameAr").ToList()) await UserManager.RemoveClaimAsync(user, claim);
            await UserManager.AddClaimAsync(user, new Claim("FullNameAr", user.FullNameAr));

            profileOk = true;
            profileMessage = "تم حفظ البيانات بنجاح. لتحديث الاسم في الشريط العلوي سجّل الخروج ثم ادخل مرة أخرى.";
        }
        catch (Exception ex) { profileMessage = $"تعذر حفظ البيانات: {ex.Message}"; }
        finally { savingProfile = false; }
    }

    private async Task ChangePassword()
    {
        passwordMessage = null;
        passwordOk = false;
        if (user is null) return;
        if (string.IsNullOrWhiteSpace(currentPassword)) { passwordMessage = "اكتب كلمة المرور الحالية."; return; }
        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8) { passwordMessage = "كلمة المرور الجديدة يجب ألا تقل عن 8 أحرف أو أرقام."; return; }
        if (!string.Equals(newPassword, confirmPassword, StringComparison.Ordinal)) { passwordMessage = "تأكيد كلمة المرور غير مطابق."; return; }

        savingPassword = true;
        try
        {
            var result = await UserManager.ChangePasswordAsync(user, currentPassword, newPassword);
            if (!result.Succeeded) { passwordMessage = Errors(result); return; }
            passwordOk = true;
            passwordMessage = "تم تغيير كلمة المرور بنجاح.";
            currentPassword = newPassword = confirmPassword = null;
        }
        catch (Exception ex) { passwordMessage = $"تعذر تغيير كلمة المرور: {ex.Message}"; }
        finally { savingPassword = false; }
    }

    private static (string? Start, string? End) ParseWorkingHours(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return (null, null);
        var matches = System.Text.RegularExpressions.Regex.Matches(value, @"(?<!\d)([01]?\d|2[0-3]):[0-5]\d(?!\d)");
        return matches.Count switch
        {
            0 => (null, null),
            1 => (matches[0].Value, null),
            _ => (matches[0].Value, matches[1].Value)
        };
    }

    private static string? BuildWorkingHours(string? start, string? end)
    {
        start = Clean(start);
        end = Clean(end);
        if (start is null && end is null) return null;
        if (start is not null && end is not null) return $"{start} - {end}";
        return start is not null ? $"من {start}" : $"حتى {end}";
    }

    private static bool ValidTimeRange(string? start, string? end)
    {
        if (string.IsNullOrWhiteSpace(start) || string.IsNullOrWhiteSpace(end)) return true;
        return TimeOnly.TryParse(start, out var from) && TimeOnly.TryParse(end, out var to) && to > from;
    }

    private static HashSet<string> ParseDays(string? value) => string.IsNullOrWhiteSpace(value)
        ? []
        : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet(StringComparer.OrdinalIgnoreCase);
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Errors(IdentityResult result) => string.Join(" | ", result.Errors.Select(e => e.Description));
    private sealed record DayOption(string Code, string Name);
}
