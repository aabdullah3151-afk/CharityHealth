@page "/admin/requests/{Id:guid}"
@page "/admin/consultations/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles="Administrator,Staff")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CharityHealth.Domain.Entities
@using CharityHealth.Infrastructure.Persistence
@using CharityHealth.Web.Shared
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
<PageTitle>تفاصيل الحالة</PageTitle><link href="/css/admin-medical-profiles.css" rel="stylesheet" />
<div class="ch-page"><button class="ch-btn gray" @onclick='() => Nav.NavigateTo("/admin/requests")'>← العودة للطلبات</button>
@if(loading){<div class="ch-empty">جارٍ التحميل...</div>}else if(request is null){<div class="ch-empty">الطلب غير موجود.</div>}else{
<section class="ch-hero"><div class="ch-icon">📋</div><div class="title"><span>Medical Case</span><h1>طلب #@request.Id.ToString()[..8]</h1><strong>@Service(request.ServiceType.ToString())</strong></div><div class="badge">@Status(request.Status.ToString())</div></section>
<section class="ch-section"><h2>بيانات المريض</h2><div class="ch-info"><Field L="الاسم" V="@PatientName"/><Field L="الهاتف" V="@Show(patient?.PhoneNumber)"/><Field L="البريد" V="@Show(patient?.Email)"/><Field L="الرقم القومي" V="@Show(Text(beneficiary,"NationalId","NationalNumber"))"/><Field L="تاريخ الميلاد" V="@Show(Text(beneficiary,"DateOfBirth","BirthDate"))"/><Field L="العنوان" V="@Show(Text(beneficiary,"AddressAr","Address"))"/></div></section>
<section class="ch-section"><h2>تفاصيل الطلب</h2><div class="ch-info"><Field L="تاريخ الإنشاء" V="@request.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")"/><Field L="موعد الخدمة" V="@(request.AppointmentDate?.ToString("yyyy/MM/dd")??"غير محدد")"/><Field L="الحالة" V="@Status(request.Status.ToString())"/><Field L="الجهة المنفذة" V="@Show(provider?.FullNameAr)"/></div><div class="ch-text"><span>سبب الطلب / الشكوى</span><p>@Show(request.DescriptionAr)</p></div><div class="ch-text"><span>ملاحظة المراجعة</span><p>@Show(request.ReviewNoteAr)</p></div><div class="ch-text"><span>ملاحظة الجهة</span><p>@Show(request.ProviderNoteAr)</p></div></section>
@if(doctor is not null){<section class="ch-section"><h2>بيانات الطبيب</h2><div class="ch-info"><Field L="الاسم" V="@Show(doctor.User.FullNameAr)"/><Field L="التخصص" V="@Show(doctor.Specialty?.NameAr)"/><Field L="الهاتف" V="@Show(doctor.User.PhoneNumber)"/><Field L="رقم الترخيص" V="@Show(doctor.LicenseNumber)"/></div></section>}
@if(consultation is not null){<section class="ch-section"><h2>نتيجة الطبيب</h2><div class="ch-text"><span>التشخيص</span><p>@Show(consultation.DiagnosisAr)</p></div><div class="ch-text"><span>العلاج والتوصيات</span><p>@Show(consultation.RecommendationsAr)</p></div><div class="ch-text"><span>ملاحظات الطبيب</span><p>@Show(consultation.NotesAr)</p></div><div class="ch-text"><span>الوصفة الطبية</span><p>@Show(Text(consultation,"PrescriptionAr","Prescription","MedicationAr"))</p></div><div class="ch-text"><span>النتيجة النهائية</span><p>@Show(Text(consultation,"ResultAr","Result","OutcomeAr"),consultation.RecommendationsAr??"غير مسجل")</p></div></section>}}
</div>
@code{[Parameter]public Guid Id{get;set;}private bool loading=true;private MedicalRequest? request;private Consultation? consultation;private Beneficiary? beneficiary;private ApplicationUser? patient;private ApplicationUser? provider;private Doctor? doctor;private string PatientName=>Show(patient?.FullNameAr,Show(Text(beneficiary,"FullNameAr","NameAr","FullName")));protected override async Task OnParametersSetAsync(){await using var db=await DbFactory.CreateDbContextAsync();request=await db.MedicalRequests.AsNoTracking().FirstOrDefaultAsync(x=>x.Id==Id);if(request is null){consultation=await db.Consultations.AsNoTracking().FirstOrDefaultAsync(x=>x.Id==Id);if(consultation is not null)request=await db.MedicalRequests.AsNoTracking().FirstOrDefaultAsync(x=>x.Id==consultation.RequestId);}if(request is null){loading=false;return;}consultation??=await db.Consultations.AsNoTracking().FirstOrDefaultAsync(x=>x.RequestId==request.Id);beneficiary=await db.Beneficiaries.AsNoTracking().FirstOrDefaultAsync(x=>x.Id==request.BeneficiaryId);var uid=Text(beneficiary,"UserId","ApplicationUserId");if(!string.IsNullOrWhiteSpace(uid))patient=await db.Users.AsNoTracking().FirstOrDefaultAsync(x=>x.Id==uid);if(!string.IsNullOrWhiteSpace(request.AssignedProviderUserId))provider=await db.Users.AsNoTracking().FirstOrDefaultAsync(x=>x.Id==request.AssignedProviderUserId);if(request.DoctorId is not null)doctor=await db.Doctors.AsNoTracking().Include(x=>x.User).Include(x=>x.Specialty).FirstOrDefaultAsync(x=>x.Id==request.DoctorId.Value);else if(consultation is not null)doctor=await db.Doctors.AsNoTracking().Include(x=>x.User).Include(x=>x.Specialty).FirstOrDefaultAsync(x=>x.UserId==consultation.DoctorId);loading=false;}private static string Status(string s)=>s switch{"Submitted"=>"مرسل","UnderReview"=>"قيد المراجعة","Approved"=>"مقبول","Completed"=>"مكتمل","Rejected"=>"مرفوض",_=>s};private static string Service(string s)=>s switch{"MedicalConsultation"=>"كشف طبي","Pharmacy"=>"صرف دواء","Laboratory"=>"تحاليل","Radiology"=>"أشعة",_=>s};private static string Text(object? o,params string[] ps){if(o is null)return"";foreach(var p in ps){var v=o.GetType().GetProperty(p)?.GetValue(o);var t=Convert.ToString(v);if(!string.IsNullOrWhiteSpace(t))return t;}return"";}private static string Show(string? v,string f="غير مسجل")=>string.IsNullOrWhiteSpace(v)?f:v;}
