@page "/admin/audit-logs"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator,Staff")]

@using Microsoft.AspNetCore.Authorization
@using CharityHealth.Web.Services
@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore

@inject HealthcareUiService Ui
@inject AppDbContext Db

<PageTitle>سجل العمليات</PageTitle>

<div class="admin-list-page" dir="rtl">

    <header class="admin-list-head">
        <div>
            <div class="admin-list-kicker">Audit 🛡️</div>
            <h1>سجل العمليات</h1>
            <p>آخر 500 عملية حقيقية مسجلة داخل قاعدة البيانات.</p>
        </div>

        <div class="admin-search-box">
            <span>⌕</span>
            <input @bind="search"
                   @bind:event="oninput"
                   placeholder="بحث بالعملية أو الكيان أو المستخدم أو IP..." />
        </div>
    </header>

    @if (loading)
    {
        <div class="admin-state-card">جارٍ تحميل سجل العمليات...</div>
    }
    else
    {
        <section class="admin-stats-grid audit-live-grid">
            <div class="admin-stat-card">
                <span>العمليات المسجلة</span>
                <strong>@logs.Count</strong>
                <small>آخر 500 عملية فعلية</small>
            </div>

            <div class="admin-stat-card">
                <span>طلبات اليوم</span>
                <strong>@todayRequests</strong>
                <small>من قاعدة البيانات</small>
            </div>

            <div class="admin-stat-card">
                <span>طلبات معتمدة اليوم</span>
                <strong>@todayApproved</strong>
                <small>مقبولة أو مكتملة</small>
            </div>

            <div class="admin-stat-card">
                <span>استخدامات QR اليوم</span>
                <strong>@todayQrUsed</strong>
                <small>عمليات مسح فعلية</small>
            </div>
        </section>

        <section class="admin-table-card">
            <div class="admin-table-title">
                <h2>العمليات الأخيرة</h2>
                <span>@FilteredLogs.Count() عملية</span>
            </div>

            @if (!FilteredLogs.Any())
            {
                <div class="admin-state-card inside">لا توجد نتائج مطابقة للبحث.</div>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="admin-modern-table audit-table">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>العملية</th>
                                <th>الكيان</th>
                                <th>رقم الكيان</th>
                                <th>المستخدم</th>
                                <th>IP</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var log in FilteredLogs)
                            {
                                <tr>
                                    <td>
                                        <strong class="admin-date-cell">
                                            @log.Timestamp.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                        </strong>
                                    </td>

                                    <td>
                                        <span class="admin-action-pill @ActionClass(log.Action)" title="@log.Action">
                                            @ActionLabel(log.Action)
                                        </span>
                                    </td>

                                    <td>
                                        <strong>@EntityLabel(log.EntityType)</strong>
                                        <small style="display:block;color:#98a2b3;font-weight:800;margin-top:4px;">@log.EntityType</small>
                                    </td>

                                    <td class="mono-cell">@ShortId(log.EntityId)</td>

                                    <td class="mono-cell">@ShortId(log.UserId)</td>

                                    <td class="mono-cell">@(!string.IsNullOrWhiteSpace(log.IpAddress) ? log.IpAddress : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    private bool loading = true;
    private string search = string.Empty;
    private List<AuditLogListItem> logs = [];
    private int todayRequests;
    private int todayApproved;
    private int todayQrUsed;

    protected override async Task OnInitializedAsync()
    {
        logs = await Ui.GetAuditLogsAsync();
        var today = DateTime.UtcNow.Date;
        var tomorrow = today.AddDays(1);

        todayRequests = await Db.MedicalRequests.AsNoTracking()
            .CountAsync(x => x.SubmittedAt >= today && x.SubmittedAt < tomorrow);

        todayApproved = await Db.MedicalRequests.AsNoTracking()
            .CountAsync(x => x.ReviewedAt >= today && x.ReviewedAt < tomorrow &&
                (x.Status == RequestStatus.Approved || x.Status == RequestStatus.Completed));

        todayQrUsed = logs.Count(x => x.Action.Equals("QR.Used", StringComparison.OrdinalIgnoreCase) &&
            x.Timestamp >= today && x.Timestamp < tomorrow);

        loading = false;
    }

    private IEnumerable<AuditLogListItem> FilteredLogs
    {
        get
        {
            if (string.IsNullOrWhiteSpace(search))
            {
                return logs;
            }

            var value = search.Trim();

            return logs.Where(l =>
                l.Action.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                ActionLabel(l.Action).Contains(value, StringComparison.OrdinalIgnoreCase) ||
                l.EntityType.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                EntityLabel(l.EntityType).Contains(value, StringComparison.OrdinalIgnoreCase) ||
                (l.EntityId?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.UserId?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (l.IpAddress?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false)
            );
        }
    }

    private static string ShortId(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        if (value.Length <= 14)
        {
            return value;
        }

        return $"{value[..8]}…{value[^6..]}";
    }

    private static string EntityLabel(string entityType) => entityType switch
    {
        "ApplicationUser" => "مستخدم",
        "MedicalRequest" => "طلب طبي",
        "QRCodeToken" => "QR",
        "Consultation" => "استشارة",
        "Notification" => "إشعار",
        "Specialty" => "تخصص",
        "Doctor" => "طبيب",
        "Pharmacy" => "صيدلية",
        "Laboratory" => "معمل تحاليل",
        "RadiologyCenter" => "مركز أشعة",
        _ => string.IsNullOrWhiteSpace(entityType) ? "غير محدد" : entityType
    };

    private static string ActionLabel(string action) => action switch
    {
        "Auth.Login.Success" => "تسجيل دخول ناجح",
        "Auth.Login.Fail" => "فشل تسجيل الدخول",
        "Auth.Logout" => "تسجيل خروج",

        "Request.Submitted" => "تقديم طلب",
        "Request.UnderReview" => "تحويل الطلب للمراجعة",
        "Request.Approved" => "قبول طلب",
        "Request.Rejected" => "رفض طلب",
        "Request.AutoRejected.CapacityFull" => "رفض تلقائي لاكتمال اليوم",

        "QR.Generated" => "توليد QR",
        "QR.Renewed" => "تجديد QR",
        "QR.Used" => "استخدام QR",

        "Consultation.Completed" => "تسجيل نتيجة الكشف",

        "Notification.Created" => "إنشاء إشعار",

        "Specialty.Created" => "إضافة تخصص",
        "Specialty.Updated" => "تعديل تخصص",
        "Specialty.Deleted" => "حذف تخصص",

        "Doctor.Created" => "إضافة طبيب",
        "Doctor.Updated" => "تعديل طبيب",
        "Doctor.Deleted" => "حذف طبيب",

        "Pharmacy.Created" => "إضافة صيدلية",
        "Pharmacy.Updated" => "تعديل صيدلية",
        "Pharmacy.Deleted" => "حذف صيدلية",

        "Laboratory.Created" => "إضافة معمل تحاليل",
        "Laboratory.Updated" => "تعديل معمل تحاليل",
        "Laboratory.Deleted" => "حذف معمل تحاليل",

        "RadiologyCenter.Created" => "إضافة مركز أشعة",
        "RadiologyCenter.Updated" => "تعديل مركز أشعة",
        "RadiologyCenter.Deleted" => "حذف مركز أشعة",

        _ => action
    };

    private static string ActionClass(string action)
    {
        var value = action.ToLowerInvariant();

        if (value.Contains("success") ||
            value.Contains("approved") ||
            value.Contains("generated") ||
            value.Contains("renewed") ||
            value.Contains("completed") ||
            value.Contains("created"))
        {
            return "success";
        }

        if (value.Contains("logout") ||
            value.Contains("underreview") ||
            value.Contains("updated") ||
            value.Contains("used"))
        {
            return "warning";
        }

        if (value.Contains("fail") ||
            value.Contains("error") ||
            value.Contains("rejected") ||
            value.Contains("deleted"))
        {
            return "danger";
        }

        return "info";
    }
}
