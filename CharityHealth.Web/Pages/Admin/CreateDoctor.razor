@page "/admin/doctors/create"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator,Staff")]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using CharityHealth.Domain.Entities
@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<PageTitle>إضافة طبيب</PageTitle>

<div class="create-doctor-page" dir="rtl">

    <header class="create-doctor-head">
        <div>
            <div class="create-doctor-kicker">Doctors 👨‍⚕️</div>
            <h1>إضافة طبيب جديد</h1>
            <p>أضف بيانات الطبيب، وأيام العمل، وساعات التواجد.</p>
        </div>

        <button type="button"
                class="create-doctor-back"
                @onclick='() => Nav.NavigateTo("/admin/doctors")'>
            رجوع ←
        </button>
    </header>

    <section class="create-doctor-card">

        <div class="create-doctor-banner">
            <div class="banner-icon">🩺</div>
            <div>
                <h2>بيانات الطبيب</h2>
                <p>كلمة المرور الافتراضية لكل طبيب جديد: <strong>12345678</strong></p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMsg))
        {
            <div class="doctor-form-alert bad">@errorMsg</div>
        }

        @if (!string.IsNullOrWhiteSpace(successMsg))
        {
            <div class="doctor-form-alert ok">@successMsg</div>
        }

        @if (loading)
        {
            <div class="doctor-form-loading">جارٍ تحميل البيانات...</div>
        }
        else
        {
            <EditForm Model="@model" OnValidSubmit="SaveDoctorAsync">
                <DataAnnotationsValidator />

                <div class="doctor-form-grid">

                    <div class="doctor-field">
                        <label>اسم الطبيب عربي <span>*</span></label>
                        <InputText class="doctor-input"
                                   @bind-Value="model.FullNameAr"
                                   placeholder="د. محمد أحمد" />
                        <ValidationMessage For="@(() => model.FullNameAr)" />
                    </div>

                    <div class="doctor-field">
                        <label>اسم الطبيب إنجليزي</label>
                        <InputText class="doctor-input"
                                   @bind-Value="model.FullNameEn"
                                   placeholder="Dr. Mohamed Ahmed"
                                   dir="ltr" />
                    </div>

                    <div class="doctor-field">
                        <label>البريد الإلكتروني <span>*</span></label>
                        <InputText class="doctor-input"
                                   @bind-Value="model.Email"
                                   placeholder="doctor@email.com"
                                   dir="ltr"
                                   type="email"
                                   autocomplete="off" />
                        <ValidationMessage For="@(() => model.Email)" />
                    </div>

                    <div class="doctor-field">
                        <label>كلمة المرور</label>
                        <InputText class="doctor-input"
                                   @bind-Value="model.Password"
                                   placeholder="اتركها فارغة لاستخدام 12345678"
                                   dir="ltr"
                                   type="password"
                                   autocomplete="new-password" />
                    </div>

                    <div class="doctor-field">
                        <label>رقم الهاتف</label>
                        <InputText class="doctor-input"
                                   @bind-Value="model.PhoneNumber"
                                   placeholder="01000000000"
                                   dir="ltr"
                                   type="tel" />
                    </div>

                    <div class="doctor-field">
                        <div class="doctor-specialty-header">
                            <label>التخصص <span>*</span></label>

                            <button type="button"
                                    class="doctor-refresh-specialties"
                                    disabled="@loadingSpecialties"
                                    @onclick="LoadSpecialtiesAsync">
                                @(loadingSpecialties ? "جارٍ التحديث..." : "↻ تحديث التخصصات")
                            </button>
                        </div>
                        <InputSelect class="doctor-input"
                                     @bind-Value="model.SpecialtyId">
                            <option value="">اختر التخصص</option>
                            @foreach (var specialty in specialties)
                            {
                                <option value="@specialty.Id">@specialty.NameAr</option>
                            }
                        </InputSelect>

                        @if (specialties.Count == 0 && !loadingSpecialties)
                        {
                            <div class="doctor-specialties-empty">
                                لا توجد تخصصات مفعّلة حاليًا. أضف تخصصًا أو فعّله من صفحة التخصصات.
                            </div>
                        }

                        <ValidationMessage For="@(() => model.SpecialtyId)" />
                    </div>

                    <div class="doctor-field">
                        <label>رقم الرخصة الطبية</label>
                        <InputText class="doctor-input"
                                   @bind-Value="model.LicenseNumber"
                                   placeholder="اختياري" />
                    </div>

                    <div class="doctor-field">
                        <label>الحد الأقصى اليومي</label>
                        <InputNumber class="doctor-input"
                                     @bind-Value="model.MaxDailySlots" />
                        <ValidationMessage For="@(() => model.MaxDailySlots)" />
                    </div>

                    <div class="doctor-field">
                        <label>الحالة</label>
                        <InputSelect class="doctor-input"
                                     @bind-Value="model.IsAvailable">
                            <option value="true">متاح</option>
                            <option value="false">غير متاح</option>
                        </InputSelect>
                    </div>

                    <div class="doctor-field">
                        <label>بداية وقت العمل</label>
                        <InputText class="doctor-input"
                                   type="time"
                                   @bind-Value="model.WorkStartTime" />
                    </div>

                    <div class="doctor-field">
                        <label>نهاية وقت العمل</label>
                        <InputText class="doctor-input"
                                   type="time"
                                   @bind-Value="model.WorkEndTime" />
                    </div>

                    <div class="doctor-field doctor-field-full">
                        <label>أيام العمل</label>

                        <div class="doctor-days-grid">
                            @foreach (var day in Days)
                            {
                                <label class="doctor-day-chip">
                                    <input type="checkbox"
                                           checked="@model.WorkingDays.Contains(day.Code)"
                                           @onchange='e => ToggleDay(day.Code, e)' />
                                    <span>@day.Name</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="doctor-field doctor-field-full">
                        <label>عنوان العيادة</label>
                        <InputTextArea class="doctor-input doctor-textarea"
                                       @bind-Value="model.ClinicAddress"
                                       placeholder="عنوان العيادة أو مكان الكشف..."
                                       rows="3" />
                    </div>

                </div>

                <div class="doctor-password-note">
                    <span>🔐</span>
                    <div>
                        <strong>بيانات الدخول</strong>
                        <p>يمكنك كتابة كلمة مرور مخصصة، وإذا تركتها فارغة ستكون <b>12345678</b>.</p>
                    </div>
                </div>

                <div class="doctor-form-actions">
                    <button type="button"
                            class="doctor-secondary-btn"
                            @onclick='() => Nav.NavigateTo("/admin/doctors")'>
                        إلغاء
                    </button>

                    <button type="submit"
                            class="doctor-primary-btn"
                            disabled="@saving">
                        @(saving ? "جارٍ الحفظ..." : "إضافة الطبيب")
                    </button>
                </div>

            </EditForm>
        }
    </section>
</div>


<style>
    .doctor-specialty-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 8px;
    }

    .doctor-refresh-specialties {
        border: 1px solid #b9e8cb;
        background: #effcf4;
        color: #079447;
        border-radius: 12px;
        padding: 7px 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .doctor-refresh-specialties:disabled {
        cursor: wait;
        opacity: .65;
    }

    .doctor-specialties-empty {
        margin-top: 8px;
        padding: 10px 12px;
        border-radius: 12px;
        background: #fff8e7;
        color: #9a6700;
        font-size: 13px;
        font-weight: 700;
    }
</style>

@code {
    private const string DefaultDoctorPassword = "12345678";

    private bool loading = true;
    private bool loadingSpecialties;
    private bool saving;
    private string? errorMsg;
    private string? successMsg;

    private DoctorCreateModel model = new();
    private List<SpecialtyOption> specialties = [];

    private readonly List<DayOption> Days = new()
    {
        new("Sat", "السبت"),
        new("Sun", "الأحد"),
        new("Mon", "الاثنين"),
        new("Tue", "الثلاثاء"),
        new("Wed", "الأربعاء"),
        new("Thu", "الخميس"),
        new("Fri", "الجمعة")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadSpecialtiesAsync();
        loading = false;
    }

    private async Task LoadSpecialtiesAsync()
    {
        loadingSpecialties = true;

        try
        {
            var selectedSpecialtyId = model.SpecialtyId;

            specialties = await Db.Specialties
                .AsNoTracking()
                .Where(s => s.IsActive && !s.IsDeleted)
                .OrderBy(s => s.NameAr)
                .Select(s => new SpecialtyOption(s.Id, s.NameAr))
                .ToListAsync();

            if (selectedSpecialtyId.HasValue &&
                specialties.All(s => s.Id != selectedSpecialtyId.Value))
            {
                model.SpecialtyId = null;
            }
        }
        finally
        {
            loadingSpecialties = false;
        }
    }

    private void ToggleDay(string code, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;

        if (isChecked)
        {
            model.WorkingDays.Add(code);
        }
        else
        {
            model.WorkingDays.Remove(code);
        }
    }

    private async Task SaveDoctorAsync()
    {
        saving = true;
        errorMsg = null;
        successMsg = null;

        try
        {
            if (!model.SpecialtyId.HasValue)
            {
                errorMsg = "من فضلك اختر التخصص.";
                return;
            }

            if (model.WorkingDays.Count == 0)
            {
                errorMsg = "اختر يوم عمل واحد على الأقل.";
                return;
            }

            var email = model.Email.Trim();

            var existing = await UserManager.FindByEmailAsync(email);

            if (existing is not null)
            {
                errorMsg = "يوجد حساب مسجل بالفعل بهذا البريد الإلكتروني.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(model.Password) &&
                model.Password.Trim().Length < 8)
            {
                errorMsg = "كلمة المرور يجب ألا تقل عن 8 أحرف أو أرقام.";
                return;
            }

            var user = new ApplicationUser
            {
                UserName = email,
                Email = email,
                EmailConfirmed = true,
                PhoneNumber = string.IsNullOrWhiteSpace(model.PhoneNumber)
                    ? null
                    : model.PhoneNumber.Trim(),
                FullNameAr = model.FullNameAr.Trim(),
                FullNameEn = string.IsNullOrWhiteSpace(model.FullNameEn)
                    ? string.Empty
                    : model.FullNameEn.Trim(),
                UserType = UserType.Doctor
            };

            var selectedPassword =
                string.IsNullOrWhiteSpace(model.Password)
                    ? DefaultDoctorPassword
                    : model.Password.Trim();

            var createResult =
                await UserManager.CreateAsync(user, selectedPassword);

            if (!createResult.Succeeded)
            {
                errorMsg = string.Join(
                    " | ",
                    createResult.Errors.Select(e => e.Description)
                );

                return;
            }

            var roleResult =
                await UserManager.AddToRoleAsync(user, "Doctor");

            if (!roleResult.Succeeded)
            {
                errorMsg = "تم إنشاء الحساب ولكن فشل إضافة دور الطبيب: " +
                           string.Join(
                               " | ",
                               roleResult.Errors.Select(e => e.Description)
                           );

                return;
            }

            var fullNameClaimResult =
                await UserManager.AddClaimAsync(
                    user,
                    new Claim("FullNameAr", user.FullNameAr)
                );

            if (!fullNameClaimResult.Succeeded)
            {
                errorMsg = "فشل إضافة بيانات الطبيب للحساب: " +
                           string.Join(
                               " | ",
                               fullNameClaimResult.Errors.Select(e => e.Description)
                           );

                return;
            }

            var userTypeClaimResult =
                await UserManager.AddClaimAsync(
                    user,
                    new Claim("UserType", "Doctor")
                );

            if (!userTypeClaimResult.Succeeded)
            {
                errorMsg = "فشل تحديد نوع الحساب كطبيب: " +
                           string.Join(
                               " | ",
                               userTypeClaimResult.Errors.Select(e => e.Description)
                           );

                return;
            }

            var doctor = new Doctor
            {
                UserId = user.Id,
                SpecialtyId = model.SpecialtyId.Value,
                LicenseNumber =
                    string.IsNullOrWhiteSpace(model.LicenseNumber)
                        ? null
                        : model.LicenseNumber.Trim(),
                ClinicAddress =
                    string.IsNullOrWhiteSpace(model.ClinicAddress)
                        ? null
                        : model.ClinicAddress.Trim(),
                MaxDailySlots = model.MaxDailySlots,
                IsAvailable = model.IsAvailable,
                WorkingDays = string.Join(",", model.WorkingDays),
                WorkStartTime = ParseTime(model.WorkStartTime),
                WorkEndTime = ParseTime(model.WorkEndTime)
            };

            Db.Doctors.Add(doctor);

            await Db.SaveChangesAsync();

            successMsg =
                $"تم إضافة الطبيب بنجاح. كلمة المرور: {selectedPassword}";

            await Task.Delay(700);

            Nav.NavigateTo("/admin/doctors");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"[CREATE DOCTOR ERROR] {ex}"
            );

            errorMsg =
                "حدث خطأ أثناء إضافة الطبيب: " +
                (ex.InnerException?.Message ?? ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private static TimeOnly? ParseTime(string? value)
    {
        return TimeOnly.TryParse(value, out var time) ? time : null;
    }

    private sealed record SpecialtyOption(Guid Id, string NameAr);

    private sealed record DayOption(string Code, string Name);

    private sealed class DoctorCreateModel
    {
        [Required(ErrorMessage = "اسم الطبيب مطلوب")]
        public string FullNameAr { get; set; } = string.Empty;

        public string? FullNameEn { get; set; }

        [Required(ErrorMessage = "البريد الإلكتروني مطلوب")]
        [EmailAddress(ErrorMessage = "البريد الإلكتروني غير صحيح")]
        public string Email { get; set; } = string.Empty;

        public string? PhoneNumber { get; set; }

        public string? Password { get; set; }

        [Required(ErrorMessage = "التخصص مطلوب")]
        public Guid? SpecialtyId { get; set; }

        public string? LicenseNumber { get; set; }

        public string? ClinicAddress { get; set; }

        [Range(1, 100, ErrorMessage = "الحد اليومي يجب أن يكون من 1 إلى 100")]
        public int MaxDailySlots { get; set; } = 10;

        public bool IsAvailable { get; set; } = true;

        public string? WorkStartTime { get; set; } = "09:00";

        public string? WorkEndTime { get; set; } = "17:00";

        public HashSet<string> WorkingDays { get; set; } = new();
    }
}