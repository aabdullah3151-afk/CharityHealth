@page "/admin/doctors/{Id:guid}"
@layout MainLayout
@attribute [Authorize(Roles="Administrator,Staff")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CharityHealth.Domain.Entities
@using CharityHealth.Infrastructure.Persistence
@using CharityHealth.Web.Shared
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
<PageTitle>ملف الطبيب</PageTitle><link href="/css/admin-medical-profiles.css" rel="stylesheet" />
<div class="ch-page"><button class="ch-btn gray" @onclick='() => Nav.NavigateTo("/admin/doctors")'>← العودة للأطباء</button>
@if(loading){<div class="ch-empty">جارٍ تحميل ملف الطبيب...</div>}else if(doctor is null){<div class="ch-empty">الطبيب غير موجود.</div>}else{
<section class="ch-hero"><div class="ch-icon">👨‍⚕️</div><div class="title"><span>Doctor Profile</span><h1>@Show(doctor.User.FullNameAr)</h1><strong>@Show(doctor.Specialty?.NameAr,"التخصص غير مسجل")</strong></div><div class="badge">@(doctor.IsAvailable?"متاح":"غير متاح")</div></section>
<section class="ch-summary"><div><strong>@requests.Count</strong><span>إجمالي الحالات</span></div><div><strong>@Count("Approved")</strong><span>مقبولة</span></div><div><strong>@Count("Completed")</strong><span>مكتملة</span></div><div><strong>@OpenCount</strong><span>متبقية</span></div></section>
<section class="ch-section"><h2>بيانات الطبيب</h2><div class="ch-info"><Field L="الاسم بالعربية" V="@Show(doctor.User.FullNameAr)"/><Field L="الاسم بالإنجليزية" V="@Show(doctor.User.FullNameEn)"/><Field L="الهاتف" V="@Show(doctor.User.PhoneNumber)"/><Field L="البريد" V="@Show(doctor.User.Email)"/><Field L="رقم الترخيص" V="@Show(doctor.LicenseNumber)"/><Field L="هاتف العيادة" V="@Show(doctor.ClinicPhone)"/><Field L="عنوان العيادة" V="@Show(doctor.ClinicAddress)"/><Field L="أيام العمل" V="@Show(doctor.WorkingDays)"/><Field L="الحد اليومي" V="@doctor.MaxDailySlots.ToString()"/></div></section>
<section class="ch-section"><h2>سجل الحالات والاستشارات</h2>@if(requests.Count==0){<div class="ch-empty">لا توجد حالات.</div>}else{<div class="ch-table"><table><thead><tr><th>رقم الطلب</th><th>المريض</th><th>التاريخ</th><th>الخدمة</th><th>الحالة</th><th></th></tr></thead><tbody>@foreach(var r in requests){<tr><td>#@r.Id.ToString()[..8]</td><td>@Patient(r.BeneficiaryId)</td><td>@Date(r)</td><td>@Service(r.ServiceType.ToString())</td><td><span class="ch-pill">@Status(r.Status.ToString())</span></td><td><button class="ch-btn soft" @onclick='() => Nav.NavigateTo($"/admin/requests/{r.Id}")'>التفاصيل</button></td></tr>}</tbody></table></div>}</section>}
</div>
@code{[Parameter]public Guid Id{get;set;}private bool loading=true;private Doctor? doctor;private List<MedicalRequest> requests=[];private Dictionary<Guid,string> names=[];protected override async Task OnParametersSetAsync(){await using var db=await DbFactory.CreateDbContextAsync();doctor=await db.Doctors.AsNoTracking().Include(x=>x.User).Include(x=>x.Specialty).FirstOrDefaultAsync(x=>x.Id==Id&&!x.IsDeleted);if(doctor is not null){requests=await db.MedicalRequests.AsNoTracking().Where(x=>x.DoctorId==Id||x.AssignedProviderUserId==doctor.UserId).OrderByDescending(x=>x.CreatedAt).ToListAsync();await LoadNames(db);}loading=false;}private async Task LoadNames(AppDbContext db){var ids=requests.Select(x=>x.BeneficiaryId).Distinct().ToList();if(ids.Count==0)return;var bs=await db.Beneficiaries.AsNoTracking().Where(x=>ids.Contains(x.Id)).ToListAsync();var map=new Dictionary<Guid,string>();var uids=new HashSet<string>();foreach(var b in bs){var n=Text(b,"FullNameAr","NameAr","FullName");if(!string.IsNullOrWhiteSpace(n))names[b.Id]=n;var uid=Text(b,"UserId","ApplicationUserId");if(!string.IsNullOrWhiteSpace(uid)){map[b.Id]=uid;uids.Add(uid);}}if(uids.Count>0){var us=await db.Users.AsNoTracking().Where(x=>uids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id);foreach(var m in map)if(us.TryGetValue(m.Value,out var u))names[m.Key]=Show(u.FullNameAr,u.FullNameEn);}}private int Count(string s)=>requests.Count(x=>x.Status.ToString()==s);private int OpenCount=>requests.Count-Count("Completed");private string Patient(Guid id)=>names.TryGetValue(id,out var n)?n:$"مستفيد #{id.ToString()[..8]}";private static string Date(MedicalRequest r)=>r.AppointmentDate?.ToString("yyyy/MM/dd")??r.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd");private static string Status(string s)=>s switch{"Submitted"=>"مرسل","UnderReview"=>"قيد المراجعة","Approved"=>"مقبول","Completed"=>"مكتمل","Rejected"=>"مرفوض",_=>s};private static string Service(string s)=>s switch{"MedicalConsultation"=>"كشف طبي","Pharmacy"=>"صرف دواء","Laboratory"=>"تحاليل","Radiology"=>"أشعة",_=>s};private static string Text(object? o,params string[] ps){if(o is null)return"";foreach(var p in ps){var v=o.GetType().GetProperty(p)?.GetValue(o);var t=Convert.ToString(v);if(!string.IsNullOrWhiteSpace(t))return t;}return"";}private static string Show(string? v,string f="غير مسجل")=>string.IsNullOrWhiteSpace(v)?f:v;}
