@page "/admin/doctors"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator,Staff")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using CharityHealth.Domain.Entities
@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence
@using CharityHealth.Web.Services
@using CharityHealth.Web.Components.Partners

@inject HealthcareUiService Ui
@inject AppDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<PageTitle>إدارة الأطباء</PageTitle>
<link href="/css/admin-medical-profiles.css" rel="stylesheet" />

<div class="doctors-page" dir="rtl">

    <header class="doctors-head">
        <div>
            <div class="doctors-kicker">Doctors 👨‍⚕️</div>
            <h1>الأطباء المتطوعون</h1>
            <p>قائمة الأطباء المتعاونين مع المؤسسة، مع إمكانية تعديل البيانات أو حذف الطبيب من النظام.</p>
        </div>

        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
            <label style="display:inline-flex;align-items:center;gap:8px;color:#475467;font-size:13px;font-weight:900;">
                <input type="checkbox" @bind="showUnavailable" style="width:16px;height:16px;accent-color:#05a843;" />
                عرض غير المتاحين
            </label>

            <button type="button"
                    class="doctor-add-btn"
                    @onclick='() => Nav.NavigateTo("/admin/doctors/create")'>
                <span>+</span>
                إضافة طبيب
            </button>
        </div>
    </header>

    <section class="admin-doctor-filterbar">

        <div class="ch-search doctor-live-search">

            <span>⌕</span>

            <input type="search"
                   placeholder="بحث ذكي: الاسم، التخصص، الهاتف، الترخيص أو العنوان..."
                   @bind="searchText"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(searchText))
            {
                <button type="button"
                        @onclick='() => searchText = string.Empty'>
                    مسح
                </button>
            }

        </div>


        <div class="admin-doctor-specialty">

            <label>التخصص</label>

            <select @bind="selectedSpecialty">

                <option value="">
                    كل التخصصات
                </option>

                @foreach (var specialty in DoctorSpecialties)
                {
                    <option value="@specialty">
                        @specialty
                    </option>
                }

            </select>

        </div>


        <div class="admin-doctor-result-count">

            <strong>
                @FilteredDoctors.Count()
            </strong>

            <span>طبيب</span>

        </div>

    </section>

    @if (!string.IsNullOrWhiteSpace(actionMessage))
    {
        <div style="
            margin-bottom:18px;
            border-radius:18px;
            padding:16px 18px;
            border:1px solid @(actionSucceeded ? "#bbf7d0" : "#fecaca");
            background:@(actionSucceeded ? "#f0fdf4" : "#fef2f2");
            color:@(actionSucceeded ? "#15803d" : "#b91c1c");
            font-size:14px;
            font-weight:950;">
            @actionMessage
        </div>
    }

    @if (deleteCandidate is not null)
    {
        <section style="
            margin-bottom:24px;
            border:1px solid #fecaca;
            border-radius:24px;
            background:#fff7f7;
            padding:20px 22px;
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:18px;
            flex-wrap:wrap;">

            <div>
                <strong style="display:block;color:#991b1b;font-size:18px;font-weight:950;">تأكيد حذف الطبيب</strong>

                <span style="display:block;margin-top:6px;color:#7f1d1d;font-size:14px;font-weight:850;">
                    هل تريد حذف الطبيب: @deleteCandidate.FullNameAr ؟
                </span>

                <small style="display:block;margin-top:8px;color:#b91c1c;font-size:12px;font-weight:900;">
                    سيتم إخفاء الطبيب من القائمة وتعطيل حسابه لمنع تسجيل الدخول.
                </small>
            </div>

            <div style="display:inline-flex;align-items:center;gap:10px;">
                <button type="button"
                        @onclick="CancelDelete"
                        disabled="@deleting"
                        style="height:42px;border:0;border-radius:999px;padding:0 18px;background:#ffffff;color:#475467;font-size:13px;font-weight:950;cursor:pointer;">
                    إلغاء
                </button>

                <button type="button"
                        @onclick="DeleteDoctorAsync"
                        disabled="@deleting"
                        style="height:42px;border:0;border-radius:999px;padding:0 18px;background:#dc2626;color:#ffffff;font-size:13px;font-weight:950;cursor:pointer;">
                    @(deleting ? "جارٍ الحذف..." : "حذف الطبيب")
                </button>
            </div>
        </section>
    }

    @if (loading)
    {
        <div class="doctors-empty">جارٍ تحميل الأطباء...</div>
    }
    else if (!FilteredDoctors.Any())
    {
        <div class="doctors-empty">لا يوجد أطباء مسجلون حالياً</div>
    }
    else
    {
        <section class="doctors-grid">
            @foreach (var doctor in FilteredDoctors)
            {
                var stats = GetDoctorStats(doctor);

                <article class="doctor-card">

                    <div class="doctor-card-top">
                        <div class="doctor-main-info">
                            <h2>@doctor.FullNameAr</h2>
                            <strong>@doctor.SpecialtyName</strong>
                        </div>

                        <div class="doctor-icon">🩺</div>
                    </div>

                    <div class="doctor-status-row">
                        <span class="doctor-status @(doctor.IsAvailable ? "available" : "unavailable")">
                            <i></i>
                            @(doctor.IsAvailable ? "متاح" : "غير متاح")
                        </span>

                        <span class="doctor-license">
                            ترخيص: @doctor.LicenseNumber
                        </span>
                    </div>

                    <div class="doctor-meta">
                        <div>
                            <span>الهاتف</span>
                            <strong>@doctor.PhoneNumber</strong>
                        </div>

                        <div>
                            <span>الحد اليومي</span>
                            <strong>@doctor.MaxDailySlots</strong>
                        </div>
                    </div>

                    <div class="doctor-schedule">
                        <div>
                            <span>أيام العمل</span>
                            <strong>@FormatWorkingDays(doctor.WorkingDays)</strong>
                        </div>

                        <div>
                            <span>وقت العمل</span>
                            <strong>@FormatWorkingTime(doctor.WorkStartTime, doctor.WorkEndTime)</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(doctor.ClinicAddress))
                    {
                        <div class="doctor-address">
                            📍 @doctor.ClinicAddress
                        </div>
                    }

                    
                    @* MANUAL_CAPACITY_DOCTOR *@
                    <ManualCapacitySummary
                        ProviderUserId="@doctor.UserId"
                        DoctorId="@doctor.Id"
                        ServiceType="@ServiceRequestType.MedicalConsultation"
                        Capacity="@doctor.MaxDailySlots" />

                    <div class="doctor-stats">
                        <div>
                            <strong>@stats.Pending</strong>
                            <span>طلبات معلقة</span>
                        </div>

                        <div>
                            <strong>@stats.Approved</strong>
                            <span>محجوزة</span>
                        </div>

                        <div>
                            <strong>@stats.Completed</strong>
                            <span>مكتملة</span>
                        </div>
                    </div>

                    <div class="doctor-card-actions" style="display:flex;gap:10px;flex-wrap:wrap;">
                        <button type="button" class="doctor-edit-btn" @onclick='() => Nav.NavigateTo($"/admin/doctors/{doctor.Id}")' style="background:#ecfdf3 !important;color:#027a48 !important;">عرض الملف الكامل</button>
                        <button type="button"
                                class="doctor-edit-btn"
                                @onclick='() => Nav.NavigateTo($"/admin/doctors/edit/{doctor.Id}")'>
                            تعديل البيانات
                        </button>

                        <button type="button"
                                class="doctor-edit-btn"
                                @onclick='() => AskDelete(doctor)'
                                style="background:#fef2f2 !important;color:#dc2626 !important;">
                            حذف الطبيب
                        </button>
                    </div>

                </article>
            }
        </section>
    }
</div>

@code {
    private bool loading = true;
    private bool deleting;
    private bool showUnavailable;
    private string searchText = string.Empty;
    private string selectedSpecialty = string.Empty;
    private bool actionSucceeded;
    private string? actionMessage;

    private DoctorListItem? deleteCandidate;

    private List<DoctorListItem> doctors = [];
    private List<RequestWorkItem> requests = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;

        doctors = await Ui.GetDoctorsAsync();
        requests = await Ui.GetRequestsAsync();

        loading = false;
    }

    private IEnumerable<string> DoctorSpecialties =>
        doctors
            .Select(d => d.SpecialtyName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x);


    private IEnumerable<DoctorListItem> FilteredDoctors
    {
        get
        {
            IEnumerable<DoctorListItem> result =
                showUnavailable
                    ? doctors
                    : doctors.Where(d => d.IsAvailable);


            // فلتر التخصص
            if (!string.IsNullOrWhiteSpace(selectedSpecialty))
            {
                result = result.Where(d =>
                    string.Equals(
                        d.SpecialtyName,
                        selectedSpecialty,
                        StringComparison.OrdinalIgnoreCase));
            }


            // البحث الذكي
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                result = result.Where(d =>
                    SmartMatches(
                        searchText,
                        d.FullNameAr,
                        d.SpecialtyName,
                        d.PhoneNumber,
                        d.LicenseNumber,
                        d.ClinicAddress));
            }


            return result;
        }
    }


    private static string NormalizeSearch(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var text = value.Trim().ToLowerInvariant()
            .Replace('أ', 'ا')
            .Replace('إ', 'ا')
            .Replace('آ', 'ا')
            .Replace('ٱ', 'ا')
            .Replace('ى', 'ي')
            .Replace('ة', 'ه')
            .Replace('ؤ', 'و')
            .Replace('ئ', 'ي');

        var buffer = new System.Text.StringBuilder(text.Length);

        foreach (var ch in text)
        {
            var category =
                System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch);

            if (category ==
                System.Globalization.UnicodeCategory.NonSpacingMark)
                continue;

            buffer.Append(char.IsLetterOrDigit(ch) ? ch : ' ');
        }

        return string.Join(" ",
            buffer.ToString().Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries));
    }

    private static bool SmartMatches(
        string? query,
        params string?[] values)
    {
        var q = NormalizeSearch(query);

        if (string.IsNullOrWhiteSpace(q))
            return true;

        var haystack = NormalizeSearch(
            string.Join(" ",
                values.Where(v => !string.IsNullOrWhiteSpace(v))));

        var ignored = new HashSet<string>(
            StringComparer.OrdinalIgnoreCase)
        {
            "د",
            "دكتور",
            "دكتوره",
            "طبيب",
            "الطبيب"
        };

        var words = q
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries)
            .Where(x => !ignored.Contains(x))
            .ToArray();

        if (words.Length == 0)
            return true;

        // مثال: "احمد نساء"
        // يمكن أن تكون "احمد" في الاسم و"نساء" في التخصص.
        if (words.All(word =>
            haystack.Contains(
                word,
                StringComparison.OrdinalIgnoreCase)))
            return true;

        // يسمح أيضًا بالبحث مع اختلاف المسافات:
        // "عبدالرحيم" = "عبد الرحيم"
        var compactQuery = string.Concat(words);
        var compactData = haystack.Replace(" ", string.Empty);

        return compactData.Contains(
            compactQuery,
            StringComparison.OrdinalIgnoreCase);
    }

    private void AskDelete(DoctorListItem doctor)
    {
        actionMessage = null;
        deleteCandidate = doctor;
    }

    private void CancelDelete()
    {
        deleteCandidate = null;
    }

    private async Task DeleteDoctorAsync()
    {
        if (deleting || deleteCandidate is null)
        {
            return;
        }

        deleting = true;
        actionMessage = null;

        try
        {
            var doctor = await Db.Doctors
                .Include(d => d.User)
                .FirstOrDefaultAsync(d => d.Id == deleteCandidate.Id);

            if (doctor is null)
            {
                actionSucceeded = false;
                actionMessage = "الطبيب غير موجود أو تم حذفه بالفعل.";
                return;
            }

            doctor.IsAvailable = false;
            doctor.IsDeleted = true;
            doctor.UpdatedAt = DateTime.UtcNow;

            doctor.User.IsActive = false;
            doctor.User.EmailConfirmed = false;
            doctor.User.LockoutEnabled = true;
            doctor.User.LockoutEnd = DateTimeOffset.UtcNow.AddYears(100);
            doctor.User.UpdatedAt = DateTime.UtcNow;

            var userUpdate = await UserManager.UpdateAsync(doctor.User);

            if (!userUpdate.Succeeded)
            {
                actionSucceeded = false;
                actionMessage = string.Join(" | ", userUpdate.Errors.Select(e => e.Description));
                return;
            }

            await Db.SaveChangesAsync();

            actionSucceeded = true;
            actionMessage = "تم حذف الطبيب من القائمة وتعطيل حساب الدخول الخاص به.";
            deleteCandidate = null;

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            actionSucceeded = false;
            actionMessage = $"حدث خطأ أثناء حذف الطبيب: {ex.Message}";
        }
        finally
        {
            deleting = false;
        }
    }

    private DoctorStats GetDoctorStats(DoctorListItem doctor)
    {
        var related = requests
            .Where(r => r.SpecialtyName == doctor.SpecialtyName)
            .ToList();

        return new DoctorStats(
            Pending: related.Count(r => r.Status is RequestStatus.Submitted or RequestStatus.UnderReview),
            Approved: related.Count(r => r.Status == RequestStatus.Approved),
            Completed: related.Count(r => r.Status == RequestStatus.Completed)
        );
    }

    private static string FormatWorkingTime(TimeOnly? start, TimeOnly? end)
    {
        if (start is null && end is null)
        {
            return "غير محدد";
        }

        if (start is not null && end is not null)
        {
            return $"{start:HH\\:mm} - {end:HH\\:mm}";
        }

        if (start is not null)
        {
            return $"من {start:HH\\:mm}";
        }

        return $"حتى {end:HH\\:mm}";
    }

    private static string FormatWorkingDays(string? days)
    {
        if (string.IsNullOrWhiteSpace(days))
        {
            return "غير محدد";
        }

        var map = new Dictionary<string, string>
        {
            ["Sat"] = "السبت",
            ["Sun"] = "الأحد",
            ["Mon"] = "الاثنين",
            ["Tue"] = "الثلاثاء",
            ["Wed"] = "الأربعاء",
            ["Thu"] = "الخميس",
            ["Fri"] = "الجمعة"
        };

        var result = days
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(d => map.TryGetValue(d, out var ar) ? ar : d)
            .ToList();

        return result.Count == 0 ? "غير محدد" : string.Join("، ", result);
    }

    private sealed record DoctorStats(
        int Pending,
        int Approved,
        int Completed
    );
}


<style>

/* SMART_SPECIALTY_FILTER_ADMIN */

.admin-doctor-filterbar {

    display: grid;

    grid-template-columns:
        minmax(300px, 1fr)
        minmax(220px, 280px)
        auto;

    gap: 12px;

    align-items: stretch;

    margin-bottom: 20px;
}


.admin-doctor-filterbar
.doctor-live-search {

    margin: 0;
}


.admin-doctor-specialty,
.admin-doctor-result-count {

    min-height: 54px;

    border: 1px solid #e4e7ec;
    border-radius: 16px;

    background: #ffffff;
}


.admin-doctor-specialty {

    display: flex;
    align-items: center;

    gap: 10px;

    padding: 0 14px;
}


.admin-doctor-specialty label {

    color: #667085;

    font-size: 13px;
    font-weight: 950;

    white-space: nowrap;
}


.admin-doctor-specialty select {

    flex: 1;

    min-width: 0;

    border: 0;
    outline: 0;

    background: transparent;

    color: #101828;

    font-family: inherit;
    font-weight: 900;

    cursor: pointer;
}


.admin-doctor-result-count {

    min-width: 105px;

    display: flex;

    align-items: center;
    justify-content: center;

    gap: 6px;

    padding: 0 14px;

    color: #667085;
    font-weight: 850;
}


.admin-doctor-result-count strong {

    color: #059669;
    font-size: 20px;
}


@@media (max-width: 850px) {

    .admin-doctor-filterbar {

        grid-template-columns: 1fr;
    }

}

</style>
