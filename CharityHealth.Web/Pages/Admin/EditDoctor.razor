@page "/admin/doctors/edit/{DoctorId:guid}"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator,Staff")]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using CharityHealth.Domain.Entities
@using CharityHealth.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<PageTitle>تعديل طبيب</PageTitle>

<div class="create-doctor-page" dir="rtl">

    <header class="create-doctor-head">
        <div>
            <div class="create-doctor-kicker">Doctors ✏️</div>
            <h1>تعديل بيانات الطبيب</h1>
            <p>تعديل الإيميل، كلمة المرور، أيام العمل، وساعات التواجد.</p>
        </div>

        <button type="button"
                class="create-doctor-back"
                @onclick='() => Nav.NavigateTo("/admin/doctors")'>
            رجوع ←
        </button>
    </header>

    <section class="create-doctor-card">

        <div class="create-doctor-banner">
            <div class="banner-icon">🩺</div>
            <div>
                <h2>تعديل الطبيب</h2>
                <p>اترك كلمة المرور فارغة إذا لم ترغب في تغييرها.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMsg))
        {
            <div class="doctor-form-alert bad">@errorMsg</div>
        }

        @if (!string.IsNullOrWhiteSpace(successMsg))
        {
            <div class="doctor-form-alert ok">@successMsg</div>
        }

        @if (loading)
        {
            <div class="doctor-form-loading">جارٍ تحميل بيانات الطبيب...</div>
        }
        else
        {
            <EditForm Model="@model" OnValidSubmit="SaveChangesAsync">
                <DataAnnotationsValidator />

                <div class="doctor-form-grid">

                    <div class="doctor-field">
                        <label>اسم الطبيب عربي <span>*</span></label>
                        <InputText class="doctor-input" @bind-Value="model.FullNameAr" />
                        <ValidationMessage For="@(() => model.FullNameAr)" />
                    </div>

                    <div class="doctor-field">
                        <label>اسم الطبيب إنجليزي</label>
                        <InputText class="doctor-input" @bind-Value="model.FullNameEn" dir="ltr" />
                    </div>

                    <div class="doctor-field">
                        <label>البريد الإلكتروني <span>*</span></label>
                        <InputText class="doctor-input" @bind-Value="model.Email" dir="ltr" type="email" />
                        <ValidationMessage For="@(() => model.Email)" />
                    </div>

                    <div class="doctor-field">
                        <label>كلمة مرور جديدة</label>
                        <InputText class="doctor-input"
                                   @bind-Value="model.NewPassword"
                                   placeholder="اتركها فارغة بدون تغيير"
                                   dir="ltr"
                                   type="password" />
                    </div>

                    <div class="doctor-field">
                        <label>رقم الهاتف</label>
                        <InputText class="doctor-input" @bind-Value="model.PhoneNumber" dir="ltr" />
                    </div>

                    <div class="doctor-field">
                        <label>التخصص <span>*</span></label>
                        <InputSelect class="doctor-input" @bind-Value="model.SpecialtyId">
                            <option value="">اختر التخصص</option>
                            @foreach (var specialty in specialties)
                            {
                                <option value="@specialty.Id">@specialty.NameAr</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="doctor-field">
                        <label>رقم الرخصة الطبية</label>
                        <InputText class="doctor-input" @bind-Value="model.LicenseNumber" placeholder="اختياري" />
                    </div>

                    <div class="doctor-field">
                        <label>الحد الأقصى اليومي</label>
                        <InputNumber class="doctor-input" @bind-Value="model.MaxDailySlots" />
                    </div>

                    <div class="doctor-field">
                        <label>الحالة</label>
                        <InputSelect class="doctor-input" @bind-Value="model.IsAvailable">
                            <option value="true">متاح</option>
                            <option value="false">غير متاح</option>
                        </InputSelect>
                    </div>

                    <div class="doctor-field">
                        <label>بداية وقت العمل</label>
                        <InputText class="doctor-input"
                                   type="time"
                                   @bind-Value="model.WorkStartTime" />
                    </div>

                    <div class="doctor-field">
                        <label>نهاية وقت العمل</label>
                        <InputText class="doctor-input"
                                   type="time"
                                   @bind-Value="model.WorkEndTime" />
                    </div>

                    <div class="doctor-field doctor-field-full">
                        <label>أيام العمل</label>

                        <div class="doctor-days-grid">
                            @foreach (var day in Days)
                            {
                                <label class="doctor-day-chip">
                                    <input type="checkbox"
                                           checked="@model.WorkingDays.Contains(day.Code)"
                                           @onchange='e => ToggleDay(day.Code, e)' />
                                    <span>@day.Name</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="doctor-field doctor-field-full">
                        <label>عنوان العيادة</label>
                        <InputTextArea class="doctor-input doctor-textarea"
                                       @bind-Value="model.ClinicAddress"
                                       rows="3" />
                    </div>
                </div>

                <div class="doctor-password-note">
                    <span>🔐</span>
                    <div>
                        <strong>تعديل كلمة المرور</strong>
                        <p>لو كتبت كلمة مرور جديدة سيتم تغييرها. لو سبتها فاضية هتفضل القديمة كما هي.</p>
                    </div>
                </div>

                <div class="doctor-form-actions">
                    <button type="button"
                            class="doctor-secondary-btn"
                            @onclick='() => Nav.NavigateTo("/admin/doctors")'>
                        إلغاء
                    </button>

                    <button type="submit"
                            class="doctor-primary-btn"
                            disabled="@saving">
                        @(saving ? "جارٍ الحفظ..." : "حفظ التعديلات")
                    </button>
                </div>
            </EditForm>
        }
    </section>
</div>

@code {
    [Parameter] public Guid DoctorId { get; set; }

    private bool loading = true;
    private bool saving;
    private string? errorMsg;
    private string? successMsg;

    private Doctor? doctor;
    private DoctorEditModel model = new();
    private List<SpecialtyOption> specialties = [];

    private readonly List<DayOption> Days = new()
    {
        new("Sat", "السبت"),
        new("Sun", "الأحد"),
        new("Mon", "الاثنين"),
        new("Tue", "الثلاثاء"),
        new("Wed", "الأربعاء"),
        new("Thu", "الخميس"),
        new("Fri", "الجمعة")
    };

    protected override async Task OnInitializedAsync()
    {
        specialties = await Db.Specialties
            .AsNoTracking()
            .Where(s => s.IsActive)
            .OrderBy(s => s.NameAr)
            .Select(s => new SpecialtyOption(s.Id, s.NameAr))
            .ToListAsync();

        doctor = await Db.Doctors
            .Include(d => d.User)
            .FirstOrDefaultAsync(d => d.Id == DoctorId);

        if (doctor is null)
        {
            errorMsg = "الطبيب غير موجود.";
            loading = false;
            return;
        }

        model = new DoctorEditModel
        {
            FullNameAr = doctor.User.FullNameAr,
            FullNameEn = doctor.User.FullNameEn,
            Email = doctor.User.Email ?? string.Empty,
            PhoneNumber = doctor.User.PhoneNumber,
            SpecialtyId = doctor.SpecialtyId,
            LicenseNumber = IsPlaceholderLicense(doctor.LicenseNumber) ? null : doctor.LicenseNumber,
            ClinicAddress = doctor.ClinicAddress,
            MaxDailySlots = doctor.MaxDailySlots,
            IsAvailable = doctor.IsAvailable,
            WorkStartTime = doctor.WorkStartTime?.ToString("HH:mm") ?? "09:00",
            WorkEndTime = doctor.WorkEndTime?.ToString("HH:mm") ?? "17:00",
            WorkingDays = ParseDays(doctor.WorkingDays)
        };

        loading = false;
    }

    private void ToggleDay(string code, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;

        if (isChecked)
        {
            model.WorkingDays.Add(code);
        }
        else
        {
            model.WorkingDays.Remove(code);
        }
    }

    private async Task SaveChangesAsync()
    {
        if (doctor is null)
        {
            return;
        }

        saving = true;
        errorMsg = null;
        successMsg = null;

        try
        {
            if (model.WorkingDays.Count == 0)
            {
                errorMsg = "اختر يوم عمل واحد على الأقل.";
                return;
            }

            var email = model.Email.Trim();

            if (!string.Equals(doctor.User.Email, email, StringComparison.OrdinalIgnoreCase))
            {
                var existing = await UserManager.FindByEmailAsync(email);

                if (existing is not null && existing.Id != doctor.UserId)
                {
                    errorMsg = "يوجد حساب آخر بنفس البريد الإلكتروني.";
                    return;
                }

                var emailResult = await UserManager.SetEmailAsync(doctor.User, email);
                if (!emailResult.Succeeded)
                {
                    errorMsg = string.Join(" | ", emailResult.Errors.Select(e => e.Description));
                    return;
                }

                var userNameResult = await UserManager.SetUserNameAsync(doctor.User, email);
                if (!userNameResult.Succeeded)
                {
                    errorMsg = string.Join(" | ", userNameResult.Errors.Select(e => e.Description));
                    return;
                }

                doctor.User.EmailConfirmed = true;
            }

            doctor.User.FullNameAr = model.FullNameAr.Trim();
            doctor.User.FullNameEn = string.IsNullOrWhiteSpace(model.FullNameEn) ? string.Empty : model.FullNameEn.Trim();
            doctor.User.PhoneNumber = string.IsNullOrWhiteSpace(model.PhoneNumber) ? null : model.PhoneNumber.Trim();

            var updateUserResult = await UserManager.UpdateAsync(doctor.User);
            if (!updateUserResult.Succeeded)
            {
                errorMsg = string.Join(" | ", updateUserResult.Errors.Select(e => e.Description));
                return;
            }

            if (!string.IsNullOrWhiteSpace(model.NewPassword))
            {
                if (model.NewPassword.Length < 8)
                {
                    errorMsg = "كلمة المرور الجديدة يجب ألا تقل عن 8 أرقام أو أحرف.";
                    return;
                }

                var token = await UserManager.GeneratePasswordResetTokenAsync(doctor.User);
                var passwordResult = await UserManager.ResetPasswordAsync(doctor.User, token, model.NewPassword);

                if (!passwordResult.Succeeded)
                {
                    errorMsg = string.Join(" | ", passwordResult.Errors.Select(e => e.Description));
                    return;
                }
            }

            var claims = await UserManager.GetClaimsAsync(doctor.User);
            var oldClaims = claims
                .Where(c => c.Type is "FullNameAr" or "UserType")
                .ToList();

            foreach (var claim in oldClaims)
            {
                await UserManager.RemoveClaimAsync(doctor.User, claim);
            }

            await UserManager.AddClaimAsync(doctor.User, new Claim("FullNameAr", doctor.User.FullNameAr));
            await UserManager.AddClaimAsync(doctor.User, new Claim("UserType", "Doctor"));

            doctor.SpecialtyId = model.SpecialtyId!.Value;
            doctor.LicenseNumber = string.IsNullOrWhiteSpace(model.LicenseNumber)
                ? null
                : model.LicenseNumber.Trim();
            doctor.ClinicAddress = string.IsNullOrWhiteSpace(model.ClinicAddress) ? null : model.ClinicAddress.Trim();
            doctor.MaxDailySlots = model.MaxDailySlots;
            doctor.IsAvailable = model.IsAvailable;
            doctor.WorkingDays = string.Join(",", model.WorkingDays);
            doctor.WorkStartTime = ParseTime(model.WorkStartTime);
            doctor.WorkEndTime = ParseTime(model.WorkEndTime);

            await Db.SaveChangesAsync();

            successMsg = "تم حفظ تعديلات الطبيب بنجاح.";
        }
        finally
        {
            saving = false;
        }
    }

    private static bool IsPlaceholderLicense(string? licenseNumber)
        => string.IsNullOrWhiteSpace(licenseNumber) || licenseNumber.StartsWith("غير محدد", StringComparison.Ordinal);

    private static TimeOnly? ParseTime(string? value)
    {
        return TimeOnly.TryParse(value, out var time) ? time : null;
    }

    private static HashSet<string> ParseDays(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return new HashSet<string>();
        }

        return value
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToHashSet();
    }

    private sealed record SpecialtyOption(Guid Id, string NameAr);

    private sealed record DayOption(string Code, string Name);

    private sealed class DoctorEditModel
    {
        [Required(ErrorMessage = "اسم الطبيب مطلوب")]
        public string FullNameAr { get; set; } = string.Empty;

        public string? FullNameEn { get; set; }

        [Required(ErrorMessage = "البريد الإلكتروني مطلوب")]
        [EmailAddress(ErrorMessage = "البريد الإلكتروني غير صحيح")]
        public string Email { get; set; } = string.Empty;

        public string? NewPassword { get; set; }

        public string? PhoneNumber { get; set; }

        [Required(ErrorMessage = "التخصص مطلوب")]
        public Guid? SpecialtyId { get; set; }

        public string? LicenseNumber { get; set; }

        public string? ClinicAddress { get; set; }

        [Range(1, 100, ErrorMessage = "الحد اليومي يجب أن يكون من 1 إلى 100")]
        public int MaxDailySlots { get; set; } = 10;

        public bool IsAvailable { get; set; } = true;

        public string? WorkStartTime { get; set; }

        public string? WorkEndTime { get; set; }

        public HashSet<string> WorkingDays { get; set; } = new();
    }
}