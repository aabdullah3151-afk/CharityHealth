@page "/admin/operations"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator,Staff")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CharityHealth.Domain.Entities
@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence

@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>لوحة التشغيل الأسبوعية</PageTitle>

<div class="existing-report-date"
     dir="rtl"
     style="margin:0 0 16px;padding:12px 16px;border:1px solid #bbf7d0;border-radius:16px;background:#ecfdf3;color:#047857;font-size:13px;font-weight:950;">
    تاريخ التقرير: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
</div>


<div class="ops-page" dir="rtl">
    <header class="ops-hero">
        <div>
            <span class="ops-kicker">لوحة التشغيل اليومية والأسبوعية</span>
            <h1>التغطية والسعة المتاحة</h1>
            <p>متابعة الأطباء والجهات الطبية حسب أيام العمل والطلبات المعتمدة.</p>
        </div>
        <div class="ops-actions">
            <button class="ops-btn secondary" @onclick="OpenPrintPreview">معاينة الطباعة</button>
            <button class="ops-btn primary" @onclick="OpenPrintPreview">تصدير PDF</button>
        </div>
    </header>

    @if (loading)
    {
        <div class="ops-loading">جارٍ تحميل بيانات التشغيل...</div>
    }
    else
    {
        <section class="ops-summary-grid">
            <article><span>الأطباء المتاحون اليوم</span><strong>@TodayAvailableDoctors</strong></article>
            <article><span>الأطباء المكتملون اليوم</span><strong>@TodayFullDoctors</strong></article>
            <article><span>المعامل العاملة اليوم</span><strong>@TodayWorkingLabs</strong></article>
            <article><span>مراكز الأشعة العاملة اليوم</span><strong>@TodayWorkingRadiology</strong></article>
            <article><span>الصيدليات العاملة اليوم</span><strong>@TodayWorkingPharmacies</strong></article>
            <article><span>الطلبات المعتمدة هذا الأسبوع</span><strong>@weekRequests.Count</strong></article>
        </section>

        <section class="ops-toolbar">
            <div class="ops-tabs">
                @foreach (var option in categories)
                {
                    <button class="@(selectedCategory == option.Value ? "active" : null)" @onclick="() => SelectCategory(option.Value)">
                        <span>@option.Icon</span>@option.Label
                    </button>
                }
            </div>

            <div class="ops-view-switch">
                <button class="@(weekView ? "active" : null)" @onclick="() => weekView = true">الأسبوع كامل</button>
                <button class="@(!weekView ? "active" : null)" @onclick="() => weekView = false">يوم واحد</button>
            </div>
        </section>

        @if (selectedCategory == Category.Doctors)
        {
            <section class="ops-specialty-filter">
                <button class="@(selectedSpecialtyId is null ? "active" : null)" @onclick="() => selectedSpecialtyId = null">كل التخصصات</button>
                @foreach (var specialty in specialties)
                {
                    <button class="@(selectedSpecialtyId == specialty.Id ? "active" : null)" @onclick="() => selectedSpecialtyId = specialty.Id">@specialty.NameAr</button>
                }
            </section>
        }

        @if (!weekView)
        {
            <section class="ops-day-picker">
                @foreach (var day in week)
                {
                    <button class="@(selectedDate == day ? "active" : null)" @onclick="() => selectedDate = day">
                        <strong>@DayAr(day.DayOfWeek)</strong>
                        <span>@day.ToString("dd/MM")</span>
                    </button>
                }
            </section>
        }

        <section class="ops-table-card">
            <div class="ops-table-head">
                <div>
                    <h2>@CurrentTitle</h2>
                    <p>الأسبوع من @week[0].ToString("dd/MM/yyyy") إلى @week.Last().ToString("dd/MM/yyyy")</p>
                </div>
                <span class="ops-count">@VisibleRowsCount سجل</span>
            </div>

            <div class="ops-table-wrap">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>الاسم</th>
                            @if (selectedCategory == Category.Doctors)
                            {
                                <th>التخصص</th>
                            }
                            else
                            {
                                <th>الخصم</th>
                            }
                            <th>الهاتف</th>
                            <th>الحد اليومي</th>
                            @foreach (var day in DisplayDays)
                            {
                                <th>@DayAr(day.DayOfWeek)<small>@day.ToString("dd/MM")</small></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (selectedCategory == Category.Doctors)
                        {
                            @foreach (var doctor in VisibleDoctors)
                            {
                                <tr>
                                    <td><strong>@doctor.User.FullNameAr</strong><small>@doctor.ClinicAddress</small></td>
                                    <td>@doctor.Specialty.NameAr</td>
                                    <td>@(doctor.ClinicPhone ?? doctor.User.PhoneNumber ?? "—")</td>
                                    <td>@Math.Max(1, doctor.MaxDailySlots)</td>
                                    @foreach (var day in DisplayDays)
                                    {
                                        var state = DoctorState(doctor, day);
                                        <td><span class="ops-state @state.Css">@state.Text</span></td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            @foreach (var partner in VisiblePartners)
                            {
                                <tr>
                                    <td><strong>@partner.FullNameAr</strong><small>@PartnerAddress(partner)</small></td>
                                    <td>@(partner.DiscountPercentage > 0 ? $"{partner.DiscountPercentage:0.#}%" : "بدون خصم")</td>
                                    <td>@(partner.PhoneNumber ?? "—")</td>
                                    <td>@Math.Max(1, partner.DailyRequestCapacity)</td>
                                    @foreach (var day in DisplayDays)
                                    {
                                        var state = PartnerState(partner, day);
                                        <td><span class="ops-state @state.Css">@state.Text</span></td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@code {
    private bool loading = true;
    private bool weekView = true;
    private Category selectedCategory = Category.Doctors;
    private Guid? selectedSpecialtyId;
    private DateOnly selectedDate;
    private List<DateOnly> week = [];
    private List<Doctor> doctors = [];
    private List<ApplicationUser> partners = [];
    private List<MedicalRequest> weekRequests = [];
    private List<Specialty> specialties = [];

    private readonly (Category Value, string Label, string Icon)[] categories =
    [
        (Category.Doctors, "الأطباء", "🩺"),
        (Category.Laboratories, "معامل التحاليل", "🧪"),
        (Category.Radiology, "مراكز الأشعة", "🩻"),
        (Category.Pharmacies, "الصيدليات", "💊")
    ];

    protected override async Task OnInitializedAsync()
    {
        week = BuildWeek(DateOnly.FromDateTime(DateTime.Today));
        selectedDate = DateOnly.FromDateTime(DateTime.Today);
        if (!week.Contains(selectedDate)) selectedDate = week[0];

        doctors = await Db.Doctors.AsNoTracking()
            .Include(x => x.User)
            .Include(x => x.Specialty)
            .Where(x => x.User.IsActive)
            .OrderBy(x => x.Specialty.NameAr)
            .ThenBy(x => x.User.FullNameAr)
            .ToListAsync();

        partners = await Db.Users.AsNoTracking()
            .Where(x => x.IsActive &&
                (x.UserType == UserType.Laboratory || x.UserType == UserType.RadiologyCenter ||
                 x.UserType == UserType.Pharmacy || x.UserType == UserType.Pharmacist))
            .OrderBy(x => x.FullNameAr)
            .ToListAsync();

        specialties = await Db.Specialties.AsNoTracking().Where(x => x.IsActive).OrderBy(x => x.NameAr).ToListAsync();

        weekRequests = await Db.MedicalRequests.AsNoTracking()
            .Where(x => x.AppointmentDate >= week[0] && x.AppointmentDate <= week.Last() &&
                (x.Status == RequestStatus.Approved || x.Status == RequestStatus.Completed))
            .ToListAsync();

        loading = false;
    }

    private IEnumerable<DateOnly> DisplayDays => weekView ? week : [selectedDate];
    private IEnumerable<Doctor> VisibleDoctors => doctors.Where(x => selectedSpecialtyId is null || x.SpecialtyId == selectedSpecialtyId);
    private IEnumerable<ApplicationUser> VisiblePartners => partners.Where(PartnerMatchesCategory);
    private int VisibleRowsCount => selectedCategory == Category.Doctors ? VisibleDoctors.Count() : VisiblePartners.Count();

    private string CurrentTitle => selectedCategory switch
    {
        Category.Doctors => selectedSpecialtyId is null ? "كل الأطباء حسب التخصص" : $"أطباء {specialties.FirstOrDefault(x => x.Id == selectedSpecialtyId)?.NameAr}",
        Category.Laboratories => "معامل التحاليل",
        Category.Radiology => "مراكز الأشعة",
        _ => "الصيدليات"
    };

    private void SelectCategory(Category category)
    {
        selectedCategory = category;
        if (category != Category.Doctors) selectedSpecialtyId = null;
    }

    private bool PartnerMatchesCategory(ApplicationUser user) => selectedCategory switch
    {
        Category.Laboratories => user.UserType == UserType.Laboratory,
        Category.Radiology => user.UserType == UserType.RadiologyCenter,
        Category.Pharmacies => user.UserType is UserType.Pharmacy or UserType.Pharmacist,
        _ => false
    };

    private StatusCell DoctorState(Doctor doctor, DateOnly day)
    {
        var working = IsWorking(doctor.WorkingDays, day.DayOfWeek) && doctor.IsAvailable;
        if (!working) return new("غير موجود", "off");

        var capacity = Math.Max(1, doctor.MaxDailySlots);
        var used = weekRequests.Count(x => x.ServiceType == ServiceRequestType.MedicalConsultation && x.DoctorId == doctor.Id && x.AppointmentDate == day);
        var remaining = Math.Max(0, capacity - used);
        return remaining == 0 ? new($"مكتمل {used}/{capacity}", "full") : new($"✓ متاح {remaining}/{capacity}", remaining <= Math.Max(1, capacity / 4) ? "near" : "available");
    }

    private StatusCell PartnerState(ApplicationUser partner, DateOnly day)
    {
        if (!IsWorking(partner.WorkingDays, day.DayOfWeek)) return new("غير موجود", "off");

        var capacity = Math.Max(1, partner.DailyRequestCapacity);
        var service = partner.UserType switch
        {
            UserType.Laboratory => ServiceRequestType.LaboratoryTest,
            UserType.RadiologyCenter => ServiceRequestType.RadiologyScan,
            _ => ServiceRequestType.PharmacyMedication
        };
        var used = weekRequests.Count(x => x.ServiceType == service && x.AssignedProviderUserId == partner.Id && x.AppointmentDate == day);
        var remaining = Math.Max(0, capacity - used);
        return remaining == 0 ? new($"مكتمل {used}/{capacity}", "full") : new($"✓ متاح {remaining}/{capacity}", remaining <= Math.Max(1, capacity / 4) ? "near" : "available");
    }

    private int TodayAvailableDoctors => doctors.Count(x => DoctorState(x, DateOnly.FromDateTime(DateTime.Today)).Css is "available" or "near");
    private int TodayFullDoctors => doctors.Count(x => DoctorState(x, DateOnly.FromDateTime(DateTime.Today)).Css == "full");
    private int TodayWorkingLabs => partners.Count(x => x.UserType == UserType.Laboratory && IsWorking(x.WorkingDays, DateTime.Today.DayOfWeek));
    private int TodayWorkingRadiology => partners.Count(x => x.UserType == UserType.RadiologyCenter && IsWorking(x.WorkingDays, DateTime.Today.DayOfWeek));
    private int TodayWorkingPharmacies => partners.Count(x => x.UserType is UserType.Pharmacy or UserType.Pharmacist && IsWorking(x.WorkingDays, DateTime.Today.DayOfWeek));

    private void OpenPrintPreview() => Nav.NavigateTo("/admin/operations/print", true);

    private static List<DateOnly> BuildWeek(DateOnly today)
    {
        var diff = ((int)today.DayOfWeek - (int)DayOfWeek.Saturday + 7) % 7;
        var start = today.AddDays(-diff);
        return Enumerable.Range(0, 7).Select(start.AddDays).ToList();
    }

    private static bool IsWorking(string? raw, DayOfWeek day)
    {
        if (string.IsNullOrWhiteSpace(raw)) return true;
        var token = day switch
        {
            DayOfWeek.Saturday => "Sat",
            DayOfWeek.Sunday => "Sun",
            DayOfWeek.Monday => "Mon",
            DayOfWeek.Tuesday => "Tue",
            DayOfWeek.Wednesday => "Wed",
            DayOfWeek.Thursday => "Thu",
            _ => "Fri"
        };
        return raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Contains(token, StringComparer.OrdinalIgnoreCase);
    }

    private static string DayAr(DayOfWeek day) => day switch
    {
        DayOfWeek.Saturday => "السبت",
        DayOfWeek.Sunday => "الأحد",
        DayOfWeek.Monday => "الاثنين",
        DayOfWeek.Tuesday => "الثلاثاء",
        DayOfWeek.Wednesday => "الأربعاء",
        DayOfWeek.Thursday => "الخميس",
        _ => "الجمعة"
    };

    private static string PartnerAddress(ApplicationUser user) => string.Join(" - ", new[] { user.Governorate, user.City, user.AddressAr }.Where(x => !string.IsNullOrWhiteSpace(x)));
    private sealed record StatusCell(string Text, string Css);
    private enum Category { Doctors, Laboratories, Radiology, Pharmacies }
}

<style>
