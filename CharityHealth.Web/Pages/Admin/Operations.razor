card{background:#fff;border:1px solid #e5eaf1;border-radius:24px;box-shadow:0 14px 40px rgba(15,23,42,.06);overflow:hidden}.ops-table-head{display:flex;justify-content:space-between;align-items:center;padding:22px 24px;border-bottom:1px solid #edf1f5}.ops-table-head h2{margin:0;font-size:24px}.ops-table-head p{margin:5px 0 0;color:#64748b}.ops-count{background:#ecfdf5;color:#047857;border-radius:999px;padding:8px 13px;font-weight:800}.ops-table-wrap{overflow:auto}.ops-table{width:100%;border-collapse:separate;border-spacing:0;min-width:1100px}.ops-table th{background:#f8fafc;color:#475569;font-size:12px;padding:15px;text-align:right;border-bottom:1px solid #e5e7eb;white-space:nowrap}.ops-table td{padding:15px;border-bottom:1px solid #eef2f7;vertical-align:middle}.ops-table tbody tr:hover{background:#fafdfc}.ops-table td strong{display:block}.ops-state{display:inline-flex;justify-content:center;min-width:102px;padding:8px 10px;border-radius:999px;font-size:12px;font-weight:800}.ops-state.available{background:#dcfce7;color:#166534}.ops-state.near{background:#fef3c7;color:#92400e}.ops-state.full{background:#fee2e2;color:#991b1b}.ops-state.off{background:#e2e8f0;color:#64748b}.ops-loading{padding:50px;text-align:center;font-weight:800;color:#64748b}
html[data-theme='dark'] .ops-page,body.dark .ops-page{color:#e5edf6}.dark .ops-summary-grid article,.dark .ops-toolbar,.dark .ops-specialty-filter,.dark .ops-day-picker,.dark .ops-table-card{background:#172235;border-color:#2b3a50;color:#e5edf6}.dark .ops-table th{background:#111c2e;color:#cbd5e1}.dark .ops-table td{border-color:#2a394d}.dark .ops-tabs button,.dark .ops-view-switch button,.dark .ops-specialty-filter button,.dark .ops-day-picker button{background:#172235;color:#dbe7f4;border-color:#35465d}.dark .ops-table tbody tr:hover{background:#1d2b40}
@@media(max-width:1100px){.ops-summary-grid{grid-template-columns:repeat(3,1fr)}.ops-hero,.ops-toolbar{align-items:flex-start;flex-direction:column}.ops-page{padding:18px}}@@media(max-width:650px){.ops-summary-grid{grid-template-columns:repeat(2,1fr)}.ops-hero h1{font-size:28px}}
</style>
