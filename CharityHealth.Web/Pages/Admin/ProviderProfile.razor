@page "/admin/pharmacy-profile/{UserId}" 
@page "/admin/laboratory-profile/{UserId}"
@layout MainLayout
@attribute [Authorize(Roles="Administrator,Staff")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CharityHealth.Domain.Entities
@using CharityHealth.Infrastructure.Persistence
@using CharityHealth.Web.Shared
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
<PageTitle>ملف الجهة الطبية</PageTitle><link href="/css/admin-medical-profiles.css" rel="stylesheet" />
<div class="ch-page"><button class="ch-btn gray" @onclick='() => Nav.NavigateTo(BackUrl)'>← العودة للقائمة</button>
@if(loading){<div class="ch-empty">جارٍ التحميل...</div>}else if(user is null){<div class="ch-empty">الجهة غير موجودة.</div>}else{
<section class="ch-hero"><div class="ch-icon">@Icon</div><div class="title"><span>@Title</span><h1>@Show(user.FullNameAr)</h1><strong>@Show(user.FullNameEn,Title)</strong></div><div class="badge">@(user.IsActive?"نشط":"غير نشط")</div></section>
<section class="ch-summary"><div><strong>@requests.Count</strong><span>إجمالي الطلبات</span></div><div><strong>@Count("Completed")</strong><span>مكتملة</span></div><div><strong>@OpenCount</strong><span>قيد التنفيذ</span></div><div><strong>@user.DailyRequestCapacity</strong><span>السعة اليومية</span></div></section>
<section class="ch-section"><h2>بيانات الجهة</h2><div class="ch-info"><Field L="اسم المسؤول" V="@Show(user.ContactPersonName)"/><Field L="الهاتف" V="@Show(user.PhoneNumber)"/><Field L="البريد" V="@Show(user.Email)"/><Field L="رقم الترخيص" V="@Show(user.LicenseNumber)"/><Field L="المحافظة" V="@Show(user.Governorate)"/><Field L="المدينة" V="@Show(user.City)"/><Field L="العنوان" V="@Show(user.AddressAr)"/><Field L="أيام العمل" V="@Show(user.WorkingDays)"/><Field L="ساعات العمل" V="@Show(user.WorkingHours)"/><Field L="نسبة الخصم" V="@($"{user.DiscountPercentage:0.##}%")"/><Field L="السعة اليومية" V="@user.DailyRequestCapacity.ToString()"/></div></section>
<section class="ch-section"><h2>سجل الطلبات</h2>@if(requests.Count==0){<div class="ch-empty">لا توجد طلبات.</div>}else{<div class="ch-table"><table><thead><tr><th>رقم الطلب</th><th>المريض</th><th>الخدمة</th><th>التاريخ</th><th>الحالة</th><th>ملاحظة الجهة</th><th></th></tr></thead><tbody>@foreach(var r in requests){<tr><td>#@r.Id.ToString()[..8]</td><td>@Patient(r.BeneficiaryId)</td><td>@Service(r.ServiceType.ToString())</td><td>@Date(r)</td><td><span class="ch-pill">@Status(r.Status.ToString())</span></td><td>@Show(r.ProviderNoteAr,"—")</td><td><button class="ch-btn soft" @onclick='() => Nav.NavigateTo($"/admin/requests/{r.Id}")'>التفاصيل</button></td></tr>}</tbody></table></div>}</section>}
</div>
@code{[Parameter]public string UserId{get;set;}="";private bool loading=true;private ApplicationUser? user;private List<MedicalRequest> requests=[];private Dictionary<Guid,string> names=[];private bool Pharmacy=>user?.UserType.ToString().Contains("Pharmac",StringComparison.OrdinalIgnoreCase)==true;private string Title=>Pharmacy?"ملف الصيدلية":"ملف المعمل";private string Icon=>Pharmacy?"💊":"🧪";private string BackUrl=>Pharmacy?"/admin/pharmacies":"/admin/laboratories";protected override async Task OnParametersSetAsync(){await using var db=await DbFactory.CreateDbContextAsync();user=await db.Users.AsNoTracking().FirstOrDefaultAsync(x=>x.Id==UserId);if(user is not null){requests=await db.MedicalRequests.AsNoTracking().Where(x=>x.AssignedProviderUserId==UserId).OrderByDescending(x=>x.CreatedAt).ToListAsync();await LoadNames(db);}loading=false;}private async Task LoadNames(AppDbContext db){var ids=requests.Select(x=>x.BeneficiaryId).Distinct().ToList();if(ids.Count==0)return;var bs=await db.Beneficiaries.AsNoTracking().Where(x=>ids.Contains(x.Id)).ToListAsync();var map=new Dictionary<Guid,string>();var uids=new HashSet<string>();foreach(var b in bs){var n=Text(b,"FullNameAr","NameAr","FullName");if(!string.IsNullOrWhiteSpace(n))names[b.Id]=n;var uid=Text(b,"UserId","ApplicationUserId");if(!string.IsNullOrWhiteSpace(uid)){map[b.Id]=uid;uids.Add(uid);}}if(uids.Count>0){var us=await db.Users.AsNoTracking().Where(x=>uids.Contains(x.Id)).ToDictionaryAsync(x=>x.Id);foreach(var m in map)if(us.TryGetValue(m.Value,out var u))names[m.Key]=Show(u.FullNameAr,u.FullNameEn);}}private int Count(string s)=>requests.Count(x=>x.Status.ToString()==s);private int OpenCount=>requests.Count-Count("Completed");private string Patient(Guid id)=>names.TryGetValue(id,out var n)?n:$"مستفيد #{id.ToString()[..8]}";private static string Date(MedicalRequest r)=>r.AppointmentDate?.ToString("yyyy/MM/dd")??r.SubmittedAt.ToLocalTime().ToString("yyyy/MM/dd");private static string Status(string s)=>s switch{"Submitted"=>"مرسل","UnderReview"=>"قيد المراجعة","Approved"=>"مقبول","Completed"=>"مكتمل","Rejected"=>"مرفوض",_=>s};private static string Service(string s)=>s switch{"MedicalConsultation"=>"كشف طبي","Pharmacy"=>"صرف دواء","Laboratory"=>"تحاليل","Radiology"=>"أشعة",_=>s};private static string Text(object? o,params string[] ps){if(o is null)return"";foreach(var p in ps){var v=o.GetType().GetProperty(p)?.GetValue(o);var t=Convert.ToString(v);if(!string.IsNullOrWhiteSpace(t))return t;}return"";}private static string Show(string? v,string f="غير مسجل")=>string.IsNullOrWhiteSpace(v)?f:v;}
