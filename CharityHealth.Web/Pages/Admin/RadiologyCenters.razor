    color: #fff;
    font-weight: 950;
    cursor: pointer;
}

.manual-service-button:hover {
    filter: brightness(.96);
}

</style>

@code {
    private bool loading = true;
    private bool busy;
    private bool showInactive;
    private bool messageOk;
    private string search = string.Empty;
    private string? message;

    private ApplicationUser? deleteCandidate;
    private List<ApplicationUser> providers = [];
    private List<MedicalRequest> requests = [];

    private static readonly string[] ProviderKeys = ["RadiologyCenter", "Radiology"];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;

        await using var db = await DbFactory.CreateDbContextAsync();

        var allUsers = await db.Users
            .AsNoTracking()
            .OrderBy(user => user.FullNameAr)
            .ToListAsync();

        providers = allUsers
            .Where(IsCorrectProvider)
            .ToList();

        var ids = providers
            .Select(provider => provider.Id)
            .ToList();

        requests = ids.Count == 0
            ? []
            : await db.MedicalRequests
                .AsNoTracking()
                .Where(request =>
                    request.AssignedProviderUserId != null
                    && ids.Contains(request.AssignedProviderUserId))
                .ToListAsync();

        loading = false;
    }

    private IEnumerable<ApplicationUser> FilteredProviders
    {
        get
        {
            IEnumerable<ApplicationUser> query = providers;

            if (!showInactive)
            {
                query = query.Where(provider => provider.IsActive);
            }

            var term = search.Trim();

            if (!string.IsNullOrWhiteSpace(term))
            {
                query = query.Where(provider =>
                    Contains(provider.FullNameAr, term)
                    || Contains(provider.FullNameEn, term)
                    || Contains(provider.PhoneNumber, term)
                    || Contains(provider.Email, term)
                    || Contains(provider.ContactPersonName, term)
                    || Contains(provider.LicenseNumber, term)
                    || Contains(provider.Governorate, term)
                    || Contains(provider.City, term)
                    || Contains(provider.AddressAr, term));
            }

            return query;
        }
    }

    private void AskDelete(ApplicationUser provider)
    {
        message = null;
        deleteCandidate = provider;
    }

    private void CancelDelete()
    {
        deleteCandidate = null;
    }

    private async Task DeleteProviderAsync()
    {
        if (deleteCandidate is null || busy)
        {
            return;
        }

        busy = true;
        message = null;
        messageOk = false;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var transaction = await db.Database.BeginTransactionAsync();

            var account = await db.Users
                .FirstOrDefaultAsync(user => user.Id == deleteCandidate.Id);

            if (account is null || !IsCorrectProvider(account))
            {
                message = "مركز الأشعة غير موجود أو لا ينتمي إلى هذا النوع.";
                return;
            }

            var activeRequests = await db.MedicalRequests
                .Include(request => request.QRCodeToken)
                .Where(request =>
                    request.AssignedProviderUserId == account.Id
                    && request.Status != RequestStatus.Completed
                    && request.Status != RequestStatus.Rejected)
                .ToListAsync();

            foreach (var request in activeRequests)
            {
                request.AssignedProviderUserId = null;
                request.Status = RequestStatus.UnderReview;
                request.ReviewedBy = null;
                request.ReviewedAt = null;
                request.ReviewNoteAr = "أعيد الطلب للمراجعة بعد حذف الجهة الطبية التي كانت مخصصة له.";

                if (request.QRCodeToken is not null)
                {
                    request.QRCodeToken.ExpiresAt = DateTime.UtcNow;
                }
            }

            account.IsActive = false;
            account.LockoutEnabled = true;
            account.LockoutEnd = DateTimeOffset.UtcNow.AddYears(100);
            account.UpdatedAt = DateTime.UtcNow;
            account.SecurityStamp = Guid.NewGuid().ToString();

            await db.SaveChangesAsync();
            await transaction.CommitAsync();

            messageOk = true;
            message = activeRequests.Count == 0
                ? "تم حذف مركز الأشعة وتعطيل حسابه بنجاح."
                : $"تم حذف مركز الأشعة وتعطيل حسابه، وإعادة {activeRequests.Count} طلب غير مكتمل إلى مراجعة الإدارة.";

            deleteCandidate = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            messageOk = false;
            message = $"تعذر حذف مركز الأشعة: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RestoreProviderAsync(ApplicationUser provider)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        message = null;
        messageOk = false;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var account = await db.Users
                .FirstOrDefaultAsync(user => user.Id == provider.Id);

            if (account is null || !IsCorrectProvider(account))
            {
                message = "مركز الأشعة غير موجود أو لا ينتمي إلى هذا النوع.";
                return;
            }

            account.IsActive = true;
            account.LockoutEnabled = false;
            account.LockoutEnd = null;
            account.UpdatedAt = DateTime.UtcNow;
            account.SecurityStamp = Guid.NewGuid().ToString();

            await db.SaveChangesAsync();

            messageOk = true;
            message = "تمت إعادة تفعيل حساب مركز الأشعة بنجاح.";

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            messageOk = false;
            message = $"تعذر إعادة تفعيل مركز الأشعة: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private ProviderStats GetStats(string providerId)
    {
        var related = requests
            .Where(request => request.AssignedProviderUserId == providerId)
            .ToList();

        var completed = related.Count(request => request.Status == RequestStatus.Completed);
        var open = related.Count(request =>
            request.Status is RequestStatus.Submitted
                or RequestStatus.UnderReview
                or RequestStatus.Approved);

        return new ProviderStats(related.Count, open, completed);
    }

    private static bool IsCorrectProvider(ApplicationUser user)
    {
        var type = user.UserType.ToString();

        return ProviderKeys.Any(key =>
            type.Contains(key, StringComparison.OrdinalIgnoreCase));
    }

    private static bool Contains(string? source, string term) =>
        !string.IsNullOrWhiteSpace(source)
        && source.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string DisplayName(ApplicationUser user) =>
        Show(user.FullNameAr, user.FullNameEn);

    private static string Show(string? value, string fallback = "غير مسجل") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    private readonly record struct ProviderStats(
        int Total,
        int Open,
        int Completed);
}
