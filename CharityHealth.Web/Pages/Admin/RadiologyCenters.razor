@page "/admin/radiology-centers"
@layout MainLayout
@attribute [Authorize(Roles = "Administrator")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using CharityHealth.Domain.Entities
@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>إدارة مراكز الأشعة</PageTitle>

<div class="partner-admin-page" dir="rtl" style="--partner-accent:#2563eb;--partner-soft:#eff6ff;--partner-border:#bfdbfe;">
    <header class="partner-admin-head">
        <div>
            <span>Radiology Centers Management</span>
            <h1>مراكز الأشعة المتعاونة</h1>
            <p>إدارة البيانات والحسابات، مع إمكانية الحذف الآمن أو إعادة التفعيل بواسطة مدير النظام فقط.</p>
        </div>

        <button type="button" @onclick='() => Nav.NavigateTo("/admin/radiology-centers/create")'>
            + إضافة مركز الأشعة
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="partner-message @(messageOk ? "ok" : "bad")">@message</div>
    }

    @if (deleteCandidate is not null)
    {
        <section class="delete-confirmation">
            <div>
                <strong>تأكيد حذف مركز الأشعة</strong>
                <p>
                    سيتم تعطيل حساب
                    <b>@DisplayName(deleteCandidate)</b>
                    ومنعه من تسجيل الدخول وإخفاؤه من القائمة النشطة.
                </p>
                <small>
                    الطلبات غير المكتملة المخصصة له ستعود تلقائيًا إلى قائمة مراجعة الإدارة،
                    بينما تظل الطلبات المكتملة محفوظة داخل التقارير والسجل.
                </small>
            </div>

            <div class="delete-confirmation-actions">
                <button type="button"
                        class="cancel"
                        disabled="@busy"
                        @onclick="CancelDelete">
                    إلغاء
                </button>

                <button type="button"
                        class="delete"
                        disabled="@busy"
                        @onclick="DeleteProviderAsync">
                    @(busy ? "جارٍ الحذف..." : "تأكيد الحذف")
                </button>
            </div>
        </section>
    }

    <section class="partner-toolbar">
        <label class="partner-search">
            <span>🔎</span>
            <input type="search"
                   @bind="search"
                   @bind:event="oninput"
                   placeholder="ابحث بالاسم أو الهاتف أو البريد أو المدينة أو الترخيص..." />
        </label>

        <label class="inactive-toggle">
            <input type="checkbox" @bind="showInactive" />
            <span>عرض الحسابات المحذوفة أو الموقوفة</span>
        </label>
    </section>

    @if (loading)
    {
        <section class="partner-state">جارٍ تحميل البيانات...</section>
    }
    else if (!FilteredProviders.Any())
    {
        <section class="partner-state">لا توجد نتائج مطابقة.</section>
    }
    else
    {
        <section class="partner-grid">
            @foreach (var provider in FilteredProviders)
            {
                var stats = GetStats(provider.Id);

                <article class="partner-card @(provider.IsActive ? "" : "inactive")">
                    <div class="partner-card-head">
                        <span class="partner-icon">🩻</span>

                        <div>
                            <h2>@DisplayName(provider)</h2>
                            <p>@Show(provider.FullNameEn, "مركز الأشعة")</p>
                        </div>

                        <span class="account-status @(provider.IsActive ? "active" : "inactive")">
                            @(provider.IsActive ? "نشط" : "محذوف / موقوف")
                        </span>
                    </div>

                    <div class="partner-info">
                        <div><span>المسؤول</span><strong>@Show(provider.ContactPersonName)</strong></div>
                        <div><span>الهاتف</span><strong>@Show(provider.PhoneNumber)</strong></div>
                        <div><span>البريد</span><strong>@Show(provider.Email)</strong></div>
                        <div><span>الترخيص</span><strong>@Show(provider.LicenseNumber)</strong></div>
                        <div><span>المحافظة</span><strong>@Show(provider.Governorate)</strong></div>
                        <div><span>المدينة</span><strong>@Show(provider.City)</strong></div>
                        <div><span>السعة اليومية</span><strong>@provider.DailyRequestCapacity</strong></div>
                        <div><span>الخصم</span><strong>@provider.DiscountPercentage.ToString("0.##")%</strong></div>
                    </div>

                    <div class="partner-stats">
                        <div><strong>@stats.Total</strong><span>إجمالي الطلبات</span></div>
                        <div><strong>@stats.Open</strong><span>قيد التنفيذ</span></div>
                        <div><strong>@stats.Completed</strong><span>مكتملة</span></div>
                    </div>

                    @if (provider.IsActive)
                    {
                        @* RADIOLOGY_MANUAL_SERVICE_BUTTON *@
                        <button type="button"
                                class="manual-service-button"
                                @onclick='() => Nav.NavigateTo($"/admin/manual-services?type=RadiologyScan&provider={Uri.EscapeDataString(provider.Id)}")'>
                            ✓ تمت الخدمة يدويًا
                        </button>
                    }


                    @* LABORATORY_MANUAL_SERVICE_BUTTON_START *@
                    @if (provider.IsActive)
                    {
                        <button type="button"
                                class="manual-service-card-button"
                                @onclick='() => Nav.NavigateTo($"/admin/manual-services?type={(int)ServiceRequestType.RadiologyScan}&provider={Uri.EscapeDataString(provider.Id)}")'>
                            ✓ تمت الخدمة يدويًا
                        </button>
                    }
                    @* LABORATORY_MANUAL_SERVICE_BUTTON_END *@

                    <div class="partner-actions">
                        <button type="button"
                                class="profile"
                                @onclick='() => Nav.NavigateTo($"/admin/user-profile/{provider.Id}")'>
                            عرض الملف الكامل
                        </button>

                        @if (provider.IsActive)
                        {
                            <button type="button"
                                    class="delete"
                                    disabled="@busy"
                                    @onclick="() => AskDelete(provider)">
                                حذف مركز الأشعة
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="restore"
                                    disabled="@busy"
                                    @onclick="() => RestoreProviderAsync(provider)">
                                إعادة تفعيل الحساب
                            </button>
                        }
                    </div>
                </article>
            }
        </section>
    }
</div>

<style>
