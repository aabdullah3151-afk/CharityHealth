@page "/login"

@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using CharityHealth.Infrastructure.Persistence

@layout CharityHealth.Web.Shared.Layouts.AuthLayout
@inject NavigationManager Nav
@inject AppDbContext Db

<PageTitle>تسجيل الدخول</PageTitle>

<div class="login-shell" dir="rtl">
    <section class="login-card">
        <div class="login-title-block">
            <h1>تسجيل الدخول</h1>
            <p>مرحباً بك في منظومة الرعاية الصحية</p>
        </div>

        <div class="demo-login-block" aria-label="حسابات تجريبية">
            <div class="demo-caption">دخول سريع — حسابات تجريبية:</div>

            <div class="demo-grid">
                <button type="button"
                        class="demo-btn demo-beneficiary"
                        onclick="fillLogin('mm0115810@gmail.com','Admin@123456!')">
                    مستفيد
                </button>

                <button type="button"
                        class="demo-btn demo-doctor"
                        onclick="fillLogin('doctor@charityhealth.org','12345678')">
                    طبيب متطوع
                </button>

                <button type="button"
                        class="demo-btn demo-pharmacy"
                        onclick="fillLogin('pharmacist@charityhealth.org','Admin@123456!')">
                    صيدلاني
                </button>

                <button type="button"
                        class="demo-btn demo-admin"
                        onclick="fillLogin('admin@charityhealth.org','Admin@123456!')">
                    مدير نظام
                </button>
            </div>
        </div>

        <div class="login-divider">
            <span>أو ادخل بياناتك</span>
        </div>

        <form method="post" action="/account/login" class="login-form" autocomplete="on">
            <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? string.Empty)" />

            <label for="login-credential">البريد الإلكتروني</label>
            <div class="field-shell">
                <span class="field-symbol">✉</span>
                <input id="login-credential"
                       class="clean-input"
                       name="credential"
                       type="email"
                       placeholder="example@email.com"
                       autocomplete="username"
                       required />
            </div>

            <label for="login-password">كلمة المرور</label>
            <div class="field-shell">
                <span class="field-symbol">⌕</span>
                <input id="login-password"
                       class="clean-input"
                       name="password"
                       type="password"
                       placeholder="••••••••"
                       autocomplete="current-password"
                       required />
            </div>

            <button class="login-submit" type="submit">
                تسجيل الدخول
            </button>
        </form>

        <p class="login-footer">
            ليس لديك حساب؟
            <a href="/register">إنشاء حساب مستفيد</a>
        </p>
    </section>

    <section class="login-brand-panel" aria-label="هوية المنصة">
        <div class="brand-mark large" aria-hidden="true"></div>

        <h2>مستشفى<br />بلا مستشفى</h2>

        <p>
            رحمة بلا حدود · علاج بلا مبنى<br />
            منصة رعاية صحية خيرية رقمية
        </p>

        <div class="brand-metrics">
            <div>
                <strong>@MetricNumber(TotalBeneficiaries)</strong>
                <span>مستفيد مستفاد</span>
            </div>

            <div>
                <strong>@MetricNumber(VolunteerDoctors)</strong>
                <span>طبيب متطوع</span>
            </div>

            <div>
                <strong>@MetricNumber(CompletedConsultations)</strong>
                <span>استشارة مكتملة</span>
            </div>

            <div>
                <strong class="rating">★ @SatisfactionDisplay</strong>
                <span>معدل الرضا</span>
            </div>
        </div>
    </section>
</div>

<script>
    window.fillLogin = function (credential, password) {
        const credentialInput = document.getElementById('login-credential');
        const passwordInput = document.getElementById('login-password');

        if (credentialInput) {
            credentialInput.value = credential;
            credentialInput.dispatchEvent(new Event('input', { bubbles: true }));
        }

        if (passwordInput) {
            passwordInput.value = password;
            passwordInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
    };
</script>

@code {

    protected override async Task OnInitializedAsync()
    {
        await LoadPublicMetricsAsync();
    }



    private int TotalBeneficiaries;
    private int VolunteerDoctors;
    private int CompletedConsultations;
    private string SatisfactionDisplay = "—";

    private async Task LoadPublicMetricsAsync()
    {
        try
        {
            TotalBeneficiaries = await Db.Beneficiaries
                .AsNoTracking()
                .CountAsync();

            VolunteerDoctors = await Db.Doctors
                .AsNoTracking()
                .CountAsync(d => d.IsAvailable && !d.IsDeleted);

            CompletedConsultations = await Db.Consultations
                .AsNoTracking()
                .CountAsync();

            // لا يوجد جدول تقييمات حقيقي حاليًا، لذلك لا نعرض رقم وهمي.
            SatisfactionDisplay = "—";
        }
        catch
        {
            TotalBeneficiaries = 0;
            VolunteerDoctors = 0;
            CompletedConsultations = 0;
            SatisfactionDisplay = "—";
        }
    }

    private static string MetricNumber(int value)
    {
        return value.ToString("N0", CultureInfo.InvariantCulture);
    }


    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}
