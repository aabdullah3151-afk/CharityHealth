@page "/login"
@* LOGIN_AUTOFILL_DISABLED *@
@using CharityHealth.Web.Components.Auth

@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using CharityHealth.Infrastructure.Persistence

@layout CharityHealth.Web.Shared.Layouts.AuthLayout
@inject NavigationManager Nav
@inject AppDbContext Db

<PageTitle>تسجيل الدخول</PageTitle>

<div class="login-shell" dir="rtl">
    <section class="login-card">
        <div class="login-title-block">
            <h1>تسجيل الدخول</h1>
            <p>مرحباً بك في منظومة الرعاية الصحية</p>
        </div>

        <div class="demo-login-block" aria-label="حسابات تجريبية">
            


        </div>

        <div class="login-divider">
            <span>أو ادخل بياناتك</span>
        </div>


        @* LOGIN_ERROR_MESSAGE_PATCH *@
        @if (!string.IsNullOrWhiteSpace(LoginError))
        {
            <div role="alert"
                 aria-live="assertive"
                 style="
                    margin:0 0 18px;
                    padding:13px 15px;
                    border:1px solid #fecaca;
                    border-radius:14px;
                    background:#fff1f2;
                    color:#b91c1c;
                    display:flex;
                    align-items:center;
                    gap:10px;
                    font-size:14px;
                    font-weight:900;
                    line-height:1.7;
                    box-shadow:0 8px 20px rgba(185,28,28,.08);">

                <span aria-hidden="true"
                      style="
                        width:25px;
                        height:25px;
                        flex:0 0 25px;
                        border-radius:50%;
                        background:#dc2626;
                        color:#fff;
                        display:grid;
                        place-items:center;
                        font-weight:950;">
                    !
                </span>

                <span>@LoginError</span>
            </div>
        }

        <form method="post" action="/account/login" class="login-form" autocomplete="off">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <label for="login-credential">البريد الإلكتروني</label>
            <div class="field-shell">
                <span class="field-symbol">✉</span>
                <input id="login-credential"
                       class="clean-input"
                       name="credential"
                       type="email"
                       placeholder="example@email.com"
                       required / data-lpignore="true" data-1p-ignore="true" readonly autocomplete="off" onfocus="this.removeAttribute('readonly')" onpointerdown="this.removeAttribute('readonly')">
            </div>

            <label for="login-password">كلمة المرور</label>
            <div class="field-shell login-password-wrap">
                <span class="field-symbol">⌕</span>
                <input id="login-password"
                       class="clean-input"
                       name="password"
                       type="@(showPassword ? "text" : "password")"
                       placeholder="••••••••"
                       required / data-lpignore="true" data-1p-ignore="true" readonly autocomplete="new-password" onfocus="this.removeAttribute('readonly')" onpointerdown="this.removeAttribute('readonly')">
        <button type="button"
                class="login-password-eye"
                @onclick="TogglePasswordVisibility"
                aria-label="@PasswordToggleLabel"
                title="@PasswordToggleLabel">
            @if (showPassword)
            {
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 3l18 18M10.6 10.7a2 2 0 002.7 2.7M9.9 4.2A10.8 10.8 0 0112 4c5.2 0 9 4.8 9 8a8.7 8.7 0 01-2 3.8M6.6 6.6C4.4 8 3 10.1 3 12c0 3.2 3.8 8 9 8 1.5 0 2.9-.4 4.1-1"/>
                </svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M2.5 12S6 5 12 5s9.5 7 9.5 7S18 19 12 19 2.5 12 2.5 12z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
            }
        </button>
            </div>

            <button class="login-submit" type="submit">
                تسجيل الدخول
            </button>
        </form>

        <button type="button"
                class="guest-login-button"
                @onclick='() => Nav.NavigateTo("/")'>
            الدخول كضيف
        </button>

        <p class="guest-login-hint">
            يمكنك تصفح الأطباء والصيدليات والمعامل ومراكز الأشعة بدون حساب،
            وسيُطلب منك تسجيل الدخول فقط عند الحجز أو تقديم طلب.
        </p>

        <p class="login-footer">
            ليس لديك حساب؟
            <a href="/register">إنشاء حساب مستفيد</a>
        </p>
    </section>

    <section class="login-brand-panel" aria-label="هوية المنصة">
        <div class="brand-mark large" aria-hidden="true"></div>

        <h2>مستشفى<br />بلا مستشفى</h2>

        <p>
            رحمة بلا حدود · علاج بلا مبنى<br />
            منصة رعاية صحية خيرية رقمية
        </p>

        
            <LoginLiveStats />

    </section>
</div>

<script>
    
</script>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? LoginError { get; set; }


    private bool showPassword;

    private string PasswordToggleLabel =>
        showPassword ? "إخفاء كلمة المرور" : "إظهار كلمة المرور";

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }



    protected override async Task OnInitializedAsync()
    {
        await LoadPublicMetricsAsync();
    }



    private int TotalBeneficiaries;
    private int VolunteerDoctors;
    private int CompletedConsultations;
    private string SatisfactionDisplay = "—";

    private async Task LoadPublicMetricsAsync()
    {
        try
        {
            TotalBeneficiaries = await Db.Beneficiaries
                .AsNoTracking()
                .CountAsync();

            VolunteerDoctors = await Db.Doctors
                .AsNoTracking()
                .CountAsync(d => d.IsAvailable && !d.IsDeleted);

            CompletedConsultations = await Db.Consultations
                .AsNoTracking()
                .CountAsync();

            // لا يوجد جدول تقييمات حقيقي حاليًا، لذلك لا نعرض رقم وهمي.
            SatisfactionDisplay = "—";
        }
        catch
        {
            TotalBeneficiaries = 0;
            VolunteerDoctors = 0;
            CompletedConsultations = 0;
            SatisfactionDisplay = "—";
        }
    }

    private static string MetricNumber(int value)
    {
        return value.ToString("N0", CultureInfo.InvariantCulture);
    }


    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
}

<style>

    .guest-login-button {
        width: 100%;
        min-height: 58px;
        margin-top: 14px;
        border: 2px solid #05aa46;
        border-radius: 18px;
        background: #fff;
        color: #05963e;
        font-size: 17px;
        font-weight: 900;
        cursor: pointer;
        transition: .2s ease;
    }

    .guest-login-button:hover {
        background: #ecfdf3;
        transform: translateY(-1px);
    }

    .guest-login-hint {
        margin: 10px 12px 0;
        text-align: center;
        color: #64748b;
        font-size: 12px;
        line-height: 1.8;
        font-weight: 700;
    }


    /* Password visibility button */
    .login-password-wrap {
        position: relative !important;
    }

    .login-password-wrap > span,
    .login-password-wrap > i,
    .login-password-wrap > svg {
        display: none !important;
    }

    .login-password-wrap input {
        padding-left: 58px !important;
    }

    .login-password-eye {
        position: absolute !important;
        left: 12px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        width: 40px !important;
        height: 40px !important;
        border: 0 !important;
        border-radius: 12px !important;
        background: transparent !important;
        color: #64748b !important;
        display: grid !important;
        place-items: center !important;
        cursor: pointer !important;
        z-index: 5 !important;
    }

    .login-password-eye:hover {
        background: #eef4ff !important;
        color: #05a843 !important;
    }

    .login-password-eye svg {
        width: 21px !important;
        height: 21px !important;
        fill: none !important;
        stroke: currentColor !important;
        stroke-width: 1.9 !important;
        stroke-linecap: round !important;
        stroke-linejoin: round !important;
    }

</style>
