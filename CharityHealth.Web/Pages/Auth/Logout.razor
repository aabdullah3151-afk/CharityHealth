@page "/logout"
@using Microsoft.AspNetCore.Identity
@inject SignInManager<CharityHealth.Domain.Entities.ApplicationUser> SignInManager
@inject NavigationManager Nav
@inject ILogger<Logout> Logger

<div class="loading-card">جارٍ تسجيل الخروج...</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SignInManager.SignOutAsync();
            Logger.LogInformation("User signed out.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error while signing out.");
        }

        Nav.NavigateTo("/login", forceLoad: true);
    }
}
