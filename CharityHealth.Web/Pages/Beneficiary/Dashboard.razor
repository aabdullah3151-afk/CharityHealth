
@page "/portal/dashboard"
@attribute [Authorize(Roles = "Beneficiary")]
@inject HealthcareUiService Ui
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@using System.Security.Claims
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Shared.Components

<PageTitle>لوحة المستفيد</PageTitle>
<div class="page-head"><div><span class="eyebrow">🧍 Patient Portal</span><h2>أهلاً، @userName 👋</h2><p>قدّم طلب كشف مجاني وتابع حالة الطلب حتى الكشف.</p></div><button class="ui-btn primary" @onclick='() => Nav.NavigateTo("/portal/request/new")'>➕ طلب جديد</button></div>
@if(loading){<div class="loading-card">تحميل...</div>}else{
<div class="stat-grid"><UiStatCard Icon="📋" Title="كل الطلبات" Value="@rows.Count.ToString()" Tone="blue" /><UiStatCard Icon="⏳" Title="قيد المراجعة" Value="@rows.Count(x=>x.Status==RequestStatus.Submitted||x.Status==RequestStatus.UnderReview).ToString()" Tone="amber" /><UiStatCard Icon="✅" Title="مقبولة" Value="@rows.Count(x=>x.Status==RequestStatus.Approved).ToString()" Tone="green" /><UiStatCard Icon="🏁" Title="مكتملة" Value="@rows.Count(x=>x.Status==RequestStatus.Completed).ToString()" Tone="teal" /></div>
<section class="ui-card"><div class="card-title-row"><h3>طلباتي</h3><a href="/portal/requests">عرض كل الطلبات</a></div><div class="request-cards compact">@foreach(var r in rows.Take(5)){<article class="request-card"><div class="request-main"><div class="avatar-circle">🏥</div><div><h3>@r.SpecialtyName</h3><p>@r.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy") · 📎 @r.DocumentsCount</p></div></div><StatusPill Text="@r.StatusAr" Tone="@r.StatusCss" /><button class="mini-btn" @onclick='() => Nav.NavigateTo($"/portal/request/{r.Id}")'>تفاصيل</button></article>}</div>@if(rows.Count==0){<div class="empty-state">لا توجد طلبات بعد. ابدأ بطلب جديد.</div>}</section>}
@code{private bool loading=true; private string userName="مستفيد"; private List<RequestWorkItem> rows=[]; protected override async Task OnInitializedAsync(){var auth=await AuthState.GetAuthenticationStateAsync(); userName=auth.User.FindFirst("FullNameAr")?.Value??auth.User.Identity?.Name??"مستفيد"; var uid=auth.User.FindFirstValue(ClaimTypes.NameIdentifier)??""; rows=await Ui.GetBeneficiaryRequestsAsync(uid); loading=false;}}
