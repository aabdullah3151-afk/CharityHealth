@page "/portal/request/new"
@attribute [Authorize(Roles = "Beneficiary")]

@using Microsoft.AspNetCore.Authorization
@using CharityHealth.Domain.Enums

@inject NavigationManager Nav

<PageTitle>طلب خدمة صحية جديدة</PageTitle>

<div class="service-selector-page" dir="rtl">
    <header class="service-selector-head">
        <button type="button" class="service-back" @onclick='() => Nav.NavigateTo("/portal/dashboard")'>›</button>
        <div>
            <div class="service-kicker">طلب جديد</div>
            <h1>ما الخدمة التي تحتاجها؟</h1>
            <p>اختر نوع الطلب، ثم أكمل البيانات وارفع المستندات المطلوبة ليتم مراجعته من الإدارة.</p>
        </div>
    </header>

    <section class="service-selector-grid">
        <button type="button" class="service-choice medical" @onclick='() => OpenMedical()'>
            <span class="service-choice-icon">🩺</span>
            <div>
                <h2>كشف أو استشارة طبية</h2>
                <p>اختيار التخصص والطبيب واليوم المناسب للكشف.</p>
            </div>
            <strong>ابدأ الطلب ←</strong>
        </button>

        <button type="button" class="service-choice pharmacy" @onclick='() => OpenService(ServiceRequestType.PharmacyMedication)'>
            <span class="service-choice-icon">💊</span>
            <div>
                <h2>طلب علاج من صيدلية</h2>
                <p>اكتب اسم العلاج وارفع الروشتة أو التقرير الطبي واختر الصيدلية.</p>
            </div>
            <strong>ابدأ الطلب ←</strong>
        </button>

        <button type="button" class="service-choice laboratory" @onclick='() => OpenService(ServiceRequestType.LaboratoryTest)'>
            <span class="service-choice-icon">🧪</span>
            <div>
                <h2>طلب تحاليل طبية</h2>
                <p>حدد التحاليل المطلوبة واختر المعمل المتعاون مع المؤسسة.</p>
            </div>
            <strong>ابدأ الطلب ←</strong>
        </button>

        <button type="button" class="service-choice radiology" @onclick='() => OpenService(ServiceRequestType.RadiologyScan)'>
            <span class="service-choice-icon">🩻</span>
            <div>
                <h2>طلب أشعة</h2>
                <p>حدد نوع الأشعة وارفع طلب الطبيب واختر مركز الأشعة.</p>
            </div>
            <strong>ابدأ الطلب ←</strong>
        </button>
    </section>

    <section class="service-selector-note">
        <span>🛡️</span>
        <div>
            <strong>كل الطلبات تمر على الإدارة أولًا</strong>
            <p>بعد الموافقة سيظهر لك QR لتقديمه للطبيب أو الصيدلية أو المعمل أو مركز الأشعة.</p>
        </div>
    </section>
</div>

<style>
    .service-selector-page{min-height:calc(100vh - 76px);padding:42px;background:#f8fafc;color:#101828}
    .service-selector-head{display:flex;align-items:center;gap:18px;margin-bottom:30px}
    .service-back{width:58px;height:58px;border:1px solid #e5e7eb;border-radius:50%;background:#fff;color:#475467;font-size:34px;cursor:pointer;box-shadow:0 12px 28px rgba(15,23,42,.07)}
    .service-kicker{color:#05a843;font-size:14px;font-weight:950;margin-bottom:5px}
    .service-selector-head h1{margin:0;font-size:42px;font-weight:950}
    .service-selector-head p{margin:10px 0 0;color:#667085;font-size:15px;font-weight:800}
    .service-selector-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
    .service-choice{min-height:220px;border:1px solid #e5e7eb;border-radius:32px;background:#fff;padding:28px;text-align:right;display:grid;grid-template-columns:72px 1fr;gap:18px;align-items:start;cursor:pointer;box-shadow:0 16px 36px rgba(15,23,42,.06);transition:.2s}
    .service-choice:hover{transform:translateY(-3px);box-shadow:0 22px 44px rgba(15,23,42,.10)}
    .service-choice-icon{width:68px;height:68px;border-radius:22px;display:grid;place-items:center;font-size:32px}
    .service-choice h2{margin:3px 0 10px;font-size:25px;font-weight:950;color:#111827}
    .service-choice p{margin:0;color:#667085;font-size:14px;line-height:1.9;font-weight:800}
    .service-choice>strong{grid-column:2;color:#05a843;font-size:14px;font-weight:950;align-self:end}
    .service-choice.medical .service-choice-icon{background:#ecfdf3}.service-choice.pharmacy .service-choice-icon{background:#eff6ff}.service-choice.laboratory .service-choice-icon{background:#ecfeff}.service-choice.radiology .service-choice-icon{background:#eef2ff}
    .service-selector-note{margin-top:22px;border:1px solid #bbf7d0;border-radius:26px;background:#ecfdf3;padding:20px 24px;display:flex;gap:14px;align-items:center}
    .service-selector-note>span{font-size:28px}.service-selector-note strong{display:block;color:#047857;font-size:16px;font-weight:950}.service-selector-note p{margin:5px 0 0;color:#166534;font-size:13px;font-weight:800}
    @@media(max-width:850px){.service-selector-page{padding:24px 16px}.service-selector-grid{grid-template-columns:1fr}.service-selector-head h1{font-size:32px}.service-choice{min-height:190px;padding:22px}}
</style>

@code {
    private void OpenMedical() => Nav.NavigateTo("/portal/request/medical");

    private void OpenService(ServiceRequestType type) =>
        Nav.NavigateTo($"/portal/request/service/{type}");
}
