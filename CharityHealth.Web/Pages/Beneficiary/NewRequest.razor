@page "/portal/request/new"
@attribute [Authorize(Roles = "Beneficiary")]

@using CharityHealth.Application.Features.Requests.Commands
@using CharityHealth.Domain.Entities
@using CharityHealth.Domain.Enums
@using CharityHealth.Domain.Interfaces.Repositories
@using MediatR
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject IMediator Mediator
@inject IUnitOfWork UoW
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>طلب كشف طبي جديد</PageTitle>

<div class="consult-request-page" dir="rtl">

    <header class="consult-request-head">
        <button type="button"
                class="consult-back-btn"
                @onclick='() => Nav.NavigateTo("/portal/dashboard")'>
            ›
        </button>

        <div>
            <h1>طلب استشارة طبية</h1>
            <p>الخطوة @currentStep من 3 — @CurrentStepTitle</p>
        </div>
    </header>

    <section class="consult-progress">
        @for (var i = 0; i < wizardSteps.Count; i++)
        {
            var stepNo = i + 1;

            <button type="button"
                    class="consult-progress-item @(currentStep >= stepNo ? "active" : "")"
                    @onclick="() => GoToStep(stepNo)">
                <span></span>
                <strong>@wizardSteps[i]</strong>
            </button>
        }
    </section>

    <section class="consult-shell fixed-order">

        <aside class="consult-side">

            <article class="consult-info-card secure">
                <div class="consult-info-icon">🛡️</div>
                <h3>بياناتك محمية</h3>
                <p>نلتزم بسرية بياناتك الصحية واستخدامها فقط لمراجعة طلب الكشف.</p>
            </article>

            <article class="consult-steps-card">
                <h3>خطوات الحصول على الكشف</h3>

                @for (var i = 0; i < wizardSteps.Count; i++)
                {
                    var stepNo = i + 1;

                    <div class="consult-step-row @(currentStep >= stepNo ? "active" : "")">
                        <span>@stepNo</span>
                        <strong>@wizardSteps[i]</strong>
                    </div>
                }

                <div class="consult-step-row">
                    <span>4</span>
                    <strong>مراجعة الإدارة</strong>
                </div>

                <div class="consult-step-row">
                    <span>5</span>
                    <strong>تحديد الطبيب</strong>
                </div>
            </article>

            <article class="consult-info-card warning">
                <div class="consult-info-icon">!</div>
                <h3>نظام الحجز</h3>
                <p>بعد إرسال الطلب سيتم تحويله للإدارة بحالة تم التقديم حتى تتم المراجعة والموافقة.</p>
            </article>

        </aside>

        <main class="consult-main-card">

            <EditForm Model="@model">
                <DataAnnotationsValidator />

                @if (currentStep == 1)
                {
                    <section class="consult-step-screen">
                        <div class="consult-card-title">
                            <h2>المعلومات الشخصية</h2>
                            <p>بيانات حسابك المسجلة في النظام.</p>
                        </div>

                        <div class="consult-ok-strip">
                            <span>✓</span>
                            <strong>بياناتك الأساسية مسجلة — سيتم إرسال الطلب باسم هذا الحساب</strong>
                        </div>

                        <div class="consult-personal-grid">
                            <label>
                                <span>الاسم الكامل</span>
                                <input value="@profileName" readonly />
                            </label>

                            <label>
                                <span>رقم الجوال</span>
                                <input value="@profilePhone" readonly />
                            </label>

                            <label>
                                <span>نوع الحساب</span>
                                <input value="مستفيد" readonly />
                            </label>

                            <label>
                                <span>حالة الحساب</span>
                                <input value="نشط" readonly />
                            </label>
                        </div>
                    </section>
                }

                @if (currentStep == 2)
                {
                    <section class="consult-step-screen">
                        <div class="consult-card-title">
                            <h2>اختر التخصص الطبي</h2>
                            <p>اختر التخصص المناسب، وسيتم تحويل الطلب للإدارة للمراجعة.</p>
                        </div>

                        @if (specialties.Any())
                        {
                            <div class="consult-specialty-grid">
                                @foreach (var spec in specialties)
                                {
                                    <button type="button"
                                            class="consult-specialty-card @(model.SpecialtyId == spec.Id ? "selected" : "")"
                                            @onclick="() => SelectSpecialty(spec)">
                                        <span>@IconForSpecialty(spec.NameAr)</span>
                                        <strong>@spec.NameAr</strong>
                                    </button>
                                }
                            </div>

                            @if (showValidation && model.SpecialtyId == Guid.Empty)
                            {
                                <div class="consult-field-error">يجب اختيار التخصص الطبي</div>
                            }
                        }
                        else
                        {
                            <div class="consult-empty-box">جارٍ تحميل التخصصات...</div>
                        }
                    </section>
                }

                @if (currentStep == 3)
                {
                    <section class="consult-step-screen">
                        <div class="consult-card-title">
                            <h2>وصف الحالة الطبية</h2>
                            <p>اكتب وصفاً مختصراً للحالة وارفع صورة البطاقة.</p>
                        </div>

                        <InputTextArea @bind-Value="model.DescriptionAr"
                                       class="consult-case-area"
                                       rows="5"
                                       maxlength="2000"
                                       placeholder="اكتب وصفاً مختصراً لحالتك الصحية لمساعدة المراجعين..." />

                        <div class="consult-char-count">
                            @(model.DescriptionAr?.Length ?? 0) / 2000
                        </div>

                        <section class="consult-summary-box">
                            <h3>ملخص الطلب</h3>

                            <dl>
                                <dt>التخصص</dt>
                                <dd>@SelectedSpecialtyName</dd>

                                <dt>الحالة</dt>
                                <dd>سيتم تقديم الطلب للإدارة</dd>

                                <dt>المرحلة التالية</dt>
                                <dd>مراجعة الطلب من الإدارة</dd>
                            </dl>
                        </section>

                        <section class="consult-upload-card">
                            <div class="upload-card-head">
                                <h3>المستندات المطلوبة</h3>
                                <p>يرجى رفع صورة الهوية الوطنية على الأقل. يمكنك إضافة تقارير طبية اختيارياً.</p>
                            </div>

                            <DocumentUploader OnFilesSelected="HandleFilesSelected" />

                            @if (showValidation && !pendingFiles.Any())
                            {
                                <div class="consult-field-error">يجب رفع صورة الهوية الوطنية قبل إرسال الطلب</div>
                            }

                            @if (pendingFiles.Any())
                            {
                                <div class="consult-file-list">
                                    @foreach (var f in pendingFiles)
                                    {
                                        <div class="consult-file-item">
                                            <span>📎</span>

                                            <div>
                                                <strong>@f.Name</strong>
                                                <small>@FormatSize(f.Size)</small>
                                            </div>

                                            <select value="@f.DocumentType"
                                                    @onchange="e => f.DocumentType = Enum.Parse<DocumentType>(e.Value!.ToString()!)">
                                                <option value="@DocumentType.NationalId">بطاقة هوية</option>
                                                <option value="@DocumentType.MedicalReport">تقرير طبي</option>
                                                <option value="@DocumentType.IncomeProof">إثبات دخل</option>
                                                <option value="@DocumentType.Other">أخرى</option>
                                            </select>

                                            <button type="button"
                                                    class="consult-remove-file"
                                                    @onclick="() => RemoveFile(f)">
                                                ✕
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    </section>
                }

                @if (!string.IsNullOrWhiteSpace(errorMsg))
                {
                    <div class="consult-alert danger">
                        @errorMsg
                    </div>
                }

                <footer class="consult-footer-actions">
                    <button type="button"
                            class="consult-secondary-btn"
                            disabled="@(isLoading || currentStep == 1)"
                            @onclick="PreviousStep">
                        السابق
                    </button>

                    @if (currentStep < 3)
                    {
                        <button type="button"
                                class="consult-primary-wide"
                                disabled="@isLoading"
                                @onclick="NextStep">
                            التالي
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="consult-primary-wide"
                                disabled="@isLoading"
                                @onclick="HandleSubmit">
                            @(isLoading ? "جارٍ إرسال الطلب..." : "إرسال الطلب")
                        </button>
                    }
                </footer>
            </EditForm>

        </main>

    </section>
</div>

@code {
    private NewRequestModel model = new();
    private List<Specialty> specialties = [];
    private List<PendingFile> pendingFiles = [];

    private bool isLoading;
    private bool showValidation;

    private int currentStep = 1;

    private string? errorMsg;
    private string userId = string.Empty;
    private string selectedSpecialtyName = "لم يتم اختيار التخصص";

    private string profileName = "—";
    private string profilePhone = "غير مسجل";

    private readonly List<string> wizardSteps =
    [
        "البيانات الشخصية",
        "التخصص",
        "وصف الحالة"
    ];

    private string CurrentStepTitle => wizardSteps[currentStep - 1];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();

        userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        profileName =
            auth.User.FindFirst("FullNameAr")?.Value
            ?? auth.User.Identity?.Name
            ?? "مستفيد";

        profilePhone =
            auth.User.FindFirst(ClaimTypes.MobilePhone)?.Value
            ?? auth.User.FindFirst("PhoneNumber")?.Value
            ?? "غير مسجل";

        specialties = (await UoW.Specialties.FindAsync(s => s.IsActive))
            .OrderBy(s => s.NameAr)
            .ToList();
    }

    private void GoToStep(int step)
    {
        if (step < 1 || step > 3)
        {
            return;
        }

        if (step > 2 && model.SpecialtyId == Guid.Empty)
        {
            currentStep = 2;
            showValidation = true;
            return;
        }

        currentStep = step;
    }

    private void NextStep()
    {
        showValidation = true;
        errorMsg = null;

        if (currentStep == 2 && model.SpecialtyId == Guid.Empty)
        {
            errorMsg = "يجب اختيار التخصص الطبي";
            return;
        }

        if (currentStep < 3)
        {
            currentStep++;
        }
    }

    private void PreviousStep()
    {
        errorMsg = null;

        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private void SelectSpecialty(Specialty spec)
    {
        model.SpecialtyId = spec.Id;
        selectedSpecialtyName = spec.NameAr;
        errorMsg = null;
    }

    private string SelectedSpecialtyName =>
        model.SpecialtyId == Guid.Empty ? "لم يتم اختيار التخصص" : selectedSpecialtyName;

    private void HandleFilesSelected(List<PendingFile> files)
    {
        foreach (var file in files)
        {
            if (file.DocumentType == DocumentType.Other && !pendingFiles.Any())
            {
                file.DocumentType = DocumentType.NationalId;
            }

            pendingFiles.Add(file);
        }

        errorMsg = null;
    }

    private void RemoveFile(PendingFile file)
    {
        pendingFiles.Remove(file);
    }

    private async Task HandleSubmit()
    {
        showValidation = true;
        errorMsg = null;

        if (model.SpecialtyId == Guid.Empty)
        {
            currentStep = 2;
            errorMsg = "يجب اختيار التخصص الطبي";
            return;
        }

        if (!pendingFiles.Any())
        {
            currentStep = 3;
            errorMsg = "يجب رفع صورة الهوية الوطنية قبل إرسال الطلب";
            return;
        }

        if (string.IsNullOrWhiteSpace(userId))
        {
            errorMsg = "تعذر قراءة بيانات المستخدم الحالي. برجاء تسجيل الدخول مرة أخرى.";
            return;
        }

        isLoading = true;

        try
        {
            var result = await Mediator.Send(new SubmitRequestCommand(
                userId,
                model.SpecialtyId,
                model.DescriptionAr
            ));

            if (!result.Succeeded)
            {
                errorMsg = string.Join(" | ", result.Errors);
                return;
            }

            var requestId = result.Data;

            foreach (var file in pendingFiles)
            {
                var uploadResult = await Mediator.Send(new UploadDocumentCommand(
                    requestId,
                    userId,
                    file.Stream,
                    file.Name,
                    file.Size,
                    file.DocumentType
                ));

                if (!uploadResult.Succeeded)
                {
                    errorMsg = $"تم إرسال الطلب، لكن تعذر رفع المستند: {file.Name}";
                    return;
                }
            }

            Nav.NavigateTo("/portal/dashboard", forceLoad: true);
        }
        catch
        {
            errorMsg = "حدث خطأ غير متوقع أثناء إرسال الطلب. يرجى المحاولة لاحقاً.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024} KB";
        }

        return $"{bytes / (1024 * 1024):F1} MB";
    }

    private static string IconForSpecialty(string name)
    {
        if (name.Contains("قلب")) return "♡";
        if (name.Contains("أسنان")) return "☺";
        if (name.Contains("عين")) return "◉";
        if (name.Contains("أطفال")) return "☻";
        if (name.Contains("عظام")) return "⚕";
        if (name.Contains("جلد")) return "▱";
        if (name.Contains("باط")) return "〽";
        if (name.Contains("نساء")) return "☻";
        if (name.Contains("نفس")) return "✺";
        return "✚";
    }

    private class NewRequestModel
    {
        public Guid SpecialtyId { get; set; } = Guid.Empty;
        public string? DescriptionAr { get; set; }
    }

    public class PendingFile
    {
        public string Name { get; set; } = string.Empty;
        public long Size { get; set; }
        public Stream Stream { get; set; } = Stream.Null;
        public DocumentType DocumentType { get; set; } = DocumentType.Other;
    }
}