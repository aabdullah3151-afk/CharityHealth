@page "/portal/notifications"
@attribute [Authorize(Roles = "Beneficiary")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services

@inject HealthcareUiService Ui
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>الإشعارات</PageTitle>

<div class="beneficiary-notifications-page" dir="rtl">

    <header class="beneficiary-notifications-head">
        <div>
            <div class="notifications-kicker">🔔 Notifications</div>
            <h1>الإشعارات</h1>
            <p>آخر تحديثات طلبات الكشف، الموافقة، الرفض، ومتابعة الحالة.</p>
        </div>

        @if (!loading && notifications.Count > 0)
        {
            <span class="notifications-new-pill">
                @notifications.Count جديد
            </span>
        }
    </header>

    @if (loading)
    {
        <section class="notifications-state-card">
            جارٍ تحميل الإشعارات...
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(errorMsg))
    {
        <section class="notifications-alert-card">
            @errorMsg
        </section>
    }
    else if (notifications.Count == 0)
    {
        <section class="notifications-empty-card">
            <div>🔔</div>
            <h2>لا توجد إشعارات حالياً</h2>
            <p>عند قبول أو رفض أو تحديث طلبك ستظهر الإشعارات هنا.</p>

            <button type="button"
                    @onclick='() => Nav.NavigateTo("/portal/request/new")'>
                تقديم طلب جديد
            </button>
        </section>
    }
    else
    {
        <section class="notifications-grid">
            @foreach (var item in notifications)
            {
                <article class="notification-card @item.Tone @(item.IsNew ? "is-new" : "")">
                    <span class="notification-dot"></span>

                    <div class="notification-icon">
                        @item.Icon
                    </div>

                    <div class="notification-copy">
                        <h2>@item.Title</h2>
                        <p>@item.Message</p>
                        <small>@item.TimeText</small>
                    </div>

                    @if (item.RequestId is not null)
                    {
                        <button type="button"
                                class="notification-open"
                                title="فتح الطلب"
                                @onclick="() => OpenRequest(item.RequestId.Value)">
                            فتح
                        </button>
                    }
                </article>
            }
        </section>
    }
</div>

@code {
    private bool loading = true;
    private string? errorMsg;

    private List<RequestWorkItem> requests = [];
    private List<NotificationItem> notifications = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        loading = true;
        errorMsg = null;

        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(userId))
            {
                errorMsg = "تعذر قراءة بيانات المستخدم الحالي. برجاء تسجيل الدخول مرة أخرى.";
                return;
            }

            requests = (await Ui.GetBeneficiaryRequestsAsync(userId))
                .OrderByDescending(r => r.ReviewedAt ?? r.SubmittedAt)
                .ToList();

            notifications = requests
                .Select(CreateNotification)
                .ToList();
        }
        catch
        {
            errorMsg = "حدث خطأ أثناء تحميل الإشعارات.";
        }
        finally
        {
            loading = false;
        }
    }

    private static NotificationItem CreateNotification(RequestWorkItem request)
    {
        var actionTime = request.ReviewedAt ?? request.SubmittedAt;
        var timeText = RelativeTime(actionTime);

        return request.Status switch
        {
            RequestStatus.Approved => new NotificationItem(
                request.Id,
                "تم قبول طلبك",
                $"تمت الموافقة على طلب {request.SpecialtyName}. يمكنك متابعة التفاصيل من صفحة الطلب.",
                "✓",
                "success",
                timeText,
                true
            ),

            RequestStatus.Rejected => new NotificationItem(
                request.Id,
                "تم رفض الطلب",
                string.IsNullOrWhiteSpace(request.ReviewNoteAr)
                    ? $"طلب {request.SpecialtyName} تم رفضه. يمكنك تقديم طلب آخر أو مراجعة التفاصيل."
                    : request.ReviewNoteAr!,
                "!",
                "danger",
                timeText,
                true
            ),

            RequestStatus.Completed => new NotificationItem(
                request.Id,
                "تم إنهاء الكشف",
                $"تم إنهاء خدمة طلب {request.SpecialtyName}.",
                "✓",
                "success",
                timeText,
                false
            ),

            RequestStatus.UnderReview => new NotificationItem(
                request.Id,
                "طلبك قيد المراجعة",
                $"طلب {request.SpecialtyName} قيد المراجعة من الإدارة.",
                "◷",
                "warning",
                timeText,
                true
            ),

            RequestStatus.Submitted => new NotificationItem(
                request.Id,
                "تم استلام طلبك",
                $"تم إرسال طلب {request.SpecialtyName} إلى الإدارة للمراجعة.",
                "🔔",
                "info",
                timeText,
                true
            ),

            _ => new NotificationItem(
                request.Id,
                "تحديث على الطلب",
                $"يوجد تحديث جديد على طلب {request.SpecialtyName}.",
                "🔔",
                "info",
                timeText,
                true
            )
        };
    }

    private void OpenRequest(Guid id)
    {
        Nav.NavigateTo($"/portal/request/{id}");
    }

    private static string RelativeTime(DateTime date)
    {
        var localDate = date.ToLocalTime();
        var diff = DateTime.Now - localDate;

        if (diff.TotalMinutes < 1)
        {
            return "الآن";
        }

        if (diff.TotalMinutes < 60)
        {
            var minutes = Math.Max(1, (int)Math.Floor(diff.TotalMinutes));
            return $"منذ {minutes} دقيقة";
        }

        if (diff.TotalHours < 24)
        {
            var hours = Math.Max(1, (int)Math.Floor(diff.TotalHours));
            return $"منذ {hours} ساعة";
        }

        if (diff.TotalDays < 2)
        {
            return "أمس";
        }

        if (diff.TotalDays < 7)
        {
            var days = Math.Max(1, (int)Math.Floor(diff.TotalDays));
            return $"منذ {days} أيام";
        }

        return localDate.ToString("yyyy/MM/dd");
    }

    private sealed record NotificationItem(
        Guid? RequestId,
        string Title,
        string Message,
        string Icon,
        string Tone,
        string TimeText,
        bool IsNew
    );
}
