rid;gap:10px;margin-top:16px}.partner-file-row{border:1px solid #e5e7eb;border-radius:18px;background:#f8fafc;padding:12px 14px;display:grid;grid-template-columns:36px 1fr 210px 38px;gap:10px;align-items:center}.partner-file-row strong{display:block;font-size:13px;font-weight:950}.partner-file-row small{color:#98a2b3;font-size:11px;font-weight:800}.partner-file-row select{border:1px solid #e5e7eb;border-radius:12px;background:#fff;padding:10px;font-size:12px;font-weight:800}.partner-file-row button{width:36px;height:36px;border:0;border-radius:50%;background:#fee2e2;color:#b91c1c;cursor:pointer}.partner-actions{padding:20px 28px;display:flex;justify-content:flex-end;gap:12px}.partner-actions button{min-height:48px;border:0;border-radius:999px;padding:0 24px;font-size:14px;font-weight:950;cursor:pointer}.partner-actions .secondary{background:#f1f5f9;color:#475467}.partner-actions .primary{background:#05a843;color:#fff}.partner-actions button:disabled{opacity:.6;cursor:not-allowed}.partner-alert,.partner-state,.partner-empty{border-radius:20px;padding:18px;font-size:14px;font-weight:900}.partner-state,.partner-empty{background:#fff;border:1px solid #e5e7eb;color:#667085}.partner-alert.ok{margin:20px 28px 0;background:#ecfdf3;color:#047857;border:1px solid #bbf7d0}.partner-alert.bad{margin:20px 28px 0;background:#fef2f2;color:#991b1b;border:1px solid #fecaca}.partner-days-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.partner-day-card{border:1px solid #e5e7eb;border-radius:19px;background:#fff;padding:15px 12px;display:grid;gap:5px;text-align:center;cursor:pointer}.partner-day-card strong{font-size:15px;font-weight:950;color:#111827}.partner-day-card span{font-size:12px;font-weight:900;color:#667085}.partner-day-card small{font-size:10px;font-weight:950;color:#15803d}.partner-day-card.selected{border-color:#22c55e;background:#f0fdf4;box-shadow:0 0 0 3px rgba(34,197,94,.08)}.partner-day-card.full{opacity:.6;background:#f8fafc}.partner-day-card.full small{color:#b91c1c}
    @@media(max-width:950px){.partner-days-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.partner-request-page{padding:24px 14px}.partner-layout{grid-template-columns:1fr}.partner-side{grid-template-columns:repeat(2,minmax(0,1fr))}.provider-grid{grid-template-columns:1fr}}@@media(max-width:650px){.partner-days-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.partner-side,.partner-grid.two{grid-template-columns:1fr}.partner-request-head h1{font-size:30px}.partner-file-row{grid-template-columns:34px 1fr 38px}.partner-file-row select{grid-column:1/-1}.partner-actions{display:grid}.partner-actions button{width:100%}}
</style>

@code {
    [Parameter] public string Type { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "provider")]
    public string? ProviderQuery { get; set; }

    private ServiceRequestType serviceType;
    private bool initialLoading = true;
    private bool saving;
    private bool messageOk;
    private string? message;
    private string userId = string.Empty;
    private string profileName = string.Empty;
    private string? profilePhone;
    private string selectedProviderId = string.Empty;
    private DateOnly? selectedAppointmentDate;
    private bool loadingDays;
    private string? descriptionAr;
    private List<PartnerAccountOption> providers = [];
    private List<PartnerAvailableDay> availableDays = [];
    private List<PendingFile> pendingFiles = [];

    private bool IsValidService => serviceType is ServiceRequestType.PharmacyMedication or ServiceRequestType.LaboratoryTest or ServiceRequestType.RadiologyScan;
    private bool RequiresAppointmentDate => IsValidService;
    private string AppointmentSectionTitle => serviceType switch
    {
        ServiceRequestType.PharmacyMedication => "اختر يوم استلام العلاج",
        ServiceRequestType.LaboratoryTest => "اختر يوم إجراء التحاليل",
        ServiceRequestType.RadiologyScan => "اختر يوم إجراء الأشعة",
        _ => "اختر يوم تنفيذ الخدمة"
    };
    private string AppointmentSectionHelp => serviceType switch
    {
        ServiceRequestType.PharmacyMedication => "تظهر أيام عمل الصيدلية وعدد الطلبات المتاحة في كل يوم.",
        ServiceRequestType.LaboratoryTest => "تظهر أيام عمل المعمل وعدد الأماكن المتاحة في كل يوم.",
        ServiceRequestType.RadiologyScan => "تظهر أيام عمل مركز الأشعة وعدد الأماكن المتاحة في كل يوم.",
        _ => "اختر يومًا متاحًا لتنفيذ الخدمة."
    };
    private string AppointmentRequiredMessage => serviceType switch
    {
        ServiceRequestType.PharmacyMedication => "اختر يوم استلام العلاج.",
        ServiceRequestType.LaboratoryTest => "اختر يوم إجراء التحاليل.",
        ServiceRequestType.RadiologyScan => "اختر يوم إجراء الأشعة.",
        _ => "اختر يوم تنفيذ الخدمة."
    };
    private string PageTitleText => ServiceTitle;
    private string ServiceTitle => HealthcareUiService.ServiceTypeAr(serviceType);
    private string ServiceIcon => HealthcareUiService.ServiceTypeIcon(serviceType);
    private string ServiceEnglishName => serviceType switch { ServiceRequestType.PharmacyMedication => "Pharmacy", ServiceRequestType.LaboratoryTest => "Laboratory", ServiceRequestType.RadiologyScan => "Radiology", _ => "Health Service" };
    private string ProviderSelectionTitle => serviceType switch { ServiceRequestType.PharmacyMedication => "اختر الصيدلية", ServiceRequestType.LaboratoryTest => "اختر معمل التحاليل", ServiceRequestType.RadiologyScan => "اختر مركز الأشعة", _ => "اختر الجهة" };
    private string ServiceHelpText => serviceType switch { ServiceRequestType.PharmacyMedication => "يمكنك طلب صرف علاج بعد إرفاق الروشتة أو التقرير الطبي.", ServiceRequestType.LaboratoryTest => "اكتب أسماء التحاليل المطلوبة وارفق تحويل الطبيب إن وجد.", ServiceRequestType.RadiologyScan => "اكتب نوع الأشعة والمنطقة المطلوبة وارفق تحويل الطبيب إن وجد.", _ => "" };
    private string DetailsPrompt => serviceType switch { ServiceRequestType.PharmacyMedication => "اكتب أسماء الأدوية والجرعات الموجودة في الروشتة.", ServiceRequestType.LaboratoryTest => "اكتب أسماء التحاليل وأي تعليمات مثل الصيام.", ServiceRequestType.RadiologyScan => "اكتب نوع الأشعة والمنطقة المطلوب تصويرها.", _ => "اكتب تفاصيل الطلب." };
    private string DetailsPlaceholder => serviceType switch { ServiceRequestType.PharmacyMedication => "مثال: أملوديبين 5 مجم، عبوة واحدة...", ServiceRequestType.LaboratoryTest => "مثال: صورة دم كاملة، سكر صائم، وظائف كبد...", ServiceRequestType.RadiologyScan => "مثال: أشعة سينية على الركبة اليمنى...", _ => "اكتب التفاصيل..." };
    private string DocumentHelpText => serviceType switch { ServiceRequestType.PharmacyMedication => "ارفع الروشتة أو التقرير الطبي، ويمكن إضافة صورة البطاقة.", ServiceRequestType.LaboratoryTest => "ارفع طلب التحاليل أو التقرير الطبي، ويمكن إضافة صورة البطاقة.", ServiceRequestType.RadiologyScan => "ارفع طلب الأشعة أو التقرير الطبي، ويمكن إضافة صورة البطاقة.", _ => "ارفع مستندًا داعمًا." };

    protected override async Task OnParametersSetAsync()
    {
        initialLoading = true;
        message = null;

        if (!Enum.TryParse<ServiceRequestType>(Type, true, out serviceType) || !IsValidService)
        {
            initialLoading = false;
            return;
        }

        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
        var user = string.IsNullOrWhiteSpace(userId) ? null : await UserManager.FindByIdAsync(userId);
        profileName = user?.FullNameAr ?? auth.User.Identity?.Name ?? "مستفيد";
        profilePhone = user?.PhoneNumber;
        providers = await Ui.GetActivePartnerAccountsAsync(serviceType);

        if (!string.IsNullOrWhiteSpace(ProviderQuery))
        {
            var requestedProvider = providers.FirstOrDefault(
                p => p.UserId == ProviderQuery);

            if (requestedProvider is not null)
            {
                await SelectProvider(requestedProvider);
            }
        }

        initialLoading = false;
    }

    private async Task SelectProvider(PartnerAccountOption provider)
    {
        if (provider.IsFull)
        {
            messageOk = false;
            message = "اكتمل عدد الطلبات اليومية لهذه الجهة. اختر جهة أخرى.";
            return;
        }

        selectedProviderId = provider.UserId;
        selectedAppointmentDate = null;
        availableDays = [];
        message = null;

        if (RequiresAppointmentDate)
        {
            loadingDays = true;
            try { availableDays = await Ui.GetPartnerAvailableDaysAsync(provider.UserId, serviceType); }
            finally { loadingDays = false; }
        }
    }

    private void SelectAppointmentDay(PartnerAvailableDay day)
    {
        if (day.IsFull) return;
        selectedAppointmentDate = day.Date;
        message = null;
    }

    private static string ProviderAddress(PartnerAccountOption provider)
    {
        var parts = new[] { provider.Governorate, provider.City, provider.AddressAr }
            .Where(x => !string.IsNullOrWhiteSpace(x));
        var text = string.Join(" - ", parts);
        return string.IsNullOrWhiteSpace(text) ? "العنوان غير مسجل" : text;
    }

    private void HandleFilesSelected(List<PendingFile> files)
    {
        foreach (var file in files)
        {
            if (!pendingFiles.Any()) file.DocumentType = DocumentType.MedicalReport;
            pendingFiles.Add(file);
        }
        message = null;
    }

    private void RemoveFile(PendingFile file) => pendingFiles.Remove(file);

    private async Task SubmitRequest()
    {
        message = null;
        messageOk = false;

        if (string.IsNullOrWhiteSpace(profileName)) { message = "الاسم الكامل مطلوب."; return; }
        if (string.IsNullOrWhiteSpace(selectedProviderId)) { message = "يجب اختيار الجهة التي ستقدم الخدمة."; return; }
        if (RequiresAppointmentDate && selectedAppointmentDate is null) { message = AppointmentRequiredMessage; return; }
        if (string.IsNullOrWhiteSpace(descriptionAr)) { message = "يجب كتابة تفاصيل الطلب."; return; }
        if (!pendingFiles.Any()) { message = "يجب رفع روشتة أو تقرير أو مستند داعم واحد على الأقل."; return; }
        if (string.IsNullOrWhiteSpace(userId)) { message = "تعذر قراءة المستخدم الحالي."; return; }

        saving = true;
        try
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user is null) { message = "تعذر العثور على حساب المستخدم."; return; }
            user.FullNameAr = profileName.Trim();
            user.PhoneNumber = string.IsNullOrWhiteSpace(profilePhone) ? null : profilePhone.Trim();
            user.UpdatedAt = DateTime.UtcNow;
            var update = await UserManager.UpdateAsync(user);
            if (!update.Succeeded) { message = string.Join(" | ", update.Errors.Select(e => e.Description)); return; }

            var result = await Ui.SubmitPartnerServiceRequestAsync(userId, serviceType, selectedProviderId, descriptionAr, selectedAppointmentDate);
            if (!result.Succeeded || result.EntityId is null) { message = result.Message; return; }

            foreach (var file in pendingFiles)
            {
                var upload = await Mediator.Send(new UploadDocumentCommand(result.EntityId.Value, userId, file.Stream, file.Name, file.Size, file.DocumentType));
                if (!upload.Succeeded)
                {
                    await Ui.CancelNewPartnerServiceRequestAsync(result.EntityId.Value, userId);
                    message = $"تعذر رفع الملف {file.Name}، ولم يتم حفظ الطلب. حاول مرة أخرى.";
                    return;
                }
            }

            messageOk = true;
            message = "تم إرسال الطلب بنجاح.";
            await Task.Delay(500);
            Nav.NavigateTo("/portal/requests", forceLoad: true);
        }
        catch
        {
            message = "حدث خطأ أثناء إرسال الطلب. حاول مرة أخرى.";
        }
        finally
        {
            saving = false;
        }
    }

    private static string FormatWorkingDays(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "جميع الأيام";
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        { ["Sat"]="السبت", ["Sun"]="الأحد", ["Mon"]="الاثنين", ["Tue"]="الثلاثاء", ["Wed"]="الأربعاء", ["Thu"]="الخميس", ["Fri"]="الجمعة" };
        return string.Join("، ", value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(x => map.GetValueOrDefault(x, x)));
    }

    private static string DiscountText(decimal value) => $"{Math.Clamp(value, 0m, 100m):0.##}%";
    private static string FormatSize(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024} KB" : $"{bytes / (1024 * 1024):F1} MB";
}
