@page "/portal/request/service/{Type}"
@attribute [Authorize(Roles = "Beneficiary")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using CharityHealth.Application.Features.Requests.Commands
@using CharityHealth.Domain.Entities
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services
@using MediatR

@inject HealthcareUiService Ui
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject IMediator Mediator
@inject NavigationManager Nav

<PageTitle>@PageTitleText</PageTitle>

<div class="partner-request-page" dir="rtl">
    <header class="partner-request-head">
        <button type="button" class="partner-back" @onclick='() => Nav.NavigateTo("/portal/request/new")'>›</button>
        <div>
            <div class="partner-kicker">@ServiceIcon @ServiceEnglishName</div>
            <h1>@ServiceTitle</h1>
            <p>اختر الجهة، اكتب تفاصيل احتياجك، وارفع المستند الداعم ليتم مراجعته من الإدارة.</p>
        </div>
    </header>

    @if (initialLoading)
    {
        <section class="partner-state">جارٍ تحميل الجهات المتاحة...</section>
    }
    else if (!IsValidService)
    {
        <section class="partner-alert bad">نوع الخدمة غير صحيح.</section>
    }
    else
    {
        <section class="partner-layout">
            <aside class="partner-side">
                <article class="partner-side-card">
                    <span>@ServiceIcon</span>
                    <h3>@ServiceTitle</h3>
                    <p>@ServiceHelpText</p>
                </article>

                <article class="partner-side-card secure">
                    <span>🛡️</span>
                    <h3>الطلب تحت المراجعة</h3>
                    <p>لن يتم تنفيذ الخدمة إلا بعد موافقة الإدارة وظهور QR في حسابك.</p>
                </article>
            </aside>

            <main class="partner-form-card">
                <section class="partner-section">
                    <div class="partner-section-title">
                        <div>
                            <h2>بيانات المستفيد</h2>
                            <p>راجع الاسم ورقم الهاتف قبل إرسال الطلب.</p>
                        </div>
                        <span>1</span>
                    </div>

                    <div class="partner-grid two">
                        <label>
                            <span>الاسم الكامل *</span>
                            <input @bind="profileName" @bind:event="oninput" />
                        </label>
                        <label>
                            <span>رقم الهاتف</span>
                            <input @bind="profilePhone" @bind:event="oninput" dir="ltr" />
                        </label>
                    </div>
                </section>

                <section class="partner-section">
                    <div class="partner-section-title">
                        <div>
                            <h2>@ProviderSelectionTitle</h2>
                            <p>الجهات الظاهرة هنا هي الجهات التي أضافها الأدمن وقام بتفعيلها.</p>
                        </div>
                        <span>2</span>
                    </div>

                    @if (!providers.Any())
                    {
                        <div class="partner-empty">لا توجد جهات متاحة لهذا النوع حاليًا. تواصل مع الإدارة.</div>
                    }
                    else
                    {
                        <div class="provider-grid">
                            @foreach (var provider in providers)
                            {
                                <button type="button"
                                        disabled="@provider.IsFull"
                                        class="provider-card @(selectedProviderId == provider.UserId ? "selected" : "") @(provider.IsFull ? "full" : "")"
                                        @onclick="() => SelectProvider(provider)">
                                    <span class="provider-icon">@ServiceIcon</span>
                                    <div class="provider-main-info">
                                        <strong>@provider.NameAr</strong>
                                        <small>📍 @ProviderAddress(provider)</small>
                                        <small>📞 @provider.PhoneNumber</small>
                                        @if (!string.IsNullOrWhiteSpace(provider.WorkingHours))
                                        {
                                            <small>🕘 @provider.WorkingHours</small>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(provider.WorkingDays))
                                        {
                                            <small>📅 أيام العمل: @FormatWorkingDays(provider.WorkingDays)</small>
                                        }
                                        @if (provider.DiscountPercentage > 0)
                                        {
                                            <div class="provider-discount">🎁 خصم للمستفيد <strong>@DiscountText(provider.DiscountPercentage)</strong></div>
                                        }
                                        <div class="provider-slots">
                                            <span>السعة لكل يوم: @provider.DailyCapacity طلب</span>
                                            <b class="open">اختر اليوم المتاح</b>
                                        </div>
                                    </div>
                                    <i>@(provider.IsFull ? "غير متاح" : selectedProviderId == provider.UserId ? "✓" : "عرض الأيام")</i>
                                </button>
                            }
                        </div>
                    }
                </section>

                @if (RequiresAppointmentDate && !string.IsNullOrWhiteSpace(selectedProviderId))
                {
                    <section class="partner-section">
                        <div class="partner-section-title">
                            <div>
                                <h2>@AppointmentSectionTitle</h2>
                                <p>@AppointmentSectionHelp</p>
                            </div>
                            <span>3</span>
                        </div>

                        @if (loadingDays)
                        {
                            <div class="partner-empty">جارٍ تحميل الأيام المتاحة...</div>
                        }
                        else if (!availableDays.Any())
                        {
                            <div class="partner-empty">لا توجد أيام متاحة لهذا المعمل خلال الفترة القادمة.</div>
                        }
                        else
                        {
                            <div class="partner-days-grid">
                                @foreach (var day in availableDays)
                                {
                                    <button type="button"
                                            disabled="@day.IsFull"
                                            class="partner-day-card @(selectedAppointmentDate == day.Date ? "selected" : "") @(day.IsFull ? "full" : "")"
                                            @onclick="() => SelectAppointmentDay(day)">
                                        <strong>@day.DayNameAr</strong>
                                        <span>@day.Date.ToString("yyyy/MM/dd")</span>
                                        <small>@(day.IsFull ? "مكتمل" : $"متاح {day.RemainingRequests} من {day.DailyCapacity}")</small>
                                    </button>
                                }
                            </div>
                        }
                    </section>
                }

                <section class="partner-section">
                    <div class="partner-section-title">
                        <div>
                            <h2>تفاصيل الطلب</h2>
                            <p>@DetailsPrompt</p>
                        </div>
                        <span>4</span>
                    </div>

                    <textarea @bind="descriptionAr"
                              @bind:event="oninput"
                              maxlength="2000"
                              rows="6"
                              placeholder="@DetailsPlaceholder"></textarea>
                    <div class="partner-count">@(descriptionAr?.Length ?? 0) / 2000</div>
                </section>

                <section class="partner-section">
                    <div class="partner-section-title">
                        <div>
                            <h2>المستندات</h2>
                            <p>@DocumentHelpText</p>
                        </div>
                        <span>5</span>
                    </div>

                    <DocumentUploader OnFilesSelected="HandleFilesSelected" />

                    @if (pendingFiles.Any())
                    {
                        <div class="partner-files">
                            @foreach (var file in pendingFiles)
                            {
                                <div class="partner-file-row">
                                    <span>📎</span>
                                    <div>
                                        <strong>@file.Name</strong>
                                        <small>@FormatSize(file.Size)</small>
                                    </div>
                                    <select value="@file.DocumentType"
                                            @onchange="e => file.DocumentType = Enum.Parse<DocumentType>(e.Value!.ToString()!)">
                                        <option value="@DocumentType.NationalId">بطاقة هوية</option>
                                        <option value="@DocumentType.MedicalReport">روشتة / تقرير / تحويل</option>
                                        <option value="@DocumentType.IncomeProof">إثبات دخل</option>
                                        <option value="@DocumentType.Other">مستند آخر</option>
                                    </select>
                                    <button type="button" @onclick="() => RemoveFile(file)">✕</button>
                                </div>
                            }
                        </div>
                    }
                </section>

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="partner-alert @(messageOk ? "ok" : "bad")">@message</div>
                }

                <footer class="partner-actions">
                    <button type="button" class="secondary" disabled="@saving" @onclick='() => Nav.NavigateTo("/portal/request/new")'>إلغاء</button>
                    <button type="button" class="primary" disabled="@(saving || !providers.Any(x => !x.IsFull) || (RequiresAppointmentDate && selectedAppointmentDate is null))" @onclick="SubmitRequest">
                        @(saving ? "جارٍ إرسال الطلب..." : "إرسال الطلب للإدارة")
                    </button>
                </footer>
            </main>
        </section>
    }
</div>

<style>
