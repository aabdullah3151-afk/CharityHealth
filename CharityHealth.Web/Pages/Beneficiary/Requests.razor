
@page "/portal/requests"
@attribute [Authorize(Roles = "Beneficiary")]
@inject HealthcareUiService Ui
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@using System.Security.Claims
@using CharityHealth.Web.Shared.Components

<PageTitle>طلباتي</PageTitle>
<div class="page-head"><div><span class="eyebrow">📁 My Requests</span><h2>كل طلباتي</h2><p>متابعة الحالة والقرار والملاحظات.</p></div><button class="ui-btn primary" @onclick='() => Nav.NavigateTo("/portal/request/new")'>طلب جديد</button></div>
<section class="ui-card"><div class="request-cards">@foreach(var r in rows){<article class="request-card"><div class="request-main"><div class="avatar-circle">🏥</div><div><h3>@r.SpecialtyName</h3><p>@r.DescriptionAr</p><small>@r.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div></div><StatusPill Text="@r.StatusAr" Tone="@r.StatusCss" />@if(r.HasQrCode){<div class="qr-mini">🎟️ QR جاهز</div>}<button class="mini-btn" @onclick='() => Nav.NavigateTo($"/portal/request/{r.Id}")'>فتح</button></article>}</div>@if(rows.Count==0){<div class="empty-state">📭 لا توجد طلبات</div>}</section>
@code{private List<RequestWorkItem> rows=[]; protected override async Task OnInitializedAsync(){var auth=await AuthState.GetAuthenticationStateAsync(); var uid=auth.User.FindFirstValue(ClaimTypes.NameIdentifier)??""; rows=await Ui.GetBeneficiaryRequestsAsync(uid);}}
