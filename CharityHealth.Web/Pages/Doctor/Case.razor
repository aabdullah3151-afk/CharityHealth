@page "/doctor/case/{RequestId:guid}"
@layout MainLayout
@attribute [Authorize(Roles = "Doctor")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services

@inject HealthcareUiService Ui
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>تفاصيل الحالة</PageTitle>

<div class="doctor-case-page" dir="rtl">
    <header class="head">
        <button type="button" @onclick='() => Nav.NavigateTo("/doctor/dashboard")'>›</button>
        <div>
            <span>Doctor Case</span>
            <h1>تفاصيل الحالة والمعاينة</h1>
            <p>يمكن استكمال الحالة مباشرة من هنا، ومسح QR يظل طريقة اختيارية.</p>
        </div>
    </header>

    @if (loading)
    {
        <section class="state">جارٍ تحميل الحالة...</section>
    }
    else if (caseData is null)
    {
        <section class="error">@message</section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="message @(success ? "ok" : "bad")">@message</div>
        }

        <section class="layout">
            <div class="main">
                <article class="card">
                    <div class="title">
                        <div>
                            <h2>@caseData.BeneficiaryName</h2>
                            <p>@caseData.SpecialtyName · @RequestCode(caseData.Id)</p>
                        </div>
                        <span class="@StatusClass(caseData.Status)">@caseData.StatusAr</span>
                    </div>

                    <div class="info">
                        <div><span>الهاتف</span><strong>@Safe(caseData.BeneficiaryPhone)</strong></div>
                        <div><span>المدينة</span><strong>@Safe(caseData.City)</strong></div>
                        <div><span>موعد الحالة</span><strong>@(caseData.AppointmentDate?.ToString("dd/MM/yyyy") ?? "غير محدد")</strong></div>
                        <div><span>تاريخ الطلب</span><strong>@caseData.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
                    </div>

                    <div class="description">
                        <span>وصف الحالة</span>
                        <p>@Safe(caseData.DescriptionAr, "لا يوجد وصف مرفق.")</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(caseData.ReviewNoteAr))
                    {
                        <div class="note">
                            <span>ملاحظات الطلب</span>
                            <p>@caseData.ReviewNoteAr</p>
                        </div>
                    }
                </article>

                <article class="card">
                    <div class="title"><div><h2>المستندات المرفقة</h2><p>@caseData.Documents.Count مستند</p></div></div>
                    @if (caseData.Documents.Count == 0)
                    {
                        <div class="empty-docs">لا توجد مستندات مرفقة.</div>
                    }
                    else
                    {
                        <div class="docs">
                            @foreach (var document in caseData.Documents)
                            {
                                <a href="@DocumentUrl(document.FilePath)" target="_blank" rel="noopener">
                                    <span>📄</span>
                                    <div><strong>@document.FileName</strong><small>@FileSizeText(document.FileSizeBytes)</small></div>
                                    <b>فتح</b>
                                </a>
                            }
                        </div>
                    }
                </article>
            </div>

            <aside class="editor">
                <h2>@(caseData.Status == RequestStatus.Completed ? "معاينة أو تعديل النتيجة" : "استكمال بيانات المعاينة")</h2>
                <p>الحفظ المباشر لا يحتاج مسح الباركود.</p>

                <label>التشخيص أو نتيجة المعاينة <em>*</em></label>
                <textarea @bind="diagnosis" rows="6" disabled="@(!CanEdit)" placeholder="اكتب التشخيص ونتيجة الكشف..."></textarea>

                <label>العلاج والتوصيات</label>
                <textarea @bind="recommendations" rows="5" disabled="@(!CanEdit)" placeholder="اكتب العلاج والجرعات والتوصيات..."></textarea>

                <label>ملاحظات الطبيب</label>
                <textarea @bind="notes" rows="4" disabled="@(!CanEdit)" placeholder="أي ملاحظات إضافية..."></textarea>

                @if (!CanEdit)
                {
                    <div class="waiting">الحالة ما زالت قيد مراجعة الإدارة، ويمكن استكمالها بعد اعتمادها.</div>
                }
                else
                {
                    <button type="button" class="save" disabled="@saving" @onclick="Save">
                        @(saving ? "جارٍ الحفظ..." : caseData.Status == RequestStatus.Completed ? "حفظ التعديلات" : "حفظ المعاينة وإكمال الحالة")
                    </button>
                }

                @if (caseData.Status == RequestStatus.Approved && caseData.HasQrCode)
                {
                    <button type="button" class="qr" @onclick='() => Nav.NavigateTo("/doctor/scan")'>استخدام QR بدلًا من الحفظ المباشر</button>
                }

                @if (caseData.ConsultedAt is not null)
                {
                    <small>آخر حفظ: @caseData.ConsultedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                }
            </aside>
        </section>
    }
</div>

<style>
