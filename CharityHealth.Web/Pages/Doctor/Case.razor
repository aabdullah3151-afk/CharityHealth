columns:38px 1fr auto;gap:9px;align-items:center;text-decoration:none;color:#334155}.docs a>span{font-size:23px}.docs strong{display:block;font-size:12px}.docs small{display:block;margin-top:4px;color:#94a3b8;font-size:10px}.docs b{color:#05a843;font-size:11px}.empty-docs{margin-top:16px;border-radius:15px;background:#f8fafc;padding:20px;text-align:center;color:#94a3b8;font-weight:850}.editor{position:sticky;top:92px}.editor h2{margin:0;font-size:20px;font-weight:950}.editor>p{margin:6px 0 0;color:#94a3b8;font-size:12px;font-weight:850}.editor label{display:block;margin:16px 0 7px;color:#344054;font-size:12px;font-weight:950}.editor em{color:#dc2626;font-style:normal}.editor textarea{width:100%;border:1px solid #e5e7eb;border-radius:15px;background:#f8fafc;padding:12px 14px;font:inherit;font-size:13px;font-weight:800;resize:vertical;outline:none}.editor textarea:disabled{opacity:.7}.save,.qr{width:100%;min-height:47px;margin-top:14px;border:0;border-radius:999px;font-weight:950;cursor:pointer}.save{background:#05a843;color:#fff}.qr{background:#ecfdf3;color:#047857}.waiting{margin-top:15px;border-radius:15px;background:#fff7ed;color:#9a3412;padding:13px;font-size:12px;line-height:1.8;font-weight:850}.editor small{display:block;margin-top:12px;text-align:center;color:#94a3b8}.message,.state,.error{margin-top:18px;border-radius:17px;padding:15px 18px;font-weight:900}.message.ok{background:#ecfdf3;color:#047857}.message.bad,.error{background:#fef2f2;color:#991b1b}.state{background:#fff;color:#64748b}@@media(max-width:950px){.layout{grid-template-columns:1fr}.editor{position:static}}@@media(max-width:650px){.doctor-case-page{padding:18px 12px}.head{padding:22px 18px}.head h1{font-size:25px}.info{grid-template-columns:1fr}}
</style>

@code {
    [Parameter] public Guid RequestId { get; set; }

    private bool loading = true;
    private bool saving;
    private bool success;
    private string? message;
    private string doctorUserId = string.Empty;
    private string diagnosis = string.Empty;
    private string recommendations = string.Empty;
    private string notes = string.Empty;
    private DoctorCaseDetailsDto? caseData;

    private bool CanEdit => caseData?.Status is RequestStatus.Approved or RequestStatus.Completed;

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            doctorUserId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

            if (string.IsNullOrWhiteSpace(doctorUserId))
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            caseData = await Ui.GetDoctorCaseAsync(RequestId, doctorUserId);
            if (caseData is null)
            {
                message = "الحالة غير موجودة أو غير مخصصة لحساب الطبيب الحالي.";
                return;
            }

            diagnosis = caseData.DiagnosisAr ?? string.Empty;
            recommendations = caseData.RecommendationsAr ?? string.Empty;
            notes = caseData.NotesAr ?? string.Empty;
        }
        catch
        {
            message = "حدث خطأ أثناء تحميل بيانات الحالة.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Save()
    {
        saving = true;
        message = null;
        success = false;

        try
        {
            var result = await Ui.SaveDoctorCaseAsync(
                RequestId,
                doctorUserId,
                new DoctorCaseInput(diagnosis, recommendations, notes));

            success = result.Succeeded;
            message = result.Message;

            if (result.Succeeded)
            {
                await Load();
                success = true;
                message = result.Message;
            }
        }
        catch
        {
            message = "تعذر حفظ بيانات المعاينة حاليًا.";
        }
        finally
        {
            saving = false;
        }
    }

    private static string RequestCode(Guid id) => $"REQ-{id.ToString("N")[..6].ToUpperInvariant()}";
    private static string StatusClass(RequestStatus status) => status switch { RequestStatus.Approved => "approved", RequestStatus.Completed => "completed", _ => "pending" };
    private static string Safe(string? value, string fallback = "غير محدد") => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string FileSizeText(long bytes) => bytes < 1024 * 1024 ? $"{bytes / 1024d:0.#} KB" : $"{bytes / 1024d / 1024d:0.##} MB";

    private static string DocumentUrl(string path)
    {
        var value = (path ?? string.Empty).Trim().Replace("\\", "/");
        if (value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("https://", StringComparison.OrdinalIgnoreCase) || value.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase)) return value;
        if (value.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase)) return "/" + value;
        return "/uploads/" + value.TrimStart('/');
    }
}
