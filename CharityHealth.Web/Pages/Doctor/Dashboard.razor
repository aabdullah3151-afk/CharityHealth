@page "/doctor/dashboard"
@layout MainLayout
@attribute [Authorize(Roles = "Doctor")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services

@inject HealthcareUiService Ui
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>لوحة الطبيب</PageTitle>

<div class="doctor-dashboard-page" dir="rtl">
    <header class="hero">
        <div>
            <span>Doctor Workspace</span>
            <h1>لوحة الطبيب</h1>
            <p>حالات اليوم وكل الحالات المحولة إليك. افتح الحالة وسجل المعاينة مباشرة، أو استخدم QR كطريقة اختيارية.</p>
        </div>
        <button type="button" @onclick='() => Nav.NavigateTo("/doctor/scan")'>مسح QR اختياري</button>
    </header>

    @if (loading)
    {
        <section class="state">جارٍ تحميل الحالات...</section>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <section class="error">@error</section>
    }
    else
    {
        <section class="stats">
            <article><span>حالات اليوم</span><strong>@TodayCount</strong><small>تشمل المكتملة اليوم</small></article>
            <article><span>جاهزة للمعاينة</span><strong>@ReadyCount</strong><small>تم اعتمادها من الإدارة</small></article>
            <article>
                <span>إجمالي المكتمل</span>
                <strong>@TotalCompletedCount</strong>
                <small>يشمل الكشف المسجل يدويًا بواسطة الإدارة</small>
            </article>
            <article><span>كل الحالات</span><strong>@queue.Count</strong><small>السجل الكامل للطبيب</small></article>
        </section>

        <section class="toolbar">
            <div class="tabs">
                <button class="@(filter == CaseFilter.Today ? "active" : "")" @onclick="() => filter = CaseFilter.Today">اليوم <b>@TodayCount</b></button>
                <button class="@(filter == CaseFilter.Ready ? "active" : "")" @onclick="() => filter = CaseFilter.Ready">جاهزة <b>@ReadyCount</b></button>
                <button class="@(filter == CaseFilter.Upcoming ? "active" : "")" @onclick="() => filter = CaseFilter.Upcoming">قادمة <b>@UpcomingCount</b></button>
                <button class="@(filter == CaseFilter.Completed ? "active" : "")" @onclick="() => filter = CaseFilter.Completed">مكتملة إلكترونيًا <b>@ElectronicCompletedCount</b></button>
                <button class="@(filter == CaseFilter.All ? "active" : "")" @onclick="() => filter = CaseFilter.All">الكل <b>@queue.Count</b></button>
            </div>

            <label class="search">
                <span>🔎</span>
                <input @bind="search" @bind:event="oninput" placeholder="ابحث باسم المستفيد أو الهاتف أو التخصص..." />
            </label>
        </section>

        @if (!FilteredCases.Any())
        {
            <section class="empty"><div>🩺</div><h2>لا توجد حالات مطابقة</h2><p>الحالات التي تعتمدها الإدارة وتخصصها لك ستظهر هنا.</p></section>
        }
        else
        {
            <section class="grid">
                @foreach (var item in FilteredCases)
                {
                    <article class="case">
                        <div class="case-head">
                            <div class="avatar">@Initial(item.BeneficiaryName)</div>
                            <div>
                                <h2>@item.BeneficiaryName</h2>
                                <p>@RequestCode(item.Id) · @item.SpecialtyName</p>
                            </div>
                            <span class="status @StatusClass(item.Status)">@item.StatusAr</span>
                        </div>

                        <div class="info">
                            <div><span>الهاتف</span><strong>@Safe(item.BeneficiaryPhone)</strong></div>
                            <div><span>المدينة</span><strong>@Safe(item.City)</strong></div>
                            <div><span>موعد الحالة</span><strong>@AppointmentText(item)</strong></div>
                            <div><span>تاريخ الطلب</span><strong>@item.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
                        </div>

                        <div class="description">
                            <span>وصف الحالة</span>
                            <p>@ShortText(item.DescriptionAr)</p>
                        </div>

                        <div class="actions">
                            <button type="button" class="primary" @onclick='() => Nav.NavigateTo($"/doctor/case/{item.Id}")'>
                                @(item.Status == RequestStatus.Completed
                                    ? "معاينة أو تعديل النتيجة"
                                    : item.Status == RequestStatus.Approved
                                        ? "بدء المعاينة واستكمال البيانات"
                                        : "عرض الحالة")
                            </button>

                            @if (item.Status == RequestStatus.Approved && item.HasQrCode)
                            {
                                <button type="button" class="secondary" @onclick='() => Nav.NavigateTo("/doctor/scan")'>QR اختياري</button>
                            }
                        </div>
                    </article>
                }
            </section>
        }
    }
</div>

<style>
