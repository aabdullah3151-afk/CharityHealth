@page "/doctor/dashboard"
@layout MainLayout
@attribute [Authorize(Roles = "Doctor")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services

@inject HealthcareUiService Ui
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>لوحة الطبيب</PageTitle>

<div class="doctor-home-page" dir="rtl" style="padding:32px;min-height:calc(100vh - 80px);background:#f8fafc;">
    <section style="
        border-radius:34px;
        padding:34px;
        margin-bottom:24px;
        background:linear-gradient(135deg,#05a843,#0f9f93);
        color:#fff;
        box-shadow:0 22px 48px rgba(5,168,67,.22);">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;">
            <div>
                <div style="font-size:14px;font-weight:900;color:rgba(255,255,255,.82);margin-bottom:8px;">Doctor Workspace</div>
                <h1 style="margin:0;font-size:36px;font-weight:950;color:#fff;">لوحة الطبيب</h1>
                <p style="margin:10px 0 0;font-size:16px;font-weight:800;color:rgba(255,255,255,.86);">
                    هنا الطبيب يشوف الحالات المعتمدة ويمسح QR ويسجل نتيجة الكشف فقط.
                </p>
            </div>

            <button type="button"
                    @onclick='() => Nav.NavigateTo("/doctor/scan")'
                    style="
                        border:0;
                        border-radius:999px;
                        min-height:50px;
                        padding:0 22px;
                        background:#fff;
                        color:#05a843;
                        font-size:15px;
                        font-weight:950;
                        cursor:pointer;
                        box-shadow:0 14px 26px rgba(15,23,42,.16);">
                مسح QR
            </button>
        </div>
    </section>

    @if (loading)
    {
        <div style="border-radius:26px;background:#fff;border:1px solid #e5e7eb;padding:26px;font-weight:900;color:#64748b;">
            جارٍ تحميل بيانات الطبيب...
        </div>
    }
    else
    {
        <section style="
            display:grid;
            grid-template-columns:repeat(3,minmax(0,1fr));
            gap:16px;
            margin-bottom:24px;">
            <article style="border-radius:26px;background:#fff;border:1px solid #e5e7eb;padding:24px;box-shadow:0 12px 28px rgba(15,23,42,.06);">
                <div style="font-size:13px;font-weight:900;color:#94a3b8;margin-bottom:8px;">حالات في الانتظار</div>
                <strong style="font-size:34px;color:#111827;font-weight:950;">@pendingCount</strong>
            </article>

            <article style="border-radius:26px;background:#fff;border:1px solid #e5e7eb;padding:24px;box-shadow:0 12px 28px rgba(15,23,42,.06);">
                <div style="font-size:13px;font-weight:900;color:#94a3b8;margin-bottom:8px;">حالات معتمدة</div>
                <strong style="font-size:34px;color:#05a843;font-weight:950;">@approvedCount</strong>
            </article>

            <article style="border-radius:26px;background:#fff;border:1px solid #e5e7eb;padding:24px;box-shadow:0 12px 28px rgba(15,23,42,.06);">
                <div style="font-size:13px;font-weight:900;color:#94a3b8;margin-bottom:8px;">إجمالي ظاهر للطبيب</div>
                <strong style="font-size:34px;color:#2563eb;font-weight:950;">@queue.Count</strong>
            </article>
        </section>

        <section style="border-radius:30px;background:#fff;border:1px solid #e5e7eb;box-shadow:0 16px 34px rgba(15,23,42,.06);overflow:hidden;">
            <div style="padding:22px 24px;border-bottom:1px solid #eef2f7;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;">
                <div>
                    <h2 style="margin:0;color:#111827;font-size:24px;font-weight:950;">الحالات المتاحة للطبيب</h2>
                    <p style="margin:8px 0 0;color:#64748b;font-size:14px;font-weight:800;">لا يوجد هنا إضافة أو تعديل أطباء. الإدارة فقط مسؤولة عن ذلك.</p>
                </div>

                <button type="button"
                        @onclick='() => Nav.NavigateTo("/doctor/scan")'
                        style="border:0;border-radius:999px;background:#ecfdf3;color:#05a843;min-height:42px;padding:0 18px;font-weight:950;cursor:pointer;">
                    فتح ماسح QR
                </button>
            </div>

            @if (queue.Count == 0)
            {
                <div style="padding:28px;text-align:center;color:#94a3b8;font-weight:900;">
                    لا توجد حالات متاحة حاليًا.
                </div>
            }
            else
            {
                <div style="overflow:auto;">
                    <table style="width:100%;border-collapse:collapse;min-width:760px;">
                        <thead>
                            <tr style="background:#f8fafc;color:#64748b;font-size:13px;font-weight:950;">
                                <th style="padding:16px;text-align:right;">المستفيد</th>
                                <th style="padding:16px;text-align:right;">التخصص</th>
                                <th style="padding:16px;text-align:right;">الهاتف</th>
                                <th style="padding:16px;text-align:right;">المدينة</th>
                                <th style="padding:16px;text-align:right;">الحالة</th>
                                <th style="padding:16px;text-align:right;">تاريخ الطلب</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in queue)
                            {
                                <tr style="border-top:1px solid #eef2f7;">
                                    <td style="padding:16px;font-weight:950;color:#111827;">@item.BeneficiaryName</td>
                                    <td style="padding:16px;font-weight:850;color:#334155;">@item.SpecialtyName</td>
                                    <td style="padding:16px;font-weight:850;color:#334155;">@item.BeneficiaryPhone</td>
                                    <td style="padding:16px;font-weight:850;color:#334155;">@item.City</td>
                                    <td style="padding:16px;">
                                        <span style="border-radius:999px;padding:7px 12px;background:#ecfdf3;color:#047857;font-weight:950;font-size:12px;">
                                            @item.StatusAr
                                        </span>
                                    </td>
                                    <td style="padding:16px;font-weight:850;color:#334155;">@item.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

@code {
    private bool loading = true;
    private List<RequestWorkItem> queue = [];
    private int pendingCount;
    private int approvedCount;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        queue = await Ui.GetDoctorQueueAsync(userId);
        pendingCount = queue.Count(x => x.Status == RequestStatus.UnderReview);
        approvedCount = queue.Count(x => x.Status == RequestStatus.Approved);

        loading = false;
    }
}
