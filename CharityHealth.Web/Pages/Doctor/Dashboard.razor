52px 1fr auto;gap:12px;align-items:center}.avatar{width:52px;height:52px;border-radius:18px;background:#ecfdf3;color:#05a843;display:grid;place-items:center;font-size:22px;font-weight:950}.case-head h2{margin:0;font-size:19px;font-weight:950}.case-head p{margin:5px 0 0;color:#94a3b8;font-size:11px;font-weight:850}.status{border-radius:999px;padding:7px 11px;font-size:11px;font-weight:950}.status.approved{background:#ecfdf3;color:#047857}.status.completed{background:#eff6ff;color:#1d4ed8}.status.pending{background:#fff7ed;color:#c2410c}.info{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:17px 0}.info div{border-radius:15px;background:#f8fafc;padding:12px}.info span,.description span{display:block;color:#94a3b8;font-size:10px;font-weight:900}.info strong{display:block;margin-top:6px;color:#334155;font-size:12px;font-weight:950}.description{border-radius:16px;background:#f8fafc;padding:14px}.description p{margin:7px 0 0;color:#64748b;font-size:12px;line-height:1.8;font-weight:800}.actions{display:flex;gap:9px;margin-top:15px}.actions button{border:0;border-radius:999px;min-height:44px;padding:0 17px;font-weight:950;cursor:pointer}.actions .primary{flex:1;background:#05a843;color:#fff}.actions .secondary{background:#ecfdf3;color:#047857}.state,.error,.empty{margin-top:22px;border:1px solid #e5e7eb;border-radius:28px;background:#fff;padding:30px;text-align:center;font-weight:900}.error{background:#fef2f2;color:#991b1b}.empty div{font-size:42px}.empty h2{margin:10px 0 5px}.empty p{color:#94a3b8}@@media(max-width:1000px){.stats{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}}@@media(max-width:650px){.doctor-dashboard-page{padding:18px 12px}.hero{padding:25px 20px;align-items:flex-start;flex-direction:column}.hero h1{font-size:29px}.stats{grid-template-columns:1fr 1fr}.search{width:100%;min-width:0}.case-head{grid-template-columns:48px 1fr}.case-head .status{grid-column:1/-1;width:max-content}.info{grid-template-columns:1fr}.actions{flex-direction:column}}
</style>

@code {
    private bool loading = true;
    private string? error;
    private string search = string.Empty;
    private CaseFilter filter = CaseFilter.Today;
    private List<RequestWorkItem> queue = [];

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private int TodayCount => queue.Count(IsToday);
    private int ReadyCount => queue.Count(x => x.Status == RequestStatus.Approved);
    private int ElectronicCompletedCount => queue.Count(x => x.Status == RequestStatus.Completed);
    private int totalCompletedCount;
    private int TotalCompletedCount => Math.Max(ElectronicCompletedCount, totalCompletedCount);
    private int UpcomingCount => queue.Count(x => x.AppointmentDate > Today && x.Status != RequestStatus.Completed);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (string.IsNullOrWhiteSpace(userId))
            {
                Nav.NavigateTo("/login", true);
                return;
            }

            queue = await Ui.GetDoctorQueueAsync(userId);

            totalCompletedCount =
                await Ui.GetDoctorCompletedServicesAsync(
                    userId);
        }
        catch
        {
            error = "حدث خطأ أثناء تحميل الحالات.";
        }
        finally
        {
            loading = false;
        }
    }

    private IEnumerable<RequestWorkItem> FilteredCases
    {
        get
        {
            IEnumerable<RequestWorkItem> result = filter switch
            {
                CaseFilter.Today => queue.Where(IsToday),
                CaseFilter.Ready => queue.Where(x => x.Status == RequestStatus.Approved),
                CaseFilter.Upcoming => queue.Where(x => x.AppointmentDate > Today && x.Status != RequestStatus.Completed),
                CaseFilter.Completed => queue.Where(x => x.Status == RequestStatus.Completed),
                _ => queue
            };

            if (!string.IsNullOrWhiteSpace(search))
            {
                var term = search.Trim();
                result = result.Where(x =>
                    Contains(x.BeneficiaryName, term) ||
                    Contains(x.BeneficiaryPhone, term) ||
                    Contains(x.SpecialtyName, term) ||
                    Contains(x.City, term) ||
                    Contains(x.DescriptionAr, term));
            }

            return result
                .OrderBy(x => x.AppointmentDate ?? DateOnly.MaxValue)
                .ThenByDescending(x => x.SubmittedAt);
        }
    }

    private bool IsToday(RequestWorkItem item) => item.AppointmentDate == Today;
    private static bool Contains(string? value, string term) => !string.IsNullOrWhiteSpace(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    private static string Initial(string value) => string.IsNullOrWhiteSpace(value) ? "؟" : value.Trim()[0].ToString();
    private static string Safe(string? value) => string.IsNullOrWhiteSpace(value) ? "غير محدد" : value;
    private static string RequestCode(Guid id) => $"REQ-{id.ToString("N")[..6].ToUpperInvariant()}";
    private static string StatusClass(RequestStatus status) => status switch { RequestStatus.Approved => "approved", RequestStatus.Completed => "completed", _ => "pending" };
    private static string ShortText(string? value) => string.IsNullOrWhiteSpace(value) ? "لا يوجد وصف مرفق." : value.Length <= 180 ? value : value[..180] + "...";
    private static string AppointmentText(RequestWorkItem item) => item.AppointmentDate is null ? "غير محدد" : item.AppointmentDate.Value == DateOnly.FromDateTime(DateTime.Today) ? "اليوم" : item.AppointmentDate.Value.ToString("dd/MM/yyyy");

    private enum CaseFilter { Today, Ready, Upcoming, Completed, All }
}
