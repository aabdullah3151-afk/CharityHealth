@page "/doctor/settings"
@layout MainLayout
@attribute [Authorize(Roles = "Doctor")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using CharityHealth.Domain.Entities
@using CharityHealth.Infrastructure.Persistence

@inject AppDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState

<PageTitle>إعدادات الطبيب</PageTitle>

<div class="doctor-settings-page" dir="rtl">
    <header class="doctor-settings-head">
        <span>🩺</span>
        <div><div>Doctor Settings</div><h1>إعدادات حساب الطبيب</h1><p>حدّث بيانات العيادة وأيام العمل وغيّر كلمة المرور.</p></div>
    </header>

    @if (loading)
    {
        <section class="doctor-settings-state">جارٍ تحميل الإعدادات...</section>
    }
    else if (doctor is null)
    {
        <section class="doctor-settings-message bad">تعذر العثور على ملف الطبيب.</section>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(profileMessage))
        {
            <div class="doctor-settings-message @(profileOk ? "ok" : "bad")">@profileMessage</div>
        }

        <section class="doctor-settings-card">
            <div class="doctor-settings-title"><span>👨‍⚕️</span><div><h2>البيانات المهنية</h2><p>التخصص والسعة اليومية يحددهما الأدمن.</p></div></div>
            <div class="doctor-settings-grid">
                <label><span>الاسم بالعربي *</span><input @bind="nameAr" @bind:event="oninput" /></label>
                <label><span>الاسم بالإنجليزي</span><input @bind="nameEn" @bind:event="oninput" dir="ltr" /></label>
                <label><span>البريد الإلكتروني</span><input value="@doctor.User.Email" readonly dir="ltr" /></label>
                <label><span>رقم الهاتف</span><input @bind="phone" @bind:event="oninput" dir="ltr" /></label>
                <label><span>رقم الرخصة</span><input @bind="license" @bind:event="oninput" /></label>
                <label><span>الحالة</span><select @bind="isAvailable"><option value="true">متاح</option><option value="false">غير متاح</option></select></label>
                <label><span>بداية وقت العمل</span><input type="time" value="@workStart" @onchange="OnWorkStartChanged" /></label>
                <label><span>نهاية وقت العمل</span><input type="time" value="@workEnd" @onchange="OnWorkEndChanged" /></label>
                <div class="wide doctor-settings-days">
                    <span>أيام العمل *</span>
                    <div>
                        @foreach (var day in Days)
                        {
                            <label><input type="checkbox" checked="@workingDays.Contains(day.Code)" @onchange="e => ToggleDay(day.Code, e)" /><b>@day.Name</b></label>
                        }
                    </div>
                </div>
                <label class="wide"><span>عنوان العيادة</span><textarea @bind="clinicAddress" @bind:event="oninput" rows="4"></textarea></label>
                <label class="wide"><span>ملاحظات</span><textarea @bind="notes" @bind:event="oninput" rows="4"></textarea></label>
            </div>
            <div class="doctor-readonly">
                <div><span>التخصص</span><strong>@doctor.Specialty.NameAr</strong></div>
                <div><span>السعة اليومية</span><strong>@doctor.MaxDailySlots طلب</strong></div>
            </div>
            <div class="doctor-settings-actions"><button type="button" disabled="@savingProfile" @onclick="SaveProfile">@(savingProfile ? "جارٍ الحفظ..." : "حفظ البيانات")</button></div>
        </section>

        @if (!string.IsNullOrWhiteSpace(passwordMessage))
        {
            <div class="doctor-settings-message @(passwordOk ? "ok" : "bad")">@passwordMessage</div>
        }

        <section class="doctor-settings-card">
            <div class="doctor-settings-title"><span>🔐</span><div><h2>تغيير كلمة المرور</h2><p>اكتب كلمة المرور الحالية والجديدة.</p></div></div>
            <div class="doctor-settings-grid password-grid">
                <label><span>كلمة المرور الحالية *</span><input type="password" @bind="currentPassword" dir="ltr" /></label>
                <label><span>كلمة المرور الجديدة *</span><input type="password" @bind="newPassword" dir="ltr" /></label>
                <label><span>تأكيد كلمة المرور *</span><input type="password" @bind="confirmPassword" dir="ltr" /></label>
            </div>
            <div class="doctor-settings-actions"><button type="button" disabled="@savingPassword" @onclick="ChangePassword">@(savingPassword ? "جارٍ التغيير..." : "تغيير كلمة المرور")</button></div>
        </section>
    }
</div>

<style>
.doctor-settings-page{min-height:calc(100vh - 76px);padding:34px;background:#f8fafc;color:#101828}.doctor-settings-head{border-radius:30px;background:linear-gradient(135deg,#05a843,#0f766e);color:#fff;padding:28px 30px;display:flex;align-items:center;gap:18px;box-shadow:0 20px 44px rgba(5,168,67,.2)}.doctor-settings-head>span{width:70px;height:70px;border-radius:23px;background:rgba(255,255,255,.18);display:grid;place-items:center;font-size:34px}.doctor-settings-head div>div{font-size:12px;font-weight:950;color:rgba(255,255,255,.75)}.doctor-settings-head h1{margin:5px 0 0;font-size:34px;font-weight:950}.doctor-settings-head p{margin:8px 0 0;color:rgba(255,255,255,.84);font-size:13px;font-weight:800}.doctor-settings-card{margin-top:22px;border:1px solid #e5e7eb;border-radius:28px;background:#fff;padding:26px;box-shadow:0 14px 34px rgba(15,23,42,.06)}.doctor-settings-title{display:flex;align-items:center;gap:12px;margin-bottom:22px}.doctor-settings-title>span{width:50px;height:50px;border-radius:17px;background:#ecfdf3;display:grid;place-items:center;font-size:24px}.doctor-settings-title h2{margin:0;font-size:22px;font-weight:950}.doctor-settings-title p{margin:5px 0 0;color:#98a2b3;font-size:12px;font-weight:800}.doctor-settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.doctor-settings-grid label{display:grid;gap:8px;color:#344054;font-size:13px;font-weight:900}.doctor-settings-grid input,.doctor-settings-grid select,.doctor-settings-grid textarea{width:100%;box-sizing:border-box;border:1px solid #e5e7eb;border-radius:16px;background:#f8fafc;padding:13px 15px;color:#111827;font:inherit;font-size:13px;font-weight:800;outline:none}.doctor-settings-grid input,.doctor-settings-grid select{height:52px}.doctor-settings-grid input[readonly]{background:#f1f5f9;color:#98a2b3}.doctor-settings-grid textarea{resize:vertical}.doctor-settings-grid .wide{grid-column:1/-1}.doctor-settings-days{display:grid;gap:9px;color:#344054;font-size:13px;font-weight:900}.doctor-settings-days>div{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}.doctor-settings-days label{border:1px solid #e5e7eb;border-radius:14px;background:#f8fafc;padding:11px 7px;display:flex;align-items:center;justify-content:center;gap:7px}.doctor-settings-days input{width:17px!important;height:17px!important;padding:0!important;accent-color:#05a843}.doctor-settings-days b{font-size:11px}.doctor-readonly{margin-top:18px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.doctor-readonly>div{border:1px solid #bbf7d0;border-radius:18px;background:#ecfdf3;padding:15px}.doctor-readonly span{display:block;color:#667085;font-size:11px;font-weight:850}.doctor-readonly strong{display:block;margin-top:6px;font-size:20px;font-weight:950}.doctor-settings-actions{margin-top:20px;display:flex;justify-content:flex-end}.doctor-settings-actions button{min-height:48px;border:0;border-radius:999px;background:#05a843;color:#fff;padding:0 25px;font-size:14px;font-weight:950;cursor:pointer}.doctor-settings-message,.doctor-settings-state{margin-top:18px;border-radius:18px;padding:15px 18px;font-size:13px;font-weight:900}.doctor-settings-message.ok{background:#ecfdf3;color:#047857}.doctor-settings-message.bad{background:#fef2f2;color:#991b1b}.doctor-settings-state{background:#fff;border:1px solid #e5e7eb;color:#667085}.password-grid{grid-template-columns:repeat(3,minmax(0,1fr))}@@media(max-width:900px){.doctor-settings-days>div{grid-template-columns:repeat(4,minmax(0,1fr))}.password-grid{grid-template-columns:1fr}}@@media(max-width:650px){.doctor-settings-page{padding:18px 12px}.doctor-settings-grid{grid-template-columns:1fr}.doctor-settings-grid .wide{grid-column:auto}.doctor-settings-days>div{grid-template-columns:repeat(2,minmax(0,1fr))}.doctor-readonly{grid-template-columns:1fr}}
</style>

@code {
    private bool loading = true;
    private bool savingProfile;
    private bool savingPassword;
    private bool profileOk;
    private bool passwordOk;
    private string? profileMessage;
    private string? passwordMessage;
    private Doctor? doctor;
    private string nameAr = string.Empty;
    private string? nameEn;
    private string? phone;
    private string? license;
    private string? clinicAddress;
    private string? notes;
    private bool isAvailable = true;
    private string? workStart;
    private string? workEnd;
    private HashSet<string> workingDays = [];
    private string? currentPassword;
    private string? newPassword;
    private string? confirmPassword;

    private readonly List<DayOption> Days =
    [
        new("Sat", "السبت"), new("Sun", "الأحد"), new("Mon", "الاثنين"),
        new("Tue", "الثلاثاء"), new("Wed", "الأربعاء"), new("Thu", "الخميس"), new("Fri", "الجمعة")
    ];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        doctor = string.IsNullOrWhiteSpace(userId) ? null : await Db.Doctors.Include(d => d.User).Include(d => d.Specialty).FirstOrDefaultAsync(d => d.UserId == userId && !d.IsDeleted);
        if (doctor is not null)
        {
            nameAr = doctor.User.FullNameAr;
            nameEn = doctor.User.FullNameEn;
            phone = doctor.User.PhoneNumber;
            license = doctor.LicenseNumber?.StartsWith("غير محدد", StringComparison.Ordinal) == true ? null : doctor.LicenseNumber;
            clinicAddress = doctor.ClinicAddress;
            notes = doctor.Notes;
            isAvailable = doctor.IsAvailable;
            workStart = doctor.WorkStartTime?.ToString("HH:mm");
            workEnd = doctor.WorkEndTime?.ToString("HH:mm");
            workingDays = ParseDays(doctor.WorkingDays);
        }
        loading = false;
    }

    private void ToggleDay(string code, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected) workingDays.Add(code);
        else workingDays.Remove(code);
    }

    private void OnWorkStartChanged(ChangeEventArgs args)
        => workStart = args.Value?.ToString();

    private void OnWorkEndChanged(ChangeEventArgs args)
        => workEnd = args.Value?.ToString();

    private async Task SaveProfile()
    {
        profileMessage = null; profileOk = false;
        if (doctor is null) return;
        if (string.IsNullOrWhiteSpace(nameAr)) { profileMessage = "اسم الطبيب مطلوب."; return; }
        if (workingDays.Count == 0) { profileMessage = "اختر يوم عمل واحدًا على الأقل."; return; }
        savingProfile = true;
        try
        {
            doctor.User.FullNameAr = nameAr.Trim();
            doctor.User.FullNameEn = Clean(nameEn) ?? nameAr.Trim();
            doctor.User.PhoneNumber = Clean(phone);
            doctor.User.PhoneNumberConfirmed = true;
            doctor.User.UpdatedAt = DateTime.UtcNow;
            var userResult = await UserManager.UpdateAsync(doctor.User);
            if (!userResult.Succeeded) { profileMessage = Errors(userResult); return; }

            doctor.LicenseNumber = Clean(license) is { Length: > 0 } value
                ? value
                : $"غير محدد-{doctor.UserId[..8]}";
            doctor.ClinicAddress = Clean(clinicAddress);
            doctor.Notes = Clean(notes);
            doctor.IsAvailable = isAvailable;
            doctor.WorkingDays = string.Join(",", workingDays);
            doctor.WorkStartTime = ParseTime(workStart);
            doctor.WorkEndTime = ParseTime(workEnd);
            await Db.SaveChangesAsync();

            var claims = await UserManager.GetClaimsAsync(doctor.User);
            foreach (var claim in claims.Where(c => c.Type == "FullNameAr").ToList()) await UserManager.RemoveClaimAsync(doctor.User, claim);
            await UserManager.AddClaimAsync(doctor.User, new Claim("FullNameAr", doctor.User.FullNameAr));

            profileOk = true;
            profileMessage = "تم حفظ البيانات بنجاح. لتحديث الاسم في الشريط العلوي سجّل الخروج ثم ادخل مرة أخرى.";
        }
        catch (Exception ex) { profileMessage = $"تعذر حفظ البيانات: {ex.Message}"; }
        finally { savingProfile = false; }
    }

    private async Task ChangePassword()
    {
        passwordMessage = null; passwordOk = false;
        if (doctor is null) return;
        if (string.IsNullOrWhiteSpace(currentPassword)) { passwordMessage = "اكتب كلمة المرور الحالية."; return; }
        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8) { passwordMessage = "كلمة المرور الجديدة يجب ألا تقل عن 8 أحرف أو أرقام."; return; }
        if (!string.Equals(newPassword, confirmPassword, StringComparison.Ordinal)) { passwordMessage = "تأكيد كلمة المرور غير مطابق."; return; }
        savingPassword = true;
        try
        {
            var result = await UserManager.ChangePasswordAsync(doctor.User, currentPassword, newPassword);
            if (!result.Succeeded) { passwordMessage = Errors(result); return; }
            passwordOk = true;
            passwordMessage = "تم تغيير كلمة المرور بنجاح.";
            currentPassword = newPassword = confirmPassword = null;
        }
        catch (Exception ex) { passwordMessage = $"تعذر تغيير كلمة المرور: {ex.Message}"; }
        finally { savingPassword = false; }
    }

    private static HashSet<string> ParseDays(string? value) => string.IsNullOrWhiteSpace(value) ? [] : value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet(StringComparer.OrdinalIgnoreCase);
    private static TimeOnly? ParseTime(string? value) => TimeOnly.TryParse(value, out var time) ? time : null;
    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Errors(IdentityResult result) => string.Join(" | ", result.Errors.Select(e => e.Description));
    private sealed record DayOption(string Code, string Name);
}
