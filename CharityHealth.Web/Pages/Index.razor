@page "/"
@layout CharityHealth.Web.Shared.Layouts.AuthLayout

@using Microsoft.EntityFrameworkCore
@using System.Globalization

@inject NavigationManager Nav
@inject CharityHealth.Infrastructure.Persistence.AppDbContext Db

<PageTitle>مستشفى بلا مستشفى</PageTitle>

<div class="login-shell landing-shell">

    <section class="login-card landing-card">

        <div class="login-title-block">
            <h1>مستشفى بلا مستشفى</h1>

            <p>
                منصة خيرية رقمية تربط المستفيدين بالأطباء
                والمتطوعين والمؤسسة.
            </p>
        </div>

        <div class="landing-actions">

            <button class="login-submit"
                    @onclick='() => Nav.NavigateTo("/login")'>
                تسجيل الدخول
            </button>

            <button class="outline-submit"
                    @onclick='() => Nav.NavigateTo("/register")'>
                إنشاء حساب مستفيد
            </button>

        </div>

        <div class="landing-feature-list">

            <div>
                <span>01</span>
                <strong>تقديم طلب كشف</strong>
                <small>رفع البيانات والمستندات المطلوبة بسهولة.</small>
            </div>

            <div>
                <span>02</span>
                <strong>مراجعة واعتماد</strong>
                <small>متابعة حالة الطلب من الإدارة المختصة.</small>
            </div>

            <div>
                <span>03</span>
                <strong>تنسيق الكشف</strong>
                <small>ربط الحالة بالطبيب المناسب ومتابعة النتيجة.</small>
            </div>

        </div>

    </section>

    <section class="login-brand-panel"
             aria-label="هوية المنصة">

        <div class="brand-mark large"
             aria-hidden="true">
        </div>

        <h2>
            رحمة بلا حدود
            <br />
            علاج بلا مبنى
        </h2>

        <p>
            منظومة رعاية صحية خيرية بتجربة استخدام بسيطة ومنظمة.
        </p>

        <div class="brand-metrics">

            <div>
                <strong>@MetricNumber(TotalBeneficiaries)</strong>
                <span>مستفيد مسجل</span>
            </div>

            <div>
                <strong>@MetricNumber(VolunteerDoctors)</strong>
                <span>طبيب متطوع</span>
            </div>

            <div>
                <strong>@MetricNumber(CompletedConsultations)</strong>
                <span>استشارة مكتملة</span>
            </div>

            <div>
                <strong class="rating">@SatisfactionDisplay</strong>
                <span>معدل الرضا</span>
            </div>

        </div>

    </section>

</div>

@code {
    private int? TotalBeneficiaries;
    private int? VolunteerDoctors;
    private int? CompletedConsultations;
    private string SatisfactionDisplay = "—";

    protected override async Task OnInitializedAsync()
    {
        await LoadPublicMetricsAsync();
    }

    private async Task LoadPublicMetricsAsync()
    {
        try
        {
            TotalBeneficiaries = await Db.Beneficiaries
                .AsNoTracking()
                .CountAsync();

            VolunteerDoctors = await Db.Doctors
                .AsNoTracking()
                .CountAsync(doctor =>
                    doctor.IsAvailable &&
                    !doctor.IsDeleted);

            CompletedConsultations = await Db.Consultations
                .AsNoTracking()
                .CountAsync();

            SatisfactionDisplay = "—";
        }
        catch
        {
            TotalBeneficiaries = null;
            VolunteerDoctors = null;
            CompletedConsultations = null;
            SatisfactionDisplay = "—";
        }
    }

    private static string MetricNumber(int? value)
    {
        return value.HasValue
            ? value.Value.ToString(
                "N0",
                CultureInfo.InvariantCulture)
            : "—";
    }
}
