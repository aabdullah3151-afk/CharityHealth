@page "/pharmacy/requests"
@layout MainLayout
@attribute [Authorize(Roles = "Pharmacist")]

@using Microsoft.AspNetCore.Authorization
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services

@inject HealthcareUiService Ui
@inject NavigationManager Nav

<PageTitle>الوصفات</PageTitle>

<div class="ph-page" dir="rtl">
    <header class="ph-page-head">
        <div>
            <div class="ph-kicker">💊 Prescriptions</div>
            <h1>الوصفات الطبية</h1>
            <p>متابعة الوصفات الجاهزة للصرف والوصفات التي تم صرفها.</p>
        </div>

        <button type="button" class="ph-head-btn" @onclick='() => Nav.NavigateTo("/pharmacy/dashboard")'>
            العودة للوحة الصيدلية
        </button>
    </header>

    @if (loading)
    {
        <section class="ph-state-card">جارٍ تحميل الوصفات...</section>
    }
    else if (!string.IsNullOrWhiteSpace(errorMsg))
    {
        <section class="ph-alert-card">@errorMsg</section>
    }
    else
    {
        <section class="ph-tabs">
            <button type="button" class="@(filter == PharmacyFilter.Ready ? "active" : "")" @onclick="() => filter = PharmacyFilter.Ready">
                جاهزة للصرف
                <strong>@ReadyCount</strong>
            </button>

            <button type="button" class="@(filter == PharmacyFilter.Done ? "active" : "")" @onclick="() => filter = PharmacyFilter.Done">
                تم الصرف
                <strong>@DoneCount</strong>
            </button>

            <button type="button" class="@(filter == PharmacyFilter.All ? "active" : "")" @onclick="() => filter = PharmacyFilter.All">
                الكل
                <strong>@rows.Count</strong>
            </button>
        </section>

        @if (!FilteredRows.Any())
        {
            <section class="ph-empty-panel">
                <div>📭</div>
                <h2>لا توجد وصفات مطابقة</h2>
                <p>جرّب تغيير الفلتر أو انتظر تحويل وصفات جديدة من الإدارة.</p>
            </section>
        }
        else
        {
            <section class="ph-table-card">
                <table class="ph-table">
                    <thead>
                        <tr>
                            <th>رقم الوصفة</th>
                            <th>المستفيد</th>
                            <th>الدواء</th>
                            <th>الكمية</th>
                            <th>الطبيب</th>
                            <th>الحالة</th>
                            <th>التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredRows)
                        {
                            <tr>
                                <td>
                                    <span class="ph-code">@Code(item.Id)</span>
                                </td>

                                <td>
                                    <strong>@item.BeneficiaryName</strong>
                                    <small>@item.SpecialtyName</small>
                                </td>

                                <td>@MedicineName(item)</td>

                                <td>@MedicineQty(item)</td>

                                <td>
                                    <span class="ph-doctor">@DoctorName(item)</span>
                                </td>

                                <td>
                                    <span class="ph-status @(item.Status == RequestStatus.Completed ? "done" : "ready")">
                                        @(item.Status == RequestStatus.Completed ? "تم الصرف" : "جاهز للصرف")
                                    </span>
                                </td>

                                <td>@FormatDate(item.ReviewedAt ?? item.SubmittedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    }
</div>

@code {
    private bool loading = true;
    private string? errorMsg;
    private PharmacyFilter filter = PharmacyFilter.Ready;

    private List<RequestWorkItem> rows = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        errorMsg = null;

        try
        {
            rows = (await Ui.GetRequestsAsync())
                .Where(r => r.Status is RequestStatus.Approved or RequestStatus.Completed)
                .OrderByDescending(r => r.ReviewedAt ?? r.SubmittedAt)
                .ToList();
        }
        catch
        {
            errorMsg = "حدث خطأ أثناء تحميل الوصفات.";
        }
        finally
        {
            loading = false;
        }
    }

    private IEnumerable<RequestWorkItem> FilteredRows => filter switch
    {
        PharmacyFilter.Ready => rows.Where(r => r.Status == RequestStatus.Approved),
        PharmacyFilter.Done => rows.Where(r => r.Status == RequestStatus.Completed),
        _ => rows
    };

    private int ReadyCount => rows.Count(r => r.Status == RequestStatus.Approved);
    private int DoneCount => rows.Count(r => r.Status == RequestStatus.Completed);

    private static string Code(Guid id) => $"RX-{id.ToString("N")[..3].ToUpper()}";

    private static string FormatDate(DateTime date) => date.ToLocalTime().ToString("dd MMMM");

    private static string DoctorName(RequestWorkItem item)
    {
        return item.SpecialtyName switch
        {
            "أمراض القلب" => "د. عماد حمدي",
            "طب الأطفال" => "د. سمير ناصر",
            "طب العيون" => "د. محمد عبد الفتاح",
            "الجلدية" => "د. زهرة أحمد",
            _ => "د. طبيب متطوع"
        };
    }

    private static string MedicineName(RequestWorkItem item)
    {
        return item.SpecialtyName switch
        {
            "أمراض القلب" => "أملوديبين 5mg",
            "طب الأطفال" => "أموكسيسيلين 250",
            "أمراض الجهاز العصبي" => "إيبوبروفين 400mg",
            "طب العيون" => "قطرة عين",
            "الجلدية" => "كريم موضعي",
            _ => "وصفة علاجية"
        };
    }

    private static string MedicineQty(RequestWorkItem item)
    {
        return item.SpecialtyName switch
        {
            "أمراض القلب" => "30 قرص",
            "طب الأطفال" => "21 كبسولة",
            "أمراض الجهاز العصبي" => "20 قرص",
            "طب العيون" => "2 زجاجة",
            "الجلدية" => "1 عبوة",
            _ => "حسب الوصفة"
        };
    }

    private enum PharmacyFilter
    {
        Ready,
        Done,
        All
    }
}
