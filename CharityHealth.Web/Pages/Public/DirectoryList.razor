<style>
/* DIRECTORY_APP_UI_FIX */

.directory-page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 26px 60px;
    color: #101828;
}

.directory-page-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 22px;

    padding: 26px 28px;
    margin-bottom: 16px;

    border: 1px solid #d1fae5;
    border-radius: 26px;

    background: linear-gradient(
        135deg,
        #ecfdf3,
        #ffffff
    );

    box-shadow:
        0 12px 32px rgba(5,150,105,.07);
}

.directory-page-head > div:first-child > a {
    display: inline-flex;
    margin-bottom: 6px;

    color: #047857;
    font-size: 14px;
    font-weight: 950;
    text-decoration: none;
}

.directory-page-head h1 {
    margin: 5px 0;
    font-size: 34px;
    font-weight: 950;
}

.directory-page-head p {
    margin: 0;

    color: #667085;
    font-weight: 750;
    line-height: 1.8;
}


/* Tabs */

.directory-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(130px, 1fr));
    gap: 8px;

    min-width: 320px;
}

.directory-tabs a {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 44px;

    border: 1px solid #d0d5dd;
    border-radius: 14px;

    background: #ffffff;
    color: #344054;

    padding: 0 13px;

    text-decoration: none;
    font-weight: 900;

    transition: .15s;
}

.directory-tabs a:hover {
    border-color: #86efac;
    color: #047857;
    background: #f0fdf4;
}


/* Search */

.directory-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;

    margin: 0 0 18px;
}

.directory-search-box {
    position: relative;
    flex: 1;
}

.directory-search-box .search-icon {
    position: absolute;

    right: 17px;
    top: 50%;

    transform: translateY(-50%);

    font-size: 24px;
    color: #667085;

    pointer-events: none;
}

.directory-search-box input {
    width: 100%;
    height: 54px;

    border: 1px solid #d0d5dd;
    border-radius: 16px;

    background: #ffffff;

    padding: 0 52px 0 48px;

    font-family: inherit;
    font-size: 15px;
    font-weight: 700;

    outline: none;

    box-shadow:
        0 6px 18px rgba(15,23,42,.035);
}

.directory-search-box input:focus {
    border-color: #12b76a;

    box-shadow:
        0 0 0 4px rgba(18,183,106,.10);
}

.directory-search-box button {
    position: absolute;

    left: 12px;
    top: 50%;

    transform: translateY(-50%);

    width: 31px;
    height: 31px;

    border: 0;
    border-radius: 50%;

    background: #f2f4f7;
    color: #667085;

    font-size: 20px;

    cursor: pointer;
}

.result-count {
    height: 54px;
    min-width: 110px;

    border: 1px solid #e4e7ec;
    border-radius: 16px;

    background: #ffffff;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 7px;
    padding: 0 15px;

    color: #667085;
    font-weight: 850;
}

.result-count strong {
    font-size: 20px;
    color: #059669;
}


/* Cards */

.directory-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 17px;
}

.directory-card {
    border: 1px solid #e4e7ec;
    border-radius: 22px;

    background: #ffffff;

    padding: 20px;

    box-shadow:
        0 10px 28px rgba(15,23,42,.05);

    cursor: pointer;

    transition:
        transform .16s ease,
        box-shadow .16s ease,
        border-color .16s ease;
}

.directory-card:hover {
    transform: translateY(-3px);

    border-color: #b7e4cf;

    box-shadow:
        0 18px 38px rgba(15,23,42,.09);
}

.directory-card .rank {
    display: inline-block;

    background: #ecfdf3;
    color: #047857;

    border-radius: 999px;

    padding: 7px 10px;

    font-size: 12px;
    font-weight: 900;
}

.directory-card h2 {
    margin: 16px 0 5px;

    font-size: 20px;
    font-weight: 950;
}

.directory-card > strong {
    color: #059669;
}

.directory-card > p {
    min-height: 48px;

    color: #667085;

    font-size: 13px;
    line-height: 1.8;
}


/* Buttons */

.actions {
    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 8px;
}

.actions button {
    min-height: 42px;

    border-radius: 12px;

    font-family: inherit;
    font-weight: 900;

    cursor: pointer;
}

.actions .light {
    border: 1px solid #d0d5dd;

    background: #ffffff;
}

.actions .primary {
    border: 0;

    background: #059669;
    color: #ffffff;
}


/* Empty */

.directory-state.empty {
    min-height: 220px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 8px;
}

.directory-state.empty > div {
    font-size: 38px;
    color: #98a2b3;
}

.directory-state.empty strong {
    font-size: 19px;
}

.directory-state.empty span {
    color: #667085;
    font-weight: 700;
}

.directory-state.empty button {
    margin-top: 8px;

    border: 0;
    border-radius: 12px;

    background: #059669;
    color: #ffffff;

    padding: 10px 18px;

    font-family: inherit;
    font-weight: 900;

    cursor: pointer;
}


/* Responsive */

@@media (max-width: 1150px) {

    .directory-page-head {
        grid-template-columns: 1fr;
    }

    .directory-tabs {
        min-width: 0;
    }

    .directory-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@@media (max-width: 700px) {

    .directory-page {
        padding:
            0 14px 42px;
    }

    .directory-page-head {
        padding: 20px 17px;
        border-radius: 21px;
    }

    .directory-page-head h1 {
        font-size: 29px;
    }

    .directory-tabs {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .directory-toolbar {
        flex-direction: column;
        align-items: stretch;
    }

    .result-count {
        width: 100%;
    }

    .directory-grid {
        grid-template-columns: 1fr;
    }
}
</style>


<style>

/* SMART_SPECIALTY_FILTER_PUBLIC */

.directory-specialty-filter {
    min-width: 230px;
    height: 54px;

    display: flex;
    align-items: center;
    gap: 10px;

    padding: 0 14px;

    border: 1px solid #d0d5dd;
    border-radius: 16px;

    background: #ffffff;

    box-shadow:
        0 6px 18px rgba(15,23,42,.035);
}

.directory-specialty-filter span {
    color: #667085;

    font-size: 13px;
    font-weight: 950;

    white-space: nowrap;
}

.directory-specialty-filter select {
    flex: 1;

    min-width: 0;

    border: 0;
    outline: 0;

    background: transparent;

    color: #101828;

    font-family: inherit;
    font-size: 14px;
    font-weight: 900;

    cursor: pointer;
}

@@media (max-width: 800px) {

    .directory-specialty-filter {
        width: 100%;
    }

}

</style>
