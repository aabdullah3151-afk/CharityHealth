@page "/directory/{Type}"
@layout CharityHealth.Web.Shared.Layouts.AuthLayout

@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence
@using CharityHealth.Web.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>@Title | مستشفى بلا مستشفى</PageTitle>

<div class="directory-page" dir="rtl">
    <header class="directory-page-head">
        <div>
            <a href="/">الصفحة الرئيسية</a>
            <h1>@Title</h1>
            <p>@Subtitle</p>
        </div>
        <div class="directory-tabs">
            <a href="/directory/doctors">الأطباء</a>
            <a href="/directory/pharmacies">الصيدليات</a>
            <a href="/directory/laboratories">المعامل</a>
            <a href="/directory/radiology-centers">مراكز الأشعة</a>
        </div>
    </header>

    @if (loading)
    {
        <div class="directory-state">جارٍ التحميل...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="directory-state error">@error</div>
    }
    else if (IsDoctors)
    {
        <div class="directory-grid">
            @foreach (var doctor in doctors)
            {
                <article class="directory-card" @onclick='() => Nav.NavigateTo($"/directory/doctor/{doctor.Id}")'>
                    <div class="rank">@doctor.CompletedServices كشف مكتمل</div>
                    <h2>@doctor.NameAr</h2>
                    <strong>@doctor.SpecialtyName</strong>
                    <p>📍 @Safe(doctor.ClinicAddress, "العنوان غير مسجل")</p>
                    <div class="actions">
                        <button class="light" @onclick:stopPropagation="true" @onclick='() => Nav.NavigateTo($"/directory/doctor/{doctor.Id}")'>كل التفاصيل</button>
                        <button class="primary" @onclick:stopPropagation="true" @onclick='() => OpenProtected($"/portal/request/medical?doctorId={doctor.Id}")'>طلب حجز</button>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="directory-grid">
            @foreach (var provider in providers)
            {
                <article class="directory-card" @onclick='() => OpenProvider(provider)'>
                    <div class="rank">@provider.CompletedServices خدمة مكتملة</div>
                    <h2>@provider.NameAr</h2>
                    <strong>@Title</strong>
                    <p>📍 @ProviderAddress(provider)</p>
                    <div class="actions">
                        <button class="light" @onclick:stopPropagation="true" @onclick='() => OpenProvider(provider)'>كل التفاصيل</button>
                        <button class="primary" @onclick:stopPropagation="true" @onclick='() => OpenProtected(ProviderRequestUrl(provider))'>تقديم طلب</button>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Type { get; set; } = "doctors";

    private bool loading = true;
    private string? error;
    private List<PublicDoctorCard> doctors = [];
    private List<PublicProviderCard> providers = [];

    private bool IsDoctors => Type.Equals("doctors", StringComparison.OrdinalIgnoreCase);
    private ServiceRequestType? ServiceType => PublicDirectoryData.ServiceTypeFromSlug(Type);
    private string Title => IsDoctors ? "كل الأطباء" : ServiceType is { } t ? PublicDirectoryData.ProviderTitle(t) : "الدليل الطبي";
    private string Subtitle => IsDoctors
        ? "الأطباء مرتبين حسب عدد الكشوف المكتملة، ثم بالاسم."
        : "الجهات مرتبة حسب عدد الخدمات المكتملة فعليًا داخل النظام.";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        doctors = [];
        providers = [];
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (IsDoctors)
                doctors = await PublicDirectoryData.GetDoctorsAsync(db);
            else if (ServiceType is { } type)
                providers = await PublicDirectoryData.GetProvidersAsync(db, type);
            else
                error = "نوع الدليل غير صحيح.";
        }
        catch
        {
            error = "تعذر تحميل البيانات حاليًا.";
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenProvider(PublicProviderCard provider)
    {
        var slug = PublicDirectoryData.SlugFor(provider.ServiceType);
        Nav.NavigateTo($"/directory/provider/{slug}/{Uri.EscapeDataString(provider.UserId)}");
    }

    private string ProviderRequestUrl(PublicProviderCard provider) =>
        $"/portal/request/service/{provider.ServiceType}?provider={Uri.EscapeDataString(provider.UserId)}";

    private async Task OpenProtected(string target)
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true && auth.User.IsInRole("Beneficiary"))
        {
            Nav.NavigateTo(target);
            return;
        }
        var message = Uri.EscapeDataString("سجل الدخول أولًا حتى تتمكن من الحجز أو تقديم الطلب.");
        Nav.NavigateTo($"/login?error={message}&returnUrl={Uri.EscapeDataString(target)}");
    }

    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string ProviderAddress(PublicProviderCard p)
    {
        var text = string.Join(" - ", new[] { p.Governorate, p.City, p.AddressAr }.Where(x => !string.IsNullOrWhiteSpace(x)));
        return string.IsNullOrWhiteSpace(text) ? "العنوان غير مسجل" : text;
    }
}

