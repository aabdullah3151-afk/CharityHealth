@page "/directory/{Type}"
@layout MainLayout

@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence
@using CharityHealth.Web.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>@Title | مستشفى بلا مستشفى</PageTitle>

<div class="directory-page" dir="rtl">
    <header class="directory-page-head">
        <div>
            <a href="/portal/dashboard">الصفحة الرئيسية</a>
            <h1>@Title</h1>
            <p>@Subtitle</p>
        </div>
        <div class="directory-tabs">
            <a href="/directory/doctors">الأطباء</a>
            <a href="/directory/pharmacies">الصيدليات</a>
            <a href="/directory/laboratories">المعامل</a>
            <a href="/directory/radiology-centers">مراكز الأشعة</a>
        </div>
    </header>

    <section class="directory-toolbar">

        <div class="directory-search-box">
            <span class="search-icon">⌕</span>

            <input type="search"
                   placeholder="@SearchPlaceholder"
                   @bind="searchText"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(searchText))
            {
                <button type="button"
                        title="مسح البحث"
                        @onclick="ClearSearch">
                    ×
                </button>
            }
        </div>

        @if (IsDoctors)
        {
            <div class="directory-specialty-filter">

                <span>التخصص</span>

                <select @bind="selectedSpecialty">

                    <option value="">
                        كل التخصصات
                    </option>

                    @foreach (var specialty in DoctorSpecialties)
                    {
                        <option value="@specialty">
                            @specialty
                        </option>
                    }

                </select>

            </div>
        }

        <div class="result-count">
            <strong>@VisibleCount</strong>
            <span>@ResultLabel</span>
        </div>

    </section>

    @if (loading)
    {
        <div class="directory-state">جارٍ التحميل...</div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="directory-state error">@error</div>
    }
    else if (VisibleCount == 0)
    {
        <div class="directory-state empty">
            <div>⌕</div>
            <strong>لا توجد نتائج مطابقة</strong>
            <span>جرّب اسمًا آخر أو امسح البحث لعرض الكل.</span>

            @if (!string.IsNullOrWhiteSpace(searchText))
            {
                <button type="button" @onclick="ClearSearch">
                    عرض الكل
                </button>
            }
        </div>
    }
    else if (IsDoctors)
    {
        <div class="directory-grid">
            @foreach (var doctor in FilteredDoctors)
            {
                <article class="directory-card" @onclick='() => Nav.NavigateTo($"/directory/doctor/{doctor.Id}")'>
                    <div class="rank">@doctor.CompletedServices كشف مكتمل</div>
                    <h2>@doctor.NameAr</h2>
                    <strong>@doctor.SpecialtyName</strong>
                    <p>📍 @Safe(doctor.ClinicAddress, "العنوان غير مسجل")</p>
                    <div class="actions">
                        <button class="light" @onclick:stopPropagation="true" @onclick='() => Nav.NavigateTo($"/directory/doctor/{doctor.Id}")'>كل التفاصيل</button>
                        <button class="primary" @onclick:stopPropagation="true" @onclick='() => OpenProtected($"/portal/request/medical?doctorId={doctor.Id}")'>طلب حجز</button>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="directory-grid">
            @foreach (var provider in FilteredProviders)
            {
                <article class="directory-card" @onclick='() => OpenProvider(provider)'>
                    <div class="rank">@provider.CompletedServices خدمة مكتملة</div>
                    <h2>@provider.NameAr</h2>
                    <strong>@Title</strong>
                    <p>📍 @ProviderAddress(provider)</p>
                    <div class="actions">
                        <button class="light" @onclick:stopPropagation="true" @onclick='() => OpenProvider(provider)'>كل التفاصيل</button>
                        <button class="primary" @onclick:stopPropagation="true" @onclick='() => OpenProtected(ProviderRequestUrl(provider))'>تقديم طلب</button>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Type { get; set; } = "doctors";

    private bool loading = true;
    private string? error;
    private List<PublicDoctorCard> doctors = [];
    private List<PublicProviderCard> providers = [];

    private string searchText = string.Empty;
    private string selectedSpecialty = string.Empty;

    private IEnumerable<string> DoctorSpecialties =>
        doctors
            .Select(d => d.SpecialtyName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x);


    private IEnumerable<PublicDoctorCard> FilteredDoctors =>
        doctors.Where(d =>

            (
                string.IsNullOrWhiteSpace(selectedSpecialty)

                ||

                string.Equals(
                    d.SpecialtyName,
                    selectedSpecialty,
                    StringComparison.OrdinalIgnoreCase)
            )

            &&

            SmartMatches(
                searchText,
                d.NameAr,
                d.SpecialtyName,
                d.ClinicAddress,
                d.ClinicPhone,
                d.LicenseNumber)
        );


    private IEnumerable<PublicProviderCard> FilteredProviders =>
        providers.Where(p =>
            SmartMatches(
                searchText,
                p.NameAr,
                p.PhoneNumber,
                p.ContactPersonName,
                p.Governorate,
                p.City,
                p.AddressAr,
                p.DescriptionAr,
                p.LicenseNumber)
        );


    private int VisibleCount =>
        IsDoctors
            ? FilteredDoctors.Count()
            : FilteredProviders.Count();


    private string ResultLabel =>
        IsDoctors
            ? "طبيب"
            : "جهة";


    private string SearchPlaceholder =>
        IsDoctors
            ? "ابحث باسم الطبيب أو التخصص أو العنوان أو الهاتف..."
            : $"ابحث في {Title} بالاسم أو المحافظة أو المدينة أو الهاتف...";


    private bool IsDoctors => Type.Equals("doctors", StringComparison.OrdinalIgnoreCase);
    private ServiceRequestType? ServiceType => PublicDirectoryData.ServiceTypeFromSlug(Type);
    private string Title => IsDoctors ? "كل الأطباء" : ServiceType is { } t ? PublicDirectoryData.ProviderTitle(t) : "الدليل الطبي";
    private string Subtitle => IsDoctors
        ? "الأطباء مرتبين حسب عدد الكشوف المكتملة، ثم بالاسم."
        : "الجهات مرتبة حسب عدد الخدمات المكتملة فعليًا داخل النظام.";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        searchText = string.Empty;
        selectedSpecialty = string.Empty;
        doctors = [];
        providers = [];
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (IsDoctors)
                doctors = await PublicDirectoryData.GetDoctorsAsync(db);
            else if (ServiceType is { } type)
                providers = await PublicDirectoryData.GetProvidersAsync(db, type);
            else
                error = "نوع الدليل غير صحيح.";
        }
        catch
        {
            error = "تعذر تحميل البيانات حاليًا.";
        }
        finally
        {
            loading = false;
        }
    }

    private void ClearSearch()
    {
        searchText = string.Empty;
    }

    private static string NormalizeSearch(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var text = value.Trim().ToLowerInvariant()
            .Replace('أ', 'ا')
            .Replace('إ', 'ا')
            .Replace('آ', 'ا')
            .Replace('ٱ', 'ا')
            .Replace('ى', 'ي')
            .Replace('ة', 'ه')
            .Replace('ؤ', 'و')
            .Replace('ئ', 'ي');

        var buffer = new System.Text.StringBuilder(text.Length);

        foreach (var ch in text)
        {
            var category =
                System.Globalization.CharUnicodeInfo.GetUnicodeCategory(ch);

            if (category ==
                System.Globalization.UnicodeCategory.NonSpacingMark)
                continue;

            buffer.Append(char.IsLetterOrDigit(ch) ? ch : ' ');
        }

        return string.Join(" ",
            buffer.ToString().Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries));
    }

    private static bool SmartMatches(
        string? query,
        params string?[] values)
    {
        var q = NormalizeSearch(query);

        if (string.IsNullOrWhiteSpace(q))
            return true;

        var haystack = NormalizeSearch(
            string.Join(" ",
                values.Where(v => !string.IsNullOrWhiteSpace(v))));

        var ignored = new HashSet<string>(
            StringComparer.OrdinalIgnoreCase)
        {
            "د",
            "دكتور",
            "دكتوره",
            "طبيب",
            "الطبيب"
        };

        var words = q
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries)
            .Where(x => !ignored.Contains(x))
            .ToArray();

        if (words.Length == 0)
            return true;

        // مثال: "احمد نساء"
        // يمكن أن تكون "احمد" في الاسم و"نساء" في التخصص.
        if (words.All(word =>
            haystack.Contains(
                word,
                StringComparison.OrdinalIgnoreCase)))
            return true;

        // يسمح أيضًا بالبحث مع اختلاف المسافات:
        // "عبدالرحيم" = "عبد الرحيم"
        var compactQuery = string.Concat(words);
        var compactData = haystack.Replace(" ", string.Empty);

        return compactData.Contains(
            compactQuery,
            StringComparison.OrdinalIgnoreCase);
    }

    private void OpenProvider(PublicProviderCard provider)
    {
        var slug = PublicDirectoryData.SlugFor(provider.ServiceType);
        Nav.NavigateTo($"/directory/provider/{slug}/{Uri.EscapeDataString(provider.UserId)}");
    }

    private string ProviderRequestUrl(PublicProviderCard provider) =>
        $"/portal/request/service/{provider.ServiceType}?provider={Uri.EscapeDataString(provider.UserId)}";

    private async Task OpenProtected(string target)
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true && auth.User.IsInRole("Beneficiary"))
        {
            Nav.NavigateTo(target);
            return;
        }
        var message = Uri.EscapeDataString("سجل الدخول أولًا حتى تتمكن من الحجز أو تقديم الطلب.");
        Nav.NavigateTo($"/login?error={message}&returnUrl={Uri.EscapeDataString(target)}");
    }

    private static string Safe(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;
    private static string ProviderAddress(PublicProviderCard p)
    {
        var text = string.Join(" - ", new[] { p.Governorate, p.City, p.AddressAr }.Where(x => !string.IsNullOrWhiteSpace(x)));
        return string.IsNullOrWhiteSpace(text) ? "العنوان غير مسجل" : text;
    }
}

