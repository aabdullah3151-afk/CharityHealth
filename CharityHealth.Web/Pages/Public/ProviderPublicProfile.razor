@page "/directory/provider/{Type}/{Id}"
@layout CharityHealth.Web.Shared.Layouts.AuthLayout

@using CharityHealth.Domain.Enums
@using CharityHealth.Infrastructure.Persistence
@using CharityHealth.Web.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject AppDbContext Db
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>@(provider?.NameAr ?? "تفاصيل مقدم الخدمة")</PageTitle>

<div class="public-profile-page" dir="rtl">
    @if (loading)
    {
        <div class="profile-state">جارٍ تحميل البيانات...</div>
    }
    else if (provider is null || serviceType is null)
    {
        <div class="profile-state error">الجهة غير موجودة أو غير متاحة حاليًا.</div>
    }
    else
    {
        <header class="profile-hero">
            <div class="profile-avatar">@PublicDirectoryData.ProviderIcon(serviceType.Value)</div>
            <div class="profile-title">
                <a href="@($"/directory/{PublicDirectoryData.SlugFor(serviceType.Value)}")">← @PublicDirectoryData.ProviderTitle(serviceType.Value)</a>
                <h1>@provider.NameAr</h1>
                <strong>@PublicDirectoryData.ProviderTitle(serviceType.Value)</strong>
                <span>@provider.CompletedServices خدمة مكتملة</span>
            </div>
            <button @onclick='() => OpenProtected(RequestUrl)'>تقديم طلب خدمة</button>
        </header>

        <section class="profile-grid">
            <article><span>المحافظة</span><strong>@Safe(provider.Governorate)</strong></article>
            <article><span>المدينة</span><strong>@Safe(provider.City)</strong></article>
            <article class="wide"><span>العنوان</span><strong>@Safe(provider.AddressAr)</strong></article>
            <article><span>الهاتف</span><strong dir="ltr">@Safe(provider.PhoneNumber)</strong></article>
            <article><span>مسؤول التواصل</span><strong>@Safe(provider.ContactPersonName)</strong></article>
            <article><span>أيام العمل</span><strong>@Safe(provider.WorkingDays)</strong></article>
            <article><span>ساعات العمل</span><strong>@Safe(provider.WorkingHours)</strong></article>
            <article><span>نسبة الخصم</span><strong>@provider.DiscountPercentage.ToString("0.##")%</strong></article>
            <article><span>السعة اليومية</span><strong>@provider.DailyRequestCapacity طلب</strong></article>
            <article><span>رقم الترخيص</span><strong>@Safe(provider.LicenseNumber)</strong></article>
            <article class="wide"><span>نبذة عن الجهة</span><strong>@Safe(provider.DescriptionAr)</strong></article>
        </section>
    }
</div>

@code {
    [Parameter] public string Type { get; set; } = string.Empty;
    [Parameter] public string Id { get; set; } = string.Empty;

    private ServiceRequestType? serviceType;
    private PublicProviderCard? provider;
    private bool loading = true;

    private string RequestUrl => provider is null
        ? "/"
        : $"/portal/request/service/{provider.ServiceType}?provider={Uri.EscapeDataString(provider.UserId)}";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        serviceType = PublicDirectoryData.ServiceTypeFromSlug(Type);
        try
        {
            provider = serviceType is null ? null : await PublicDirectoryData.GetProviderAsync(Db, serviceType.Value, Id);
        }
        finally { loading = false; }
    }

    private async Task OpenProtected(string target)
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (auth.User.Identity?.IsAuthenticated == true && auth.User.IsInRole("Beneficiary"))
        {
            Nav.NavigateTo(target);
            return;
        }
        var message = Uri.EscapeDataString("سجل الدخول أولًا حتى تتمكن من تقديم طلب الخدمة.");
        Nav.NavigateTo($"/login?error={message}&returnUrl={Uri.EscapeDataString(target)}");
    }

    private static string Safe(string? value) => string.IsNullOrWhiteSpace(value) ? "غير مسجل" : value;
}

<style>
.public-profile-page{max-width:1100px;margin:0 auto;padding:40px 20px 70px;color:#101828}.profile-hero{display:grid;grid-template-columns:80px 1fr auto;gap:20px;align-items:center;border:1px solid #e4e7ec;border-radius:28px;background:#fff;padding:26px;box-shadow:0 14px 34px rgba(15,23,42,.06)}.profile-avatar{width:76px;height:76px;border-radius:24px;background:#ecfdf3;display:grid;place-items:center;font-size:32px}.profile-title a{color:#059669;text-decoration:none;font-weight:900}.profile-title h1{margin:7px 0 5px;font-size:32px;font-weight:950}.profile-title strong{display:block;color:#059669}.profile-title span{display:inline-block;margin-top:8px;background:#ecfdf3;color:#047857;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:900}.profile-hero>button{border:0;border-radius:14px;background:#059669;color:#fff;padding:14px 20px;font-weight:950;cursor:pointer}.profile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:18px}.profile-grid article{border:1px solid #e4e7ec;border-radius:20px;background:#fff;padding:18px}.profile-grid article.wide{grid-column:1/-1}.profile-grid span{display:block;color:#667085;font-size:13px;font-weight:800;margin-bottom:7px}.profile-grid strong{font-size:16px;line-height:1.8}.profile-state{padding:40px;background:#fff;border:1px solid #e4e7ec;border-radius:24px;text-align:center;font-weight:900}.profile-state.error{color:#b42318}@@media(max-width:700px){.profile-hero{grid-template-columns:64px 1fr}.profile-hero>button{grid-column:1/-1}.profile-grid{grid-template-columns:1fr}.profile-grid article.wide{grid-column:auto}}
</style>
