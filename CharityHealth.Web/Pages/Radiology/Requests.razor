ue-card-head i.done{background:#f1f5f9;color:#475467}.partner-queue-card dl{margin:18px 0;display:grid;grid-template-columns:120px 1fr;gap:9px;border-radius:18px;background:#f8fafc;padding:16px}.partner-queue-card dt{color:#98a2b3;font-size:12px;font-weight:900}.partner-queue-card dd{margin:0;color:#344054;font-size:13px;font-weight:950}.partner-queue-description,.partner-queue-result{border-radius:18px;background:#f8fafc;padding:16px;margin-bottom:14px}.partner-queue-description strong,.partner-queue-result strong{font-size:13px;font-weight:950}.partner-queue-description p,.partner-queue-result p{margin:7px 0 0;color:#667085;font-size:13px;line-height:1.8;font-weight:800;white-space:pre-wrap}.partner-queue-result{background:#ecfdf3;color:#047857}.partner-queue-scan-required{border-radius:18px;background:#eff6ff;border:1px solid #bfdbfe;padding:16px}.partner-queue-scan-required strong{color:#1d4ed8;font-size:13px;font-weight:950}.partner-queue-scan-required p{margin:7px 0 12px;color:#64748b;font-size:12px;line-height:1.8;font-weight:800}.partner-queue-scan-required button{width:100%;min-height:42px;border:0;border-radius:999px;background:var(--partner-accent);color:#fff;font-weight:950;cursor:pointer}.partner-queue-documents{border-radius:18px;background:#fff7ed;border:1px solid #fed7aa;padding:16px;margin-bottom:14px}.partner-queue-documents>strong{display:block;color:#9a3412;font-size:13px;font-weight:950;margin-bottom:10px}.partner-queue-documents>div{display:grid;gap:8px}.partner-queue-documents a{border-radius:13px;background:#fff;color:#344054;padding:10px 12px;display:grid;grid-template-columns:24px 1fr auto;gap:8px;align-items:center;text-decoration:none;font-size:12px}.partner-queue-documents a b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.partner-queue-documents a small{color:#98a2b3;font-weight:800}.partner-queue-card textarea{width:100%;border:1px solid #e5e7eb;border-radius:16px;background:#f8fafc;padding:13px;resize:vertical;font:inherit;font-size:13px;font-weight:800;outline:none}.partner-queue-card>button{width:100%;margin-top:10px;border:0;border-radius:999px;background:var(--partner-accent);color:#fff;min-height:44px;font-weight:950;cursor:pointer}.partner-queue-card>button:disabled{opacity:.6}.partner-queue-state,.partner-queue-empty{margin-top:22px;border:1px solid #e5e7eb;border-radius:28px;background:#fff;padding:44px;text-align:center;color:#667085;font-weight:900}.partner-queue-empty div{font-size:40px}.partner-queue-empty h2{color:#111827;font-weight:950}.partner-queue-message{margin-top:18px;border-radius:18px;padding:15px;font-weight:900}.partner-queue-message.ok{background:#ecfdf3;color:#047857}.partner-queue-message.bad{background:#fef2f2;color:#991b1b}@@media(max-width:850px){.partner-queue-page{padding:20px 14px}.partner-queue-grid{grid-template-columns:1fr}.partner-queue-head{align-items:flex-start;flex-direction:column}}
</style>

@code {
    private bool loading = true;
    private bool messageOk;
    private string? message;
    private string userId = string.Empty;
    private QueueFilter filter = QueueFilter.Ready;
    private List<RequestWorkItem> rows = [];
    private Dictionary<Guid, string?> notes = [];
    private Dictionary<Guid, List<PartnerRequestDocument>> documentsByRequest = [];
    private HashSet<Guid> busyIds = [];

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        loading = true;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            rows = string.IsNullOrWhiteSpace(userId) ? [] : await Ui.GetPartnerRequestsAsync(userId, ServiceRequestType.RadiologyScan);
            foreach (var item in rows)
            {
                if (!notes.ContainsKey(item.Id)) notes[item.Id] = item.ProviderNoteAr;
                documentsByRequest[item.Id] = await Ui.GetPartnerRequestDocumentsAsync(item.Id, userId, ServiceRequestType.RadiologyScan);
            }
        }
        catch { message = "حدث خطأ أثناء تحميل الطلبات."; messageOk = false; }
        finally { loading = false; }
    }

    private IEnumerable<RequestWorkItem> FilteredRows => filter switch { QueueFilter.Ready => rows.Where(r => r.Status == RequestStatus.Approved), QueueFilter.Done => rows.Where(r => r.Status == RequestStatus.Completed), _ => rows };
    private int ReadyCount => rows.Count(r => r.Status == RequestStatus.Approved);
    private int DoneCount => rows.Count(r => r.Status == RequestStatus.Completed);

    private async Task Complete(RequestWorkItem item)
    {
        busyIds.Add(item.Id); message = null;
        try
        {
            var result = await Ui.CompletePartnerRequestAsync(item.Id, userId, ServiceRequestType.RadiologyScan, notes.GetValueOrDefault(item.Id));
            message = result.Message; messageOk = result.Succeeded;
            if (result.Succeeded) await Load();
        }
        finally { busyIds.Remove(item.Id); }
    }

    private static string DocumentUrl(string filePath)
    {
        var value = (filePath ?? string.Empty).Trim().Replace("\\", "/");
        if (value.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || value.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || value.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase)) return value;
        if (value.StartsWith("uploads/", StringComparison.OrdinalIgnoreCase)) return "/" + value;
        return "/uploads/" + value.TrimStart('/');
    }

    private static string FileSizeText(long bytes) => bytes < 1024 * 1024
        ? $"{bytes / 1024d:0.#} KB"
        : $"{bytes / 1024d / 1024d:0.##} MB";

    private static string RequestCode(Guid id) => $"REQ-{id.ToString("N")[..6].ToUpperInvariant()}";
    private static string FormatDate(DateTime date) => date.ToLocalTime().ToString("yyyy/MM/dd HH:mm");
    private enum QueueFilter { Ready, Done, All }
}
