@page "/radiology/requests"
@layout MainLayout
@attribute [Authorize(Roles = "RadiologyCenter")]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using CharityHealth.Domain.Enums
@using CharityHealth.Web.Services

@inject HealthcareUiService Ui
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>طلبات مركز الأشعة</PageTitle>

<div class="partner-queue-page" dir="rtl" style="--partner-accent:#4f46e5;">
    <header class="partner-queue-head">
        <div>
            <div class="partner-queue-kicker">🩻 Service Requests</div>
            <h1>طلبات مركز الأشعة</h1>
            <p>الطلبات الظاهرة مخصصة لهذا الحساب فقط وتمت الموافقة عليها من الإدارة.</p>
        </div>
        <button type="button" @onclick='() => Nav.NavigateTo("/radiology/dashboard")'>العودة للوحة</button>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="partner-queue-message @(messageOk ? "ok" : "bad")">@message</div>
    }

    @if (loading)
    {
        <section class="partner-queue-state">جارٍ تحميل الطلبات...</section>
    }
    else
    {
        <section class="partner-queue-tabs">
            <button class="@(filter == QueueFilter.Ready ? "active" : "")" @onclick="() => filter = QueueFilter.Ready">جاهزة للتنفيذ <strong>@ReadyCount</strong></button>
            <button class="@(filter == QueueFilter.Done ? "active" : "")" @onclick="() => filter = QueueFilter.Done">مكتملة <strong>@DoneCount</strong></button>
            <button class="@(filter == QueueFilter.All ? "active" : "")" @onclick="() => filter = QueueFilter.All">الكل <strong>@rows.Count</strong></button>
        </section>

        @if (!FilteredRows.Any())
        {
            <section class="partner-queue-empty">
                <div>🩻</div><h2>لا توجد طلبات</h2><p>ستظهر هنا الطلبات التي تعتمدها الإدارة وتخصصها لحسابك.</p>
            </section>
        }
        else
        {
            <section class="partner-queue-grid">
                @foreach (var item in FilteredRows)
                {
                    <article class="partner-queue-card">
                        <div class="partner-queue-card-head">
                            <span>🩻</span>
                            <div><h2>@item.BeneficiaryName</h2><p>@RequestCode(item.Id) · @item.BeneficiaryPhone</p></div>
                            <i class="@(item.Status == RequestStatus.Completed ? "done" : "ready")">@(item.Status == RequestStatus.Completed ? "تم إجراء الأشعة" : "جاهز")</i>
                        </div>

                        <dl>
                            <dt>نوع الخدمة</dt><dd>@item.ServiceTypeAr</dd>
                            <dt>تاريخ الاعتماد</dt><dd>@FormatDate(item.ReviewedAt ?? item.SubmittedAt)</dd>
                            <dt>المستندات</dt><dd>@item.DocumentsCount</dd>
                        </dl>

                        <div class="partner-queue-description">
                            <strong>تفاصيل الطلب</strong>
                            <p>@(string.IsNullOrWhiteSpace(item.DescriptionAr) ? "لا توجد تفاصيل." : item.DescriptionAr)</p>
                        </div>

                        @if (documentsByRequest.TryGetValue(item.Id, out var itemDocuments) && itemDocuments.Count > 0)
                        {
                            <div class="partner-queue-documents">
                                <strong>المستندات المرفوعة</strong>
                                <div>
                                    @foreach (var document in itemDocuments)
                                    {
                                        <a href="@DocumentUrl(document.FilePath)" target="_blank" rel="noopener">
                                            <span>📎</span>
                                            <b>@document.FileName</b>
                                            <small>@FileSizeText(document.FileSizeBytes)</small>
                                        </a>
                                    }
                                </div>
                            </div>
                        }

                        @if (item.Status == RequestStatus.Completed)
                        {
                            <div class="partner-queue-result"><strong>تم إجراء الأشعة</strong><p>@(string.IsNullOrWhiteSpace(item.ProviderNoteAr) ? "تم تنفيذ الخدمة." : item.ProviderNoteAr)</p></div>
                        }
                        else
                        {
                            <div class="partner-queue-scan-required">
                                <strong>يتطلب مسح QR</strong>
                                <p>لإتمام الطلب وحفظ بيانات التنفيذ يجب حضور المستفيد ومسح QR الخاص به.</p>
                                <button type="button" @onclick='() => Nav.NavigateTo("/radiology/scan")'>فتح ماسح QR — تنفيذ الأشعة</button>
                            </div>
                        }
                    </article>
                }
            </section>
        }
    }
</div>

<style>
