<div class="line-chart" aria-label="النشاط الشهري">
    <svg viewBox="0 0 720 220" role="img" preserveAspectRatio="none">
        <defs>
            <linearGradient id="lineFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="currentColor" stop-opacity="0.25" />
                <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
            </linearGradient>
        </defs>
        <g class="chart-grid-lines">
            <line x1="20" y1="20" x2="700" y2="20" />
            <line x1="20" y1="65" x2="700" y2="65" />
            <line x1="20" y1="110" x2="700" y2="110" />
            <line x1="20" y1="155" x2="700" y2="155" />
            <line x1="20" y1="200" x2="700" y2="200" />
            <line x1="160" y1="20" x2="160" y2="200" />
            <line x1="300" y1="20" x2="300" y2="200" />
            <line x1="440" y1="20" x2="440" y2="200" />
            <line x1="580" y1="20" x2="580" y2="200" />
        </g>
        <polygon class="chart-area" points="20,150 160,124 300,92 440,78 580,46 700,32 700,200 20,200" />
        <polyline class="chart-line" points="20,150 160,124 300,92 440,78 580,46 700,32" />
    </svg>
    <div class="axis-labels x-axis"><span>يناير</span><span>فبراير</span><span>مارس</span><span>أبريل</span><span>مايو</span><span>يونيو</span></div>
    <div class="axis-labels y-axis"><span>100</span><span>75</span><span>50</span><span>25</span><span>0</span></div>
</div>
