<div class="@($"app-root {Theme.CssClass}")" dir="rtl">

    <!-- TOPBAR -->
    <header class="app-topbar-fixed">

        <button type="button"
                class="mobile-menu-btn"
                title="القائمة"
                aria-label="فتح القائمة"
                aria-expanded="@mobileMenuOpen"
                @onclick="ToggleMobileMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <!-- BRAND RIGHT -->
        <button type="button"
                class="brand-button"
                @onclick="GoHome">
            <img class="brand-logo-image"
                 src="/images/charityhealth-logo.svg"
                 alt="شعار مستشفى بلا مستشفى" />

            <span class="brand-text">
                <strong>مستشفى بلا مستشفى</strong>
                <small>رحمة بلا حدود</small>
            </span>
        </button>

        <!-- USER CHIP CENTER -->
        <AuthorizeView>
            <Authorized Context="auth">
                <div class="top-user-chip-fixed" style="@UserChipStyle(auth.User)">
                    <span style="
                        width:10px !important;
                        height:10px !important;
                        border-radius:50% !important;
                        background:currentColor !important;
                        display:inline-block !important;">
                    </span>

                    <strong style="font-weight:950 !important;">
                        @DisplayName(auth.User)
                    </strong>

                    <span>
                        · @RoleLabel(auth.User)
                    </span>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="top-user-chip-fixed" style="@GuestChipStyle">
                    <span style="
                        width:10px !important;
                        height:10px !important;
                        border-radius:50% !important;
                        background:currentColor !important;
                        display:inline-block !important;">
                    </span>

                    <strong style="font-weight:950 !important;">زائر</strong>
                    <span>· غير مسجل</span>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        <!-- ACTIONS LEFT -->
        <div class="topbar-actions">

            <a href="/account/logout"
               class="topbar-logout">
                <span>خروج</span>

                <span style="
                    display:inline-grid !important;
                    place-items:center !important;
                    width:28px !important;
                    height:28px !important;
                    color:#667085 !important;
                    font-size:28px !important;
                    line-height:1 !important;
                    font-weight:400 !important;
                    transform:rotate(180deg) !important;">
                    ↪
                </span>
            </a>

            <AuthorizeView>
                <Authorized Context="auth">
                    <button type="button"
                            @onclick='() => Nav.NavigateTo(NotificationUrl(auth.User))'
                            title="الإشعارات"
                            aria-label="الإشعارات"
                            class="topbar-circle-btn"
                            style="font-size:22px !important;">
                        <span style="line-height:1 !important;">🔔</span>

                        @if (UnreadNotifications > 0)
                        {
                            <span style="
                                position:absolute !important;
                                top:4px !important;
                                right:4px !important;
                                min-width:20px !important;
                                height:20px !important;
                                padding:0 5px !important;
                                border-radius:999px !important;
                                background:#ef4444 !important;
                                color:white !important;
                                font-size:11px !important;
                                font-weight:900 !important;
                                display:flex !important;
                                align-items:center !important;
                                justify-content:center !important;
                                border:2px solid #fff !important;">
                                @UnreadNotifications
                            </span>
                        }
                    </button>
                </Authorized>
            </AuthorizeView>

            <button type="button"
                    @onclick="Theme.Toggle"
                    title="تبديل الوضع"
                    aria-label="تبديل الوضع"
                    class="topbar-circle-btn">
                <span>@Theme.Icon</span>
            </button>
        </div>
    </header>

    <!-- MOBILE OVERLAY -->
    @if (mobileMenuOpen)
    {
        <button type="button"
                class="mobile-sidebar-backdrop"
                aria-label="إغلاق القائمة"
                @onclick="CloseMobileMenu">
        </button>
    }

    <!-- SIDEBAR -->
    <aside class="@($"app-sidebar {(mobileMenuOpen ? "mobile-open" : "")}")"
           aria-label="القائمة الجانبية">

        <AuthorizeView>
            <Authorized Context="auth">
                <div class="sidebar-user-card">
                    <div class="user-initial"
                         style="@SidebarAvatarStyle(auth.User)">
                        @GetInitial(DisplayName(auth.User))
                    </div>

                    <div>
                        <strong>@DisplayName(auth.User)</strong>
                        <span>@RoleLabel(auth.User)</span>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <NavMenu />

        <AuthorizeView Roles="Administrator">
            <Authorized>
                <NavLink href="/admin/users"
                         class="nav-link"
                         Match="NavLinkMatch.Prefix">
                    <span class="nav-icon">👥</span>
                    <span>كل المستخدمين</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <div class="sidebar-footer">
            <a class="sidebar-logout" href="/account/logout">
                <span>تسجيل الخروج</span>
                <span class="logout-arrow">↢</span>
            </a>
        </div>
    </aside>

    <!-- CONTENT -->
    <section class="app-workspace">
        <main class="page-canvas">
            @Body
        </main>
    </section>
</div>

@code {
    private bool mobileMenuOpen;
    private int UnreadNotifications = 0;

    protected override void OnInitialized()
    {
        Theme.OnChange += StateHasChanged;
        Nav.LocationChanged += HandleLocationChanged;

        _ = LoadUnreadNotifications();
    }

    private async Task LoadUnreadNotifications()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(userId))
            {
                UnreadNotifications = 0;
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            UnreadNotifications = await db.Notifications
                .AsNoTracking()
                .CountAsync(x => x.UserId == userId && !x.IsRead);

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            UnreadNotifications = 0;
        }
    }

    public void Dispose()
    {
        Theme.OnChange -= StateHasChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        mobileMenuOpen = false;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        mobileMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task GoHome()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;

        mobileMenuOpen = false;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        Nav.NavigateTo(DashboardUrl(user));
    }

    private static string DisplayName(ClaimsPrincipal user)
    {
        return user.FindFirst("FullNameAr")?.Value
            ?? user.Identity?.Name
            ?? "مستخدم";
    }

    private static string GetInitial(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "م";
        }

        return value.Trim()[0].ToString();
    }

    private static string UserType(ClaimsPrincipal user)
    {
        // نعتمد على الـ Role الفعلي أولاً حتى يظهر نوع الحساب الصحيح
        // حتى لو كان بالحساب Claim قديم مثل Staff أو User.
        if (user.IsInRole("Administrator")) return "Administrator";
        if (user.IsInRole("Pharmacy")) return "Pharmacy";
        if (user.IsInRole("Pharmacist")) return "Pharmacist";
        if (user.IsInRole("Laboratory")) return "Laboratory";
        if (user.IsInRole("RadiologyCenter")) return "RadiologyCenter";
        if (user.IsInRole("Doctor")) return "Doctor";
        if (user.IsInRole("Beneficiary")) return "Beneficiary";
        if (user.IsInRole("Staff")) return "Staff";

        var claimValue = user.FindFirst("UserType")?.Value;
        return string.IsNullOrWhiteSpace(claimValue) ? "User" : claimValue;
    }

    private static string RoleLabel(ClaimsPrincipal user)
    {
        return UserType(user) switch
        {
            "Administrator" => "مدير نظام",
            "Staff" => "موظف",
            "Doctor" => "طبيب",
            "Beneficiary" => "مستفيد",
            "Pharmacy" => "صيدلية",
            "Pharmacist" => "صيدلي",
            "Laboratory" => "معمل تحاليل",
            "RadiologyCenter" => "مركز أشعة",
            _ => "مستخدم"
        };
    }

