@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject UiThemeService Theme
@inject NavigationManager Nav

<div class="@($"app-root {Theme.CssClass}")" dir="rtl">
    <aside class="app-sidebar" aria-label="القائمة الجانبية">
        <div class="brand-block" @onclick='() => Nav.NavigateTo("/")'>
            <div class="brand-copy">
                <div class="brand-title">مستشفى بلا مستشفى</div>
                <div class="brand-subtitle">رحمة بلا حدود</div>
            </div>

            <div class="brand-mark" aria-hidden="true"></div>
        </div>

        <AuthorizeView>
            <Authorized Context="auth">
                <div class="sidebar-user-card">
                    <div class="user-initial">
                        @GetInitial(auth.User.FindFirst("FullNameAr")?.Value ?? auth.User.Identity?.Name)
                    </div>

                    <div>
                        <strong>@(auth.User.FindFirst("FullNameAr")?.Value ?? auth.User.Identity?.Name)</strong>
                        <span>@RoleLabel(auth.User.FindFirst("UserType")?.Value)</span>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>

        <NavMenu />

        <div class="sidebar-footer">
            <a class="sidebar-logout" href="/account/logout">
                <span>تسجيل الخروج</span>
                <span class="logout-arrow">↢</span>
            </a>
        </div>
    </aside>

    <section class="app-workspace">
        <header class="app-topbar">
            <div class="topbar-actions">
                <a class="topbar-logout" href="/account/logout">
                    <span>خروج</span>
                    <span>↢</span>
                </a>

                <button class="theme-toggle"
                        type="button"
                        @onclick="Theme.Toggle"
                        title="تبديل الوضع"
                        aria-label="تبديل الوضع">
                    <span>@Theme.Icon</span>
                </button>
            </div>

            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="top-user-chip">
                        <span class="chip-dot"></span>
                        <strong>@(auth.User.FindFirst("FullNameAr")?.Value ?? auth.User.Identity?.Name)</strong>
                        <span>· @RoleLabel(auth.User.FindFirst("UserType")?.Value)</span>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="page-canvas">
            @Body
        </main>
    </section>
</div>

@code {
    protected override void OnInitialized()
    {
        Theme.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Theme.OnChange -= StateHasChanged;
    }

    private static string GetInitial(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "ع";
        }

        return value.Trim()[0].ToString();
    }

    private static string RoleLabel(string? userType) => userType switch
    {
        "Administrator" => "إدارة",
        "Staff" => "موظف",
        "Doctor" => "طبيب",
        "Beneficiary" => "مستفيد",
        _ => "إدارة"
    };
}